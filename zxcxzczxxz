    local function renderInfoTargetPlr(plr)
        if not plr or not plr.Parent then
            return
        end
        local displayName = plr.DisplayName or plr.Name or "unknown"
        targetUi.title.Text = displayName
        if not plr.Character then
            targetUi.stats.Text = "respawning..."
            targetUi.stats.TextColor3 = JUJU_MUTED
            return
        end
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if not hum then
            targetUi.stats.Text = "loading..."
            targetUi.stats.TextColor3 = JUJU_MUTED
            return
        end
        if hum.Health <= 0 then
            targetUi.stats.Text = "dead - waiting for respawn"
            targetUi.stats.TextColor3 = JUJU_MUTED
            return
        end
        local armor = 0
        local be = plr.Character:FindFirstChild("BodyEffects")
        if be then
            local a = be:FindFirstChild("Armor")
            if a then
                armor = tonumber(a.Value) or 0
            end
        end
        local knocked = isKnocked(plr)
        local hpLine = string.format("health  %.0f / %.0f", hum.Health, hum.MaxHealth)
        local armorLine = string.format("armor   %.0f", armor)
        if knocked then
            targetUi.stats.Text = hpLine .. "\n" .. armorLine .. "\nstatus  knocked"
            targetUi.stats.TextColor3 = Color3.fromRGB(255, 120, 120)
        else
            targetUi.stats.Text = hpLine .. "\n" .. armorLine
            targetUi.stats.TextColor3 = JUJU_TEXT
        end
    end

