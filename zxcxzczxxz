do
	local function rainWebHttpFromRequestTable(res)
		if type(res) ~= "table" then
			return nil, nil
		end
		local body = type(res.Body) == "string" and res.Body
			or type(res.body) == "string" and res.body
			or ""
		local code = tonumber(res.StatusCode) or tonumber(res.status) or tonumber(res.Status)
		if code == nil and (res.Success == true or res.success == true) then
			code = 200
		end
		if body ~= "" or (code and code > 0) then
			return code or 200, body
		end
		return nil, nil
	end

	local function rainWebHttpGet(url)
		local HttpService = game:GetService("HttpService")
		local headers = { ["Accept"] = "application/json" }
		local reqOpts = { Url = url, Method = "GET", Headers = headers }
		local bestCode, bestBody = nil, ""

		local function consider(code, body)
			code = tonumber(code)
			body = type(body) == "string" and body or ""
			if body ~= "" and code then
				return code, body, true
			end
			if code and (bestCode == nil or (bestBody == "" and body ~= "")) then
				bestCode, bestBody = code, body
			end
			return nil, nil, false
		end

		-- Executor HTTP first — Opiumware and others block HttpService:RequestAsync.
		if type(request) == "function" then
			local ok, res = pcall(request, reqOpts)
			if ok then
				local code, body = rainWebHttpFromRequestTable(res)
				local done
				code, body, done = consider(code, body)
				if done then
					return code, body
				end
				if type(res) == "string" and res ~= "" then
					return 200, res
				end
			end
		end
		if type(http_request) == "function" then
			local ok, res = pcall(http_request, reqOpts)
			if ok then
				local code, body = rainWebHttpFromRequestTable(res)
				local done
				code, body, done = consider(code, body)
				if done then
					return code, body
				end
			end
		end
		local synLib = typeof(syn) == "table" and syn or nil
		if not synLib and typeof(getgenv) == "function" then
			synLib = getgenv().syn
		end
		if type(synLib) == "table" and type(synLib.request) == "function" then
			local ok, res = pcall(synLib.request, reqOpts)
			if ok then
				local code, body = rainWebHttpFromRequestTable(res)
				local done
				code, body, done = consider(code, body)
				if done then
					return code, body
				end
			end
		end
		if game and typeof(game.HttpGet) == "function" then
			local ok, body = pcall(function()
				return game:HttpGet(url, true)
			end)
			if ok and type(body) == "string" and body ~= "" then
				return 200, body
			end
		end
		if HttpService and type(HttpService.GetAsync) == "function" then
			local ok, body = pcall(function()
				return HttpService:GetAsync(url, true)
			end)
			if ok and type(body) == "string" and body ~= "" then
				return 200, body
			end
		end
		local skipRequestAsync = type(request) == "function" or type(http_request) == "function"
		if typeof(identifyexecutor) == "function" then
			local okEx, exName = pcall(identifyexecutor)
			if okEx and type(exName) == "string" then
				local low = string.lower(exName)
				if low:find("opium", 1, true) or low:find("nihon", 1, true) or low:find("awp", 1, true) then
					skipRequestAsync = true
				end
			end
		end
		if not skipRequestAsync and HttpService and type(HttpService.RequestAsync) == "function" then
			local ok, res = pcall(function()
				return HttpService:RequestAsync({
					Url = url,
					Method = "GET",
					Headers = headers,
				})
			end)
			if ok and type(res) == "table" then
				local code = tonumber(res.StatusCode) or 0
				local body = type(res.Body) == "string" and res.Body or ""
				local done
				code, body, done = consider(code, body)
				if done then
					return code, body
				end
			end
		end
		if bestCode then
			return bestCode, bestBody
		end
		return nil, nil
	end

