function magicBulletFireUpdater67(hit)
    if typeof(hit) ~= "Vector3" then
        return
    end
    pcall(function()
        local be = Self and Self.Character and Self.Character:FindFirstChild("BodyEffects")
        local mp = be and be:FindFirstChild("MousePos")
        if mp then
            mp.Value = hit
        end
    end)
    if type(CurrentGame) ~= "table" then
        return
    end
    local remote = nil
    if type(getRem) == "function" then
        remote = getRem()
    end
    if not remote and CurrentGame.Functions and type(CurrentGame.Functions.RemotePath) == "function" then
        pcall(function()
            remote = CurrentGame.Functions.RemotePath()
        end)
    end
    if not remote or typeof(remote.FireServer) ~= "function" then
        return
    end
    if CurrentGame.UpdaterList and #CurrentGame.UpdaterList > 0 then
        for _, testUpdater in ipairs(CurrentGame.UpdaterList) do
            pcall(function()
                remote:FireServer(testUpdater, hit)
            end)
        end
    elseif CurrentGame.Updater then
        pcall(function()
            remote:FireServer(CurrentGame.Updater, hit)
        end)
    end
end

function magicBulletQueueServerHit67(origin, headPos, headPart)
