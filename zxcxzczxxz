local function rainWebPickGlobalString(v)
	if type(v) ~= "string" then
		return nil
	end
	local s = v:match("^%s*(.-)%s*$") or ""
	if s == "" or s == "nil" then
		return nil
	end
	return s
end

-- Luarmor/Potassium often isolate getgenv(); keys set before loadstring live in getrenv/_G.
local function rainWebReadGlobal(name)
	if typeof(getgenv) == "function" then
		local ok, v = pcall(function()
			return getgenv()[name]
		end)
		if ok then
			v = rainWebPickGlobalString(v)
			if v then
				return v
			end
		end
	end
	if typeof(getrenv) == "function" then
		local ok, env = pcall(getrenv)
		if ok and type(env) == "table" then
			local v = rainWebPickGlobalString(env[name])
			if v then
				return v
			end
		end
	end
	local ok, v = pcall(function()
		return _G[name]
	end)
	if ok then
		v = rainWebPickGlobalString(v)
		if v then
			return v
		end
	end
	return rainWebPickGlobalString(_ENV and _ENV[name] or nil)
		or rainWebPickGlobalString(rawget and rawget(_G, name) or nil)
end

