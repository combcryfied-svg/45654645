	local function normalizeSentryPlayerSelection(value)
		if type(value) == "string" then
			if value == "" or value == "(none)" or value == "thisisausername" then
				return {}
			end
			return { value }
		end
		if type(value) ~= "table" then
			return {}
		end
		local out, seen = {}, {}
		for _, name in ipairs(value) do
			if type(name) == "string" and name ~= "" and name ~= "(none)" and name ~= "thisisausername" and not seen[name] then
				seen[name] = true
				out[#out + 1] = name
			end
		end
		return out
	end

	local function isPlayerListFlag(flag)
		if type(flag) ~= "string" then
			return false
		end
		if flag == "Rage.Sentry.Player" or flag == "Game Specific.Des Hood.Sentry.Player" then
			return true
		end
		if flag == "Rage.Kill All.Whitelist" or flag == "Game Specific.Des Hood.Kill All.Whitelist" then
			return true
		end
		if flag:sub(-10) == ".Whitelist" or flag:sub(-7) == ".Player" then
			local lower = flag:lower()
			if lower:find("kill all", 1, true) or lower:find("sentry", 1, true) then
				return true
			end
		end
		return false
	end

	local function filterSelectedToOptions(selected, names)
		local nameSet = {}
		for _, name in ipairs(names) do
			nameSet[name] = true
		end
		local valid = {}
		for _, name in ipairs(selected) do
			if nameSet[name] then
				valid[#valid + 1] = name
			end
		end
		return valid
	end

	local function playerNameOptions(currentValue)
		local selectedList = normalizeSentryPlayerSelection(currentValue)
		local names = {}
		local meta = {}
		local seen = {}
		for _, name in ipairs(selectedList) do
			if not seen[name] then
				seen[name] = true
				names[#names + 1] = name
				meta[name] = { label = name }
			end
		end
		local okPlayers, playersSvc = pcall(function()
			return game:GetService("Players")
		end)
		local localPlayer = nil
		if okPlayers and playersSvc then
			localPlayer = playersSvc.LocalPlayer
			for _, plr in ipairs(playersSvc:GetPlayers()) do
				if plr ~= localPlayer then
					local name = plr.Name
					if type(name) == "string" and name ~= "" and not seen[name] then
						seen[name] = true
						names[#names + 1] = name
						local label = playerDisplayLabel(plr) or name
						local avatar = fetchHeadshotPng(plr.UserId)
						meta[name] = {
							label = label,
							avatar = avatar,
						}
					end
				end
			end
		end
		sort(names, function(a, b)
			local la = (meta[a] and meta[a].label) or a
			local lb = (meta[b] and meta[b].label) or b
			return tostring(la):lower() < tostring(lb):lower()
		end)
		if #names == 0 then
			names[1] = "thisisausername"
			meta["thisisausername"] = { label = "thisisausername" }
		end
		return names, meta
	end

	local function applyPlayerDropdownOptions(element, currentValue)
		local selected = normalizeSentryPlayerSelection(currentValue)
		local names, meta = playerNameOptions(selected)
		element["options"] = names
		element["_rain_option_meta"] = meta
		local validSelected = filterSelectedToOptions(selected, names)
		pcall(function()
			element:set_dropdown(validSelected, nil, true)
		end)
		if #validSelected == 0 and names[1] == "thisisausername" then
			local dropdown_text = element["drawings"] and element["drawings"]["dropdown_text"]
			if dropdown_text then
				dropdown_text["Text"] = "thisisausername"
			end
		end
		return names, meta, validSelected
	end

	local function bindSentryPlayerDropdown(element, parts, flag)
		local current = normalizeSentryPlayerSelection(getAt(parts))
		setAt(parts, current)
		flags[flag] = current
		applyPlayerDropdownOptions(element, current)
		create_connection(element["on_dropdown_change"], function(value)
			local picked = normalizeSentryPlayerSelection(value)
			setAt(parts, picked)
			flags[flag] = picked
		end)
		local lastOptsKey = ""
		task.spawn(function()
			while element and element["options"] do
				task.wait(1.5)
				local selected = normalizeSentryPlayerSelection(getAt(parts))
				local names = playerNameOptions(selected)
				local optsKey = table.concat(names, "\0")
				if optsKey ~= lastOptsKey then
					lastOptsKey = optsKey
					applyPlayerDropdownOptions(element, selected)
				end
			end
		end)
	end

	local function dropdownOptions(parts, value)
		local key = pathKey(parts)
		if isPlayerListFlag(key) then
			local names = playerNameOptions(normalizeSentryPlayerSelection(value))
			return names
		end
		if STRING_OPTIONS[key] then
			return STRING_OPTIONS[key]
		end
		local last = parts[#parts]
		local parent = parts[#parts - 1]
		if parent == "Skins" then
			return skinOptionsForWeapon(last, value)
		end
		if parent == "Animations" then
			return ANIMATIONS
		end
		if last == "Mode" and parent == "Body Size" then
			return { "Skinny", "Medium", "Fat" }
		end
		if last == "Weapons" then
			return WEAPONS
		end
		if last == "Order" and parent == "Inventory Sorter" then
			return WEAPONS
		end
		return nil
	end

