        local function hookCharacterFor(victimPlr)
            local char = victimPlr and victimPlr.Character
            local state = getHealthState(victimPlr)
            if not char then
                state.Last = nil
                state.LastDefense = nil
                state.LastArmor = nil
                return
            end

            local function onHealthChanged()
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum then
                    return
                end
                local current = hum.Health
                local last = state.Last
                if last ~= nil and current < last - 0.5 then
                    onVictimDamaged(victimPlr, last - current, "health")
                end
                state.Last = current
            end

            local function onDefenseOrArmorChanged(kind)
                local be = char:FindFirstChild("BodyEffects")
                if not be then
                    return
                end
                local obj = be:FindFirstChild(kind)
                if not obj or not obj:IsA("ValueBase") then
                    return
                end
                local current = tonumber(obj.Value) or 0
                local lastKey = kind == "Defense" and "LastDefense" or "LastArmor"
                local last = state[lastKey]
                if kind == "Armor" and (current > 1e6 or (last and last > 1e6)) then
                    state[lastKey] = current
                    return
                end
                if last ~= nil and current < last - 0.5 then
                    onVictimDamaged(victimPlr, last - current, string.lower(kind))
                end
                state[lastKey] = current
            end

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                state.Last = hum.Health
                CharSubscribe(hum:GetPropertyChangedSignal("Health"), onHealthChanged)
                pcall(function()
                    CharSubscribe(hum.HealthChanged, onHealthChanged)
                end)
                watchCreatorOnInstance(hum, victimPlr)
            end
            watchCreatorOnInstance(char, victimPlr)

            local function hookBodyEffects(be)
                if not be then
                    return
                end
                watchCreatorOnInstance(be, victimPlr)
                local defense = be:FindFirstChild("Defense")
                if defense and defense:IsA("ValueBase") then
                    state.LastDefense = tonumber(defense.Value) or 0
                    CharSubscribe(defense:GetPropertyChangedSignal("Value"), function()
                        onDefenseOrArmorChanged("Defense")
                    end)
                    pcall(function()
                        CharSubscribe(defense.Changed, function()
                            onDefenseOrArmorChanged("Defense")
                        end)
                    end)
                end
                local armor = be:FindFirstChild("Armor")
                if armor and armor:IsA("ValueBase") then
                    state.LastArmor = tonumber(armor.Value) or 0
                    CharSubscribe(armor:GetPropertyChangedSignal("Value"), function()
                        onDefenseOrArmorChanged("Armor")
                    end)
                end
                local gsc = be:FindFirstChild("GunShotChanges")
                if gsc then
                    local lastGsc = tonumber(gsc.Value) or 0
                    CharSubscribe(gsc:GetPropertyChangedSignal("Value"), function()
                        local now = tonumber(gsc.Value) or 0
                        if now ~= lastGsc then
                            state.LastGunshotAt = os.clock()
                            if now > lastGsc then
                                onVictimDamaged(victimPlr, math.max(1, now - lastGsc), "gunshot")
                            end
                            lastGsc = now
                        end
                    end)
                end
            end

            local be = char:FindFirstChild("BodyEffects")
            if be then
                hookBodyEffects(be)
            else
                CharSubscribe(char.ChildAdded, function(child)
                    if child.Name == "BodyEffects" then
                        hookBodyEffects(child)
                    end
                end)
            end
        end

