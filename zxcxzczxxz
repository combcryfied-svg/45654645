    if mesh then
        pcall(function() mesh.TextureId = "" end)
    end
    local sa = head:FindFirstChildOfClass("SurfaceAppearance")
    if sa then
        pcall(function() sa:Destroy() end)
    end

    if not texture or texture == "" then 
        texture = "rbxassetid://0" 
