    local function onBulletRay(object)
        if not object or object.Name ~= "BULLET_RAYS" then
            return
        end
        task.defer(function()
            if not object.Parent then
                return
            end
            local owner = object:GetAttribute("OwnerCharacter")
            local char = lp and lp.Character
            local isLocal = owner == lp.Name or (char and owner == char.Name)
            local beamChild = object:FindFirstChildOfClass("Beam")
            local endCf
            if beamChild and beamChild.Attachment1 then
                endCf = beamChild.Attachment1.WorldCFrame
            else
                local att1 = object:FindFirstChildWhichIsA("Attachment", true)
                if att1 and att1 ~= object:FindFirstChildWhichIsA("Attachment") then
                    endCf = att1.WorldCFrame
                else
                    endCf = object.CFrame
                end
            end

            if isLocal then
                doTracer(object, endCf, true)
                doImpact(endCf)
                local vis = visualsCfg()
                local sndCfg = type(vis) == "table" and vis["Local Bullet Sound"]
                if type(sndCfg) == "table" and sndCfg.Enabled == true then
                    local soundKey = string.lower(tostring(sndCfg.Sound or sndCfg["Sound"] or "default"))
