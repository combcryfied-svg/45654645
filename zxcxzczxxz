	local function rainWebDeepMerge(dst, src)
		if type(dst) ~= "table" or type(src) ~= "table" then
			return
		end
		for k, v in pairs(src) do
			if type(v) == "table" and type(dst[k]) == "table" then
				local list = true
				for kk in pairs(v) do
					if type(kk) ~= "number" then
						list = false
						break
					end
				end
				if list then
					dst[k] = v
				else
					rainWebDeepMerge(dst[k], v)
				end
			else
				dst[k] = v
			end
		end
	end

	local function rainWebNormKey(v)
		if v == nil then
			return ""
		end
		local s = tostring(v):match("^%s*(.-)%s*$") or ""
		if s == "" or s == "nil" then
			return ""
		end
		if (s:sub(1, 1) == '"' and s:sub(-1) == '"') or (s:sub(1, 1) == "'" and s:sub(-1) == "'") then
			s = s:sub(2, -2):match("^%s*(.-)%s*$") or ""
		end
		local low = string.lower(s)
		if low == "place ur key here" or low == "place your key here" or low == "your_loader_key" then
			return ""
		end
		return s
	end

	local function rainWebClientScriptKey(env)
		return rainWebNormKey(rainWebReadGlobal("script_key"))
			or rainWebNormKey(env and env.script_key)
			or rainWebNormKey(script_key)
	end

	local function rainWebAuthQuery(HttpService, tryKey, mode, env)
		local q = "key=" .. HttpService:UrlEncode(tryKey) .. "&mode=" .. HttpService:UrlEncode(mode)
		local sk = rainWebClientScriptKey(env)
		if sk ~= "" then
			q = q .. "&script_key=" .. HttpService:UrlEncode(sk)
		end
		return q
	end

	local function rainWebCollectKeys(env)
		local out, seen = {}, {}
		local function add(v)
			local k = rainWebNormKey(v)
			if k ~= "" and not seen[k] then
				seen[k] = true
				out[#out + 1] = k
			end
		end
		-- Loader key first — Rain dashboard auth (Luarmor script_key alone may be unlinked on site).
		add(rainWebReadGlobal("RAIN_LOADER_KEY"))
		add(rainWebReadGlobal("LOADER_KEY"))
		add(env.RAIN_LOADER_KEY)
		add(env.LOADER_KEY)
		add(rainWebReadGlobal("script_key"))
		add(env.script_key)
		add(script_key)
		return out
	end

	local function rainWebBootstrapErrMsg(data, status)
		if type(data) == "table" and type(data.error) == "string" then
			local e = data.error
			if e == "invalid key" then
				return "Key not recognized — paste the full Loader tab snippet from getrain.club (LOADER_KEY + script_key)"
			elseif e == "license expired" then
				return "Luarmor license expired — renew on Luarmor, then refresh getrain.club"
			elseif e == "license banned" then
				return "Luarmor license banned"
			elseif e == "banned" then
				return "getrain.club account banned"
			end
			return e
		end
		if status == 403 then
			return "Invalid key or license — copy LOADER_KEY from getrain.club (Loader tab)"
		elseif status == 404 then
			return "Key not found — log in at getrain.club and copy your loader key"
		elseif status and status > 0 then
			return "HTTP " .. tostring(status)
		end
		return "Could not reach server — check HttpService / executor HTTP, or game HTTP block"
	end

	local g = typeof(getgenv) == "function" and getgenv() or {}
	local base = tostring(g.RAIN_WEB_URL or "https://getrain.club"):gsub("/$", "")
	-- Prefer HTTPS; upgrade legacy http://getrain.club URLs.
	if base:match("^http://getrain%.club") then
		base = "https://getrain.club"
	end
	local mode = tostring(g.RAIN_WEB_MODE or "rage")
	local keys = rainWebCollectKeys(g)
	local key = keys[1] or ""

	if key ~= "" then
		local HttpService = game:GetService("HttpService")
		local bootOk = false
		local lastStatus, lastErrMsg
		for _, tryKey in ipairs(keys) do
			local bootUrl = base .. "/api/bootstrap?" .. rainWebAuthQuery(HttpService, tryKey, mode, g)
			local status, body = rainWebHttpGet(bootUrl)
			lastStatus = status
			if type(body) == "string" and body ~= "" then
				local ok, data = pcall(function()
					return HttpService:JSONDecode(body)
				end)
				if ok and type(data) == "table" and type(data.rain) == "table" then
					bootOk = true
					key = tryKey
					if type(data.script_key) == "string" and data.script_key ~= "" then
						script_key = data.script_key
						if typeof(getgenv) == "function" then
							getgenv().script_key = data.script_key
						end
					end
					shared.rain = data.rain
					shared.rain["Web Configs"] = {
						Enabled = true,
						["API Key"] = key,
						["Server URL"] = base,
						Mode = mode,
					}
					shared.Rain = shared.rain
					-- Website configs may omit whole sections (TriggerBot, Aim Assist...) — fill so the body never indexes nil.
					rainWebSkeletonDefaults()
					if typeof(getgenv) == "function" then
						getgenv()._RAIN_WEB_REVISION = tonumber(data.revision) or 0
					end
					break
				end
				if ok and type(data) == "table" then
					lastErrMsg = rainWebBootstrapErrMsg(data, status)
					-- Wrong loader key but another candidate may work; license issues apply to all keys for this account.
					if status == 403 and data.error == "invalid key" then
						continue
					end
				end
			else
				lastErrMsg = rainWebBootstrapErrMsg(nil, status)
			end
			if status == 403 and lastErrMsg and not lastErrMsg:find("not recognized", 1, true) then
				break
			end
		end
		if not bootOk then
			warn("[Rain Web] " .. base .. " — " .. (lastErrMsg or rainWebBootstrapErrMsg(nil, lastStatus)))
			rainWebSkeletonDefaults()
		end

		task.spawn(function()
			local HttpService = game:GetService("HttpService")
			local lastRevision = (typeof(getgenv) == "function" and tonumber(getgenv()._RAIN_WEB_REVISION)) or 0
			local function ping()
				rainWebHttpGet(base .. "/api/heartbeat?" .. rainWebAuthQuery(HttpService, key, mode, g))
			end
			local function pull()
				local url = base .. "/api/live-config?" .. rainWebAuthQuery(HttpService, key, mode, g)
				local _, raw = rainWebHttpGet(url)
				if not raw or raw == "" then
					return
				end
				local ok, data = pcall(function()
					return HttpService:JSONDecode(raw)
				end)
				if not ok or type(data) ~= "table" or type(data.rain) ~= "table" then
					return
				end
				local rev = tonumber(data.revision) or 0
				if rev <= lastRevision then
					return
				end
				lastRevision = rev
				if typeof(getgenv) == "function" then
					getgenv()._RAIN_WEB_REVISION = rev
				end
				-- Full replace so Apply matches the website table (no stale nested keys)
				local keepWeb = type(shared.rain) == "table" and shared.rain["Web Configs"] or nil
				shared.rain = data.rain
				if type(keepWeb) == "table" then
					shared.rain["Web Configs"] = keepWeb
				elseif type(shared.rain["Web Configs"]) ~= "table" then
					shared.rain["Web Configs"] = {
						Enabled = true,
						["API Key"] = key,
						["Server URL"] = base,
						Mode = mode,
					}
				end
				rainWebSkeletonDefaults()
				if type(yeebeelolsaen67) == "function" then
					pcall(yeebeelolsaen67)
				end
				if type(rainApplyLiveConfig67) == "function" then
					pcall(rainApplyLiveConfig67)
				elseif type(norm67) == "function" then
					pcall(norm67)
					if type(rainSyncRuntimeFromConfig67) == "function" then
						pcall(rainSyncRuntimeFromConfig67)
					end
				end
			end
			ping()
			pcall(pull)
			while true do
				task.wait(0.5)
				pcall(pull)
				pcall(ping)
			end
		end)
	else
		warn("[Rain Web] No LOADER_KEY — paste the loader snippet from getrain.club (needs LOADER_KEY=...)")
		rainWebSkeletonDefaults()
	end
end

