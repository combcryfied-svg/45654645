                line.To = to
                outline.From = from
                outline.To = to
                line.Visible = true
                outline.Visible = true
                local fade = 1 - (elapsed / life)
                line.Transparency = 1 - fade
                outline.Transparency = 1 - fade
            else
                line.Visible = false
                outline.Visible = false
            end
        end)
