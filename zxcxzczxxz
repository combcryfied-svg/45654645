function tbDrawBox(rootPart, insideBox)
    local fovCfg = shared.rain.TriggerBot.FOV
    if type(fovCfg) ~= "table" or fovCfg.Visible ~= true then
        setTriggerBotFovVisible67(false)
        return
    end
    local box = GetTBBox(rootPart)
    if not box or not box.Visible then
        setTriggerBotFovVisible67(false)
        return
    end
    local tbFov = ensureTriggerBotFov67()
    if not tbFov then
        return
    end
    tbFov.Position = Vector2.new(box.X, box.Y)
    tbFov.Size = Vector2.new(box.Width, box.Height)
    tbFov.Visible = true
    tbFov.Color = insideBox
        and rainColor3From67(fovCfg["In FOV Color"], 255, 0, 0)
        or rainColor3From67(fovCfg.Color, 255, 255, 255)
end

function tbFire(targetPlayer, rootPart, mousePos)
    if tbStillShootOn() and Mango.Locals.TriggerState and tbSyncedTarget(targetPlayer) then
        setTriggerBotFovVisible67(false)
        return true
    end
    -- A Silent Aim / Aim Assist lock is the target they selected. Triggerbot has to
    -- stay on that player even when they look away; the FOV box is only for free aim.
    local selected = tbSelectedPlr()
    if selected and targetPlayer == selected then
        local inside = tbInBox(rootPart, mousePos, true)
        tbDrawBox(rootPart, inside)
        return true
    end
    local fovCfg = shared.rain.TriggerBot.FOV
    local useFov = type(fovCfg) == "table" and fovCfg.Enabled == true
    if useFov then
        local inside, box = tbInBox(rootPart, mousePos, false)
        tbDrawBox(rootPart, inside)
        return inside
    end
    setTriggerBotFovVisible67(false)
    return tbMouse(targetPlayer)
end


function TriggerShoot()
    if not Mango.Locals.TriggerState then return end

    local Tool = Self.Character:FindFirstChildOfClass("Tool")
    if not Tool then return end

    local interval = shared.rain["TriggerBot"]['Delay'].Weapon[Tool.Name] or 0
    if shared.rain["TriggerBot"]['Delay']['Enabled'] then
        if DateTime.now().UnixTimestampMillis - Mango.Locals.LastShot >= interval * 1000 then
            Mango.Locals.LastShot = DateTime.now().UnixTimestampMillis
            Mango.Locals.IsTriggerBotting = true
            local ToolObj = Self.Character:FindFirstChildOfClass("Tool")
            if ToolObj ~= nil and ToolObj:IsDescendantOf(Self.Character) then
                ToolObj:Activate()
            end
            Mango.Locals.IsTriggerBotting = false
        end
    else
        Mango.Locals.IsTriggerBotting = true
        local ToolObj = Self.Character:FindFirstChildOfClass("Tool")
        if ToolObj ~= nil and ToolObj:IsDescendantOf(Self.Character) then
            ToolObj:Activate()
        end
        Mango.Locals.IsTriggerBotting = false
    end
end

function TriggerBot()
    if not rainEnabled67("TriggerBot.Enabled") then
        setTriggerBotFovVisible67(false)
        Mango.Locals.TriggerbotTarget = nil
        Mango.Locals.HitTrigger = nil
        return
    end

    local Conditions = chkCfg()
    if Conditions.Typing and UserInputService:GetFocusedTextBox() then
        setTriggerBotFovVisible67(false)
        return
    end
    if isCrouching67() then
        setTriggerBotFovVisible67(false)
        return
    end

    local saCfg = shared.rain.SilentAim
    local saTargetMode = selectModeOn67()
    local selectedEarly = tbSelectedPlr()
    if saTargetMode and not selectedEarly and not selectHasTarget67() and not SP and not selectAutomaticOn67() then
        setTriggerBotFovVisible67(false)
        Mango.Locals.TriggerbotTarget = nil
        Mango.Locals.HitTrigger = nil
        return
    end

    local tbMode = shared.rain.TriggerBot.DetectionMode
    local mousePos = UserInputService:GetMouseLocation()
    local Tool = Self.Character:FindFirstChildOfClass("Tool")

    if not Tool or not Tool:FindFirstChild("Ammo") then
        setTriggerBotFovVisible67(false)
        return
    end

    local targetPlayer, targetHRP
    local selected = tbSelectedPlr()
    if selected and selected.Character then
        targetPlayer = selected
        targetHRP = selected.Character:FindFirstChild("HumanoidRootPart")
    elseif Mango.Locals.TriggerbotTarget and Mango.Locals.TriggerbotTarget.Character then
        targetPlayer = Mango.Locals.TriggerbotTarget
        targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    elseif (selectModeOn67() or SP == true) and Mango.Locals.LockedTarget and Mango.Locals.LockedTarget.Character
        and passCombatCond(Mango.Locals.LockedTarget.Character) then
        targetPlayer = Mango.Locals.LockedTarget
        targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    elseif selectAutomaticOn67() then
        local closest = Player.GetClosestPlayerToCursor()
        if closest and closest.Character then
            targetPlayer = closest
            targetHRP = closest.Character:FindFirstChild("HumanoidRootPart")
        end
    end

    if not targetPlayer then
        if not saTargetMode then
            local closest = Player.GetClosestPlayerToCursor()
            if closest and closest.Character and passCombatCond(closest.Character) then
                targetPlayer = closest
                targetHRP = closest.Character:FindFirstChild("HumanoidRootPart")
            end
        end
    end

    if not targetPlayer or not targetHRP then
        setTriggerBotFovVisible67(false)
        return
    end

    -- Selecting a sticky Silent Aim / Aim Assist target should arm triggerbot on
    -- that same player. Otherwise TB stays off until its own bind is pressed.
    if selected and targetPlayer == selected then
        if saLocked() or SP2 == true then
            Mango.Locals.TriggerState = true
        end
    end

    local distance = (Self.Character.HumanoidRootPart.Position - targetHRP.Position).Magnitude
    local maxRange = tbRng(Tool)
    if distance > maxRange then
        setTriggerBotFovVisible67(false)
        return
    end


    local Object, Humanoid, RootPart = Player.ValidateClient(targetPlayer)
    if not (Object and Humanoid and RootPart) then
        setTriggerBotFovVisible67(false)
        return
    end

    if Conditions["Wall Check"] and not Engine.RayCast(RootPart, Player.GetOrigin("Camera"), { Self.Character }) then
        setTriggerBotFovVisible67(false)
        return
    end
    if Conditions.Visible and not wbSkip() and not Engine.RayCast(RootPart, Player.GetOrigin('Camera'), {Self.Character}) then
        setTriggerBotFovVisible67(false)
        return
    end
    if Conditions.Forcefield and Player.HasForcefield(targetPlayer.Character) then
        setTriggerBotFovVisible67(false)
        return
    end
    if Conditions.Knocked and Player.IsKnocked(targetPlayer.Character) then
        setTriggerBotFovVisible67(false)
        return
    end
    if Conditions.SelfKnocked and Player.IsKnocked(Self.Character) then
        setTriggerBotFovVisible67(false)
        return
    end
    if Conditions.Grabbed and Player.IsGrabbed(targetPlayer.Character) then
        setTriggerBotFovVisible67(false)
        return
    end

    Mango.Locals.TriggerbotTarget = targetPlayer
    Mango.Locals.HitTrigger = RootPart


    if tbMode == "2D" then
        local shouldFire = tbFire(targetPlayer, RootPart, mousePos)
        if Mango.Locals.TriggerState and shouldFire then
            TriggerShoot()
        end
        return
   elseif tbMode == "Hitbox" or tbMode == "3D" then
    if not tbFire(targetPlayer, RootPart, mousePos) then
        return
    end

    Mango.Locals.TriggerbotTarget = targetPlayer
    Mango.Locals.HitTrigger = RootPart

    if tbStillShootOn() and tbSyncedTarget(targetPlayer) then
        TriggerShoot()
    elseif shared.rain.TriggerBot.Prediction.Enabled then
        local Velocity = RootPart.AssemblyLinearVelocity
        local Position = RootPart.Position
        local predVal = targetPlayer.Character.Humanoid:GetState() == Enum.HumanoidStateType.Freefall
            and shared.rain.TriggerBot.Prediction.Y
            or shared.rain.TriggerBot.Prediction.Y

        local predicted = Position + Velocity * predVal
        local cursor = Mouse.Hit.p
        local dist = (predicted - cursor).Magnitude

        if dist < shared.rain.TriggerBot.Prediction.Threshold then
            TriggerShoot()
        end
