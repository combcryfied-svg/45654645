local SentryActive = false
local SentryConnections = {}

    local function SentrySubscribe(signal, fn)
        local conn = trkConn(signal:Connect(fn))
        if SentryActive then
            SentryConnections[#SentryConnections + 1] = conn
        else
            pcall(function()
                if conn and conn.Disconnect then conn:Disconnect() end
            end)
        end
        return conn
    end

    local function SentryClearMarkers()
        pcall(function()
            local lp = Self
            for _, container in ipairs({ lp.Character, lp:FindFirstChild("Backpack") }) do
                if container then
                    for _, item in ipairs(container:GetChildren()) do
                        if item:IsA("Tool") then
                            local ammo = item:FindFirstChild("Ammo")
                            if ammo then
                                ammo:SetAttribute("ZeeKillAmmoWatching", nil)
                                ammo:SetAttribute("ZeeKillRefillRequested", nil)
                                ammo:SetAttribute("__sentry_ammo_watch", nil)
                            end
                        end
                    end
                end
            end
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                local be = p.Character and p.Character:FindFirstChild("BodyEffects")
                if be then
                    be:SetAttribute("__sentry_gf_watch", nil)
                    for _, child in ipairs(be:GetChildren()) do
                        if child:IsA("ValueBase") then
                            child:SetAttribute("__sentry_gf", nil)
                        end
                    end
                end
            end
            for _, name in ipairs({ "Ignored", "Debris", "Effects", "Projectiles" }) do
                local root = workspace:FindFirstChild(name)
                if root then
                    root:SetAttribute("__sentry_bullets", nil)
                    local br = root:FindFirstChild("BULLET_RAYS")
                    if br then
                        br:SetAttribute("__sentry_bullets", nil)
                    end
                end
            end
            local br = workspace:FindFirstChild("BULLET_RAYS")
            if br then
                br:SetAttribute("__sentry_bullets", nil)
            end
        end)
    end

    local function sentryStopInner()
        if not SentryActive then return end
        SentryActive = false
        for _, conn in ipairs(SentryConnections) do
            pcall(function()
                if conn and conn.Disconnect then conn:Disconnect() end
            end)
        end
        SentryConnections = {}
        SentryClearMarkers()
    end

