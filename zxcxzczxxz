function normFont(fontVal, fallback)
    local fb = (type(fallback) == "string" and fallback ~= "") and fallback or "SourceSansBold"
    if fontVal == nil then
        return fb
    end
    if typeof(fontVal) == "EnumItem" and fontVal.EnumType == Enum.Font then
        return fontVal.Name
    end
    if type(fontVal) == "string" then
        if fontVal == "" then
            return fb
        end
        return fontVal
    end
    return fb
end

function enumFont(fontName, fallback)
    local fb = fallback or Enum.Font.SourceSansBold
    local name = normFont(fontName, nil)
    if not name or name == "" then
        return fb
    end
    local ok, f = pcall(function()
        return Enum.Font[name]
    end)
    if ok and typeof(f) == "EnumItem" then
        return f
    end
    local lower = string.lower(name)
    for _, item in ipairs(Enum.Font:GetEnumItems()) do
        if string.lower(item.Name) == lower then
            return item
        end
    end
    return fb
end

