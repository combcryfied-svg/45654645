function hitboxExpander67()
    local RunService = game:GetService("RunService")
    local lp = Self

    local function cfg()
        local util = shared.rain and shared.rain.Utilities
        local hb = util and util["Hitbox Expander"]
        return type(hb) == "table" and hb or nil
    end

    local function restoreHitbox(hrp)
        if not hrp then
            return
        end
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.CanCollide = false
        hrp.Transparency = 1
        hrp.Material = Enum.Material.Plastic
        hrp.Color = Color3.fromRGB(163, 162, 165)
    end

    local function currentTarget()
        if type(Mango) ~= "table" or type(Mango.Locals) ~= "table" then
            return nil
        end
        local m = Mango.Locals
        local sa = shared.rain and shared.rain.SilentAim
        if type(sa) == "table" and sa.Enabled == true and sa.Mode == "Target" and m.LockedTarget and m.LockedTarget.Parent then
            return m.LockedTarget
        end
        if type(getSaPlr) == "function" then
            local picked = getSaPlr()
            if picked and picked.Parent then
                return picked
            end
        end
        return m.SilentAimTarget or m.TriggerbotTarget or m.AimAssistTarget or m.LockedTarget or m.CamlockTarget
    end

    local hbLastTick = 0
    local HB_DT = 0.12

    trkConn(RunService.Heartbeat:Connect(function()
        local now = os.clock()
        if now - hbLastTick < HB_DT then
            return
        end
        hbLastTick = now
        local hbCfg = cfg()
        if not hbCfg or not rainEnabled67("Utilities.Hitbox Expander.Enabled") then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= lp then
                    local char = plr.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        restoreHitbox(hrp)
                    end
                end
            end
            return
        end
        local size = math.clamp(tonumber(hbCfg.Size) or 15, 1, 50)
        local targetOnly = hbCfg["Target Only"] ~= false
        local visualize = hbCfg.Visualize == true
        local colorTbl = type(hbCfg.Color) == "table" and hbCfg.Color or { 0, 0, 0 }
        local vizColor = Color3.fromRGB(colorTbl[1] or 0, colorTbl[2] or 0, colorTbl[3] or 0)
        local tgt = targetOnly and currentTarget() or nil

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == lp then
                continue
            end
            local char = plr.Character
            if not char then
                continue
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                continue
            end
            if targetOnly and tgt ~= plr then
                restoreHitbox(hrp)
                continue
            end
            hrp.Size = Vector3.new(size, size, size)
            hrp.CanCollide = false
            if visualize then
                hrp.Transparency = 0.5
                hrp.Material = Enum.Material.SmoothPlastic
                hrp.Color = vizColor
            else
                hrp.Transparency = 1
                hrp.Material = Enum.Material.Plastic
                hrp.Color = Color3.fromRGB(163, 162, 165)
            end
        end
    end))
end

function syncCharSpoofToChar67()
