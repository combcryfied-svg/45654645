        getgenv()._RainTrackGhPayloadForHit67 = rainTrackGhPayloadForHit67
        getgenv()._RainInstantSaHitFeedback67 = rainInstantSaHitFeedback67
        getgenv()._RainRefreshHitSound67 = refreshHitSound
    end
end

