    end
    local merged = {}
    local function mergeActions(actions)
        if type(actions) ~= "table" then
            return
        end
        for key, val in pairs(actions) do
            merged[key] = (tonumber(merged[key]) or 0) + (tonumber(val) or 0)
        end
    end
    mergeActions(type(rage["Kill All"]) == "table" and rage["Kill All"]["Actions"] or nil)
    local dh = desHoodCfg67()
    if dh then
        mergeActions(dh["Actions"])
        mergeActions(type(dh["Fun Edits"]) == "table" and dh["Fun Edits"]["Actions"] or nil)
        mergeActions(type(dh["Kill All"]) == "table" and dh["Kill All"]["Actions"] or nil)
    end
    if not next(merged) then
        return
    end
    local handlers = {
        ["Apply Armor"] = desHoodApplyArmor67,
        ["Apply Muscle"] = desHoodApplyMuscle67,
        ["Force Reset"] = desHoodForceReset67,
        ["Kill All"] = desHoodKillAll67,
    }
    for key, fn in pairs(handlers) do
        local cur = tonumber(merged[key]) or 0
        local last = desHoodActionLast[key] or 0
        if cur > last then
            desHoodActionLast[key] = cur
            pcall(fn)
        end
    end
end

