    end
    local dest = part.Position
    local toTarget = dest - origin
    local dist = toTarget.Magnitude
    if dist < 1e-4 then
        return true
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = rayIgn(shooter)
    params.IgnoreWater = true
    local hit = workspace:Raycast(origin, toTarget.Unit * (dist + 2), params)
    return hit and hit.Instance and hit.Instance:IsDescendantOf(targetChar)
end

