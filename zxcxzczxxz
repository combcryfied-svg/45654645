function rainNumIsInf67(v)
    local n = tonumber(v)
    if n == nil then
        return v == math.huge or v == -math.huge
    end
    return n == math.huge or n == -math.huge or n ~= n or math.abs(n) >= 1e12
end

function rainDebugLib67()
    local dbg = debug
    if type(dbg) == "table" and typeof(dbg.getupvalue) == "function" and typeof(dbg.setupvalue) == "function" then
        return dbg
    end
    if typeof(getrenv) == "function" then
        local ok, renv = pcall(getrenv)
        if ok and type(renv) == "table" and type(renv.debug) == "table" then
            local rd = renv.debug
            if typeof(rd.getupvalue) == "function" and typeof(rd.setupvalue) == "function" then
