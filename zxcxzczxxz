function saMouseInObb67(hitboxCF, size)
    if typeof(hitboxCF) ~= "CFrame" or typeof(size) ~= "Vector3" then
        return false
    end
    local cam = workspace.CurrentCamera
    if not cam then
        return false
    end
    local mousePos = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
    local localOrigin = hitboxCF:PointToObjectSpace(ray.Origin)
    local localDir = hitboxCF:VectorToObjectSpace(ray.Direction).Unit
    local half = size / 2
    local function axis(o, d, minB, maxB)
        if math.abs(d) < 1e-6 then
            return -math.huge, math.huge
        end
        local t1 = (minB - o) / d
        local t2 = (maxB - o) / d
        return math.min(t1, t2), math.max(t1, t2)
    end
    local txMin, txMax = axis(localOrigin.X, localDir.X, -half.X, half.X)
    local tyMin, tyMax = axis(localOrigin.Y, localDir.Y, -half.Y, half.Y)
    local tzMin, tzMax = axis(localOrigin.Z, localDir.Z, -half.Z, half.Z)
    local tMin = math.max(math.max(txMin, tyMin), tzMin)
    local tMax = math.min(math.min(txMax, tyMax), tzMax)
    return tMax >= math.max(tMin, 0)
end

function saMouseInFov67(aimPlayer)
    if saFovWide67() then
        return true
    end
    if not aimPlayer or not aimPlayer.Parent then
        return false
    end
    local char = aimPlayer.Character
    if not char then
        return false
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        return false
    end
    local cam = workspace.CurrentCamera
    if not cam then
        return false
    end
    local mode = silentAimFovMode67()
    if mode == "3D" then
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root
        local look = root.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 1e-4 then
            flat = Vector3.new(0, 0, -1)
        else
            flat = flat.Unit
        end
        local fov = silentAimFovConfig67("3D")
        local hx = tonumber(fov.X) or 10
        local hy = tonumber(fov.Y) or 10
        local hz = tonumber(fov.Z) or 10
        local size = Vector3.new(hx * 2, hy * 2, hz * 2)
        local cf = CFrame.new(torso.Position) * CFrame.lookAt(Vector3.new(), flat)
        return saMouseInObb67(cf, size)
    end
    local pos, onScreen = cam:WorldToViewportPoint(root.Position)
    if not onScreen or pos.Z <= 0 then
        return false
    end
    local fovConfig = silentAimFovConfig67("2D")
    local scaleFactor = (root.Size.Y * cam.ViewportSize.Y) / (pos.Z * 2) * 80 / cam.FieldOfView
    local hx = tonumber(fovConfig.X) or 10
    local hy = tonumber(fovConfig.Y) or 10
    local leftWidth = hx * scaleFactor
    local upperHeight = hy * scaleFactor
    local totalWidth = leftWidth * 2
    local totalHeight = upperHeight * 2
    local boxX = pos.X - leftWidth
    local boxY = pos.Y - upperHeight
    local mousePos = UserInputService:GetMouseLocation()
    return mousePos.X >= boxX and mousePos.X <= boxX + totalWidth
        and mousePos.Y >= boxY and mousePos.Y <= boxY + totalHeight
end

