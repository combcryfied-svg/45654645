    for _ = 1, 1 do
        pcall(function()
            remote:FireServer("ShootGun", handle, handle.Position, pellets, nil, nil, nil, range, damage)
        end)
    end
    if tool.Parent then
        tool.Parent = backpack
    end
    return true
end

