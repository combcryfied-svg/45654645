function applyFutureOffset67(toolName, position, target)
    local fc = shared.rain and shared.rain.Future
    if not fc or fc.Enabled ~= true then
        return position
    end
    local weapons = fc.Weapons
    local gunData = weapons and weapons[toolName]
    if type(gunData) ~= "table" then
        return position
    end
    local settings = gunData.Settings
    if type(settings) ~= "table" then
        return position
    end
    local scale = 1
    local peak = fc["Peak Pattern"]
    if type(peak) == "table" then
        scale = tonumber(peak["Power Scale"]) or 0.9
    end
    local vel = Vector3.zero
    if target and target.Character then
        local root = target.Character:FindFirstChild("HumanoidRootPart")
        if root then
            vel = root.AssemblyLinearVelocity
        end
    end
    local distMul = tonumber(gunData.Distance) or 1
    return position + vel * Vector3.new(settings.X or 0, settings.Y or 0, settings.Z or 0) * scale * distMul
end

