    local function render_dropdown_options(scroll_refresh)
        if not dropdown_list_state then
            return
        end

        local state = dropdown_list_state
        local element = state.element
        local options = state.options
        local selected_options = flags[element["dropdown_flag"]]
        local total = #options
        local visible = state.visible
        local scroll_index = state.scroll_index

        if not scroll_refresh then
            clear_dropdown_option_items()
        end

        local used_slots = 0
        for slot = 1, visible do
            local index = scroll_index + slot - 1
            if index > total then
                break
            end

            used_slots = slot
            local option = options[index]
            local item = ensure_dropdown_option_item(slot)
            item["option"] = option
            local rowH = state.option_height or 12
            local meta = type(element["_rain_option_meta"]) == "table" and element["_rain_option_meta"][option] or nil
            local label = option
            local avatarData = nil
            if type(meta) == "table" then
                if type(meta.label) == "string" and meta.label ~= "" then
                    label = meta.label
                end
                if type(meta.avatar) == "string" and #meta.avatar > 32 then
                    avatarData = meta.avatar
                end
            end
            item["click"]["Size"] = udim2_new(1, -6, 0, math.max(12, rowH - 2))
            item["click"]["Position"] = udim2_new(0, 3, 0, 3 + (slot - 1) * rowH)
            item["text"]["Text"] = label
            if item["avatar"] then
                if avatarData then
                    item["avatar"]["Data"] = avatarData
                    item["avatar"]["Visible"] = true
                    item["avatar"]["Transparency"] = 1
                    item["avatar"]["Position"] = udim2_new(0, 0, 0, math.max(0, math.floor((rowH - 2 - 14) / 2)))
                    item["text"]["Position"] = udim2_new(0, 18, 0, math.max(0, math.floor((rowH - 2 - 12) / 2)))
                    item["checkmark"]["Position"] = udim2_new(1, -8, 0, math.max(0, math.floor((rowH - 2 - 8) / 2)))
                else
                    item["avatar"]["Visible"] = false
                    item["avatar"]["Transparency"] = 0
                    item["text"]["Position"] = udim2_new(0, 0, 0, math.max(0, math.floor((rowH - 2 - 12) / 2)))
                    item["checkmark"]["Position"] = udim2_new(1, -8, 0, math.max(0, math.floor((rowH - 2 - 8) / 2)))
                end
            end
            apply_dropdown_option_visual(item, dropdown_option_selected(option, selected_options), not scroll_refresh)
        end

        for slot = used_slots + 1, #dropdown_option_items do
            local item = dropdown_option_items[slot]
            if item then
                item["option"] = nil
                item["click"]["Visible"] = false
                item["text"]["Visible"] = false
                item["checkmark"]["Visible"] = false
                if item["avatar"] then
