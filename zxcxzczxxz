	local function ensureGroup(name)
		return menu["groups"][name] or menu.create_group(name)
	end

	local GROUP_ORDER = { "intro", "combat", "rage", "visuals", "weapons", "movement", "utilities", "game specific", "conditions", "settings" }

	local function reorderGroups(order)
		local ordered = menu["ordered_groups"]
		if type(ordered) ~= "table" then
			return
		end

		local byName = {}
		for i = 1, #ordered do
			local group = ordered[i]
			if group and group["name"] then
				byName[group["name"]] = group
			end
		end

		local nextOrder = {}
		local seen = {}
		for i = 1, #order do
			local name = order[i]
			local group = byName[name]
			if group and group["is_visible"] then
				nextOrder[#nextOrder + 1] = group
				seen[name] = true
			end
		end

		for i = 1, #ordered do
			local group = ordered[i]
			if group and group["is_visible"] and not seen[group["name"]] then
				nextOrder[#nextOrder + 1] = group
			end
		end

		menu["ordered_groups"] = nextOrder
	end

	-- The embedded juju shell ships a few empty sidebar entries; hide them.
	local function hideDefaultGroups()
		for _, name in ipairs({ "main", "misc.", "addons" }) do
			local group = menu["groups"][name]
			if group and type(group.hide) == "function" then
				pcall(function()
					group:hide()
