    local function queuePendingShot(plr, part)
        if not plr or not part then
            return
        end
        local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        if not hum then
            return
        end
        local shot = {
            player = plr,
            part = part,
            oldHealth = hum.Health,
            time = tick(),
        }
        pendingShots[#pendingShots + 1] = shot
        local conn
        conn = hum.HealthChanged:Connect(function(newHealth)
            if newHealth < shot.oldHealth then
                local damage = math.floor(shot.oldHealth - newHealth)
                if damage > 0 then
                    onHitConfirmed(plr, part, damage)
                end
                for i = #pendingShots, 1, -1 do
                    if pendingShots[i] == shot then
                        table.remove(pendingShots, i)
                        break
                    end
                end
                if conn then
                    pcall(function()
                        conn:Disconnect()
                    end)
                end
            end
        end)
        trkConn(conn)
        task.delay(0.7, function()
            if conn and conn.Connected then
                pcall(function()
                    conn:Disconnect()
                end)
            end
        end)
    end

    local function targetFromGhPayload(payload)
        if type(payload) ~= "table" then
            return nil, nil
        end
        if typeof(payload.Hit) == "Instance" and payload.Hit:IsA("BasePart") then
            local plr, hitPart = getPlayerFromPart(payload.Hit)
            if plr then
                return plr, hitPart
            end
        end
        local pelletData = payload.PelletData
        if type(pelletData) == "table" then
            for _, pellet in pairs(pelletData) do
                if type(pellet) == "table" then
                    local hit = pellet.Hit or pellet.Result2 or pellet.Instance
                    if typeof(hit) == "Instance" and hit:IsA("BasePart") then
                        local plr, hitPart = getPlayerFromPart(hit)
                        if plr then
                            return plr, hitPart
                        end
                    end
                end
            end
        end
        if saActive and saActive() then
            return resolveSilentShotTarget()
        end
        return resolveSilentShotTarget()
    end

