function isCrouching67()
    local ok, crouched = pcall(function()
        if UserInputService:IsKeyDown(Enum.KeyCode.C) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            return true
        end
        local char = Self and Self.Character
        if not char then
            return false
        end
        local be = char:FindFirstChild("BodyEffects")
        if be then
            local crouch = be:FindFirstChild("Crouch") or be:FindFirstChild("Crouching")
            if crouch then
                if crouch.Value == true then
                    return true
                end
                local v = tostring(crouch.Value or ""):lower()
                if v:find("crouch", 1, true) then
                    return true
                end
            end
            local mov = be:FindFirstChild("Movement")
            if mov then
                local v = tostring(mov.Value or ""):lower()
                if v:find("crouch", 1, true) then
                    return true
                end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and typeof(hum.CameraOffset) == "Vector3" and hum.CameraOffset.Y < -0.4 then
            return true
        end
        return false
    end)
    return ok and crouched == true
end

function tbSyncedTarget(plr)
    if not plr or type(Mango) ~= "table" or type(Mango.Locals) ~= "table" then
        return false
    end
    local m = Mango.Locals
    return m.TriggerbotTarget == plr
        or m.LockedTarget == plr
        or m.SilentAimTarget == plr
        or m.AimAssistTarget == plr
        or m.CamlockTarget == plr
        or (type(getSaPlr) == "function" and getSaPlr() == plr)
end

function GetTBBox(targetHRP, allowOffScreen)
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHRP.Position)
    if not onScreen and not allowOffScreen then
        return nil
    end

    local Size = targetHRP.Size.Y
    local Position = screenPos
    local fovBlock = shared.rain.TriggerBot.FOV
    local wc = fovBlock and fovBlock["Weapon Configuration"]
    local fovConfig
    if type(wc) == "table" and wc.Enabled == true then
        local weaponCategory = GetTBWeaponConfig()
        fovConfig = wc[weaponCategory] or wc.Others
    else
        fovConfig = (type(fovBlock) == "table" and fovBlock.FOV) or { X = 10, Y = 10, Z = 10 }
    end
    if not fovConfig then return nil end
    local halfW = math.max(tonumber(fovConfig.X) or 10, 0)
    local halfH = math.max(tonumber(fovConfig.Y) or 10, 0)

    return {
        X = screenPos.X - halfW,
        Y = screenPos.Y - halfH,
        Width = halfW * 2,
        Height = halfH * 2,
        Visible = onScreen,
        Position = screenPos
    }
end

function tbMouse(targetPlayer)
    local mouseTarget = Mouse.Target
    return mouseTarget
        and targetPlayer
        and targetPlayer.Character
        and mouseTarget:IsDescendantOf(targetPlayer.Character)
end

function tbInBox(rootPart, mousePos, allowOffScreen)
    local box = GetTBBox(rootPart, allowOffScreen)
    if not box then
        return allowOffScreen == true, nil
    end
    if not box.Visible then
        return allowOffScreen == true, box
    end
    local inside = mousePos.X >= box.X and mousePos.X <= box.X + box.Width
        and mousePos.Y >= box.Y and mousePos.Y <= box.Y + box.Height
    return inside or allowOffScreen == true, box
end

