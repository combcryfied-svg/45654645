function saMouseSyncPt67(origin, hit, maxRange)
    if typeof(hit) ~= "Vector3" then
        return hit
    end
    hit = voidMapPos67(hit)
    if typeof(origin) ~= "Vector3" then
        return hit
    end
    origin = voidMapPos67(origin)
    local delta = hit - origin
    local dist = delta.Magnitude
    if dist < 1e-4 then
        return hit
    end
    local syncDist = dist
    if dist < 15 then
        syncDist = math.max(dist, 15)
    end
    local cap = tonumber(maxRange)
    if cap and cap >= 1 then
        syncDist = math.min(syncDist, cap)
    end
    return origin + delta.Unit * syncDist
end

