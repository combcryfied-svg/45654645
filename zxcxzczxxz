local ghIgnCache = nil
function ghRay(payload, aimPos)
    if type(payload) ~= "table" or typeof(aimPos) ~= "Vector3" then
        return nil
    end
    local origin = shotOrig(payload)
    if typeof(origin) ~= "Vector3" then
        return nil
    end
    if payload.Hit then
        return aimPos, payload.Hit, payload.Normal
    end
    local range = tonumber(payload.Range) or 200
    local unit = (aimPos - origin).Unit
    local params = RaycastParams.new()
    local filter = {}
    local shooter = payload.Shooter
    if shooter then
        filter[1] = shooter
    end
    if ghIgnCache == nil then
        local ok, ignored = pcall(function()
            return require(game:GetService("ReplicatedStorage").MainModule).Ignored
        end)
        ghIgnCache = ok and ignored or false
    end
    if type(ghIgnCache) == "table" then
        for _, inst in ipairs(ghIgnCache) do
            filter[#filter + 1] = inst
        end
    end
    params.FilterDescendantsInstances = filter
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    local hit = workspace:Raycast(origin, unit * range, params)
    if hit then
        return hit.Position, hit.Instance, hit.Normal
    end
    return origin + unit * range, nil, nil
end

