    local function escapeRichText(s)
        s = tostring(s or "")
        s = string.gsub(s, "&", "&amp;")
        s = string.gsub(s, "<", "&lt;")
        s = string.gsub(s, ">", "&gt;")
        s = string.gsub(s, "\"", "&quot;")
        s = string.gsub(s, "'", "&apos;")
        return s
    end
    local function hudSafeInt(n, fallback)
        n = tonumber(n)
        if n == nil or n ~= n or n == math.huge or n == -math.huge then
            return fallback or 0
        end
