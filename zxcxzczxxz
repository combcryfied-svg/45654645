        pcall(function()
            local wsOldIndex
            wsOldIndex = hookmetamethod(Workspace, "__index", LPH_NO_VIRTUALIZE(function(self, key)
                if key == "MAP" or key == "Map" then
                    local okDirect, direct = pcall(wsOldIndex, self, key)
                    if okDirect and direct ~= nil then
                        return direct
                    end
                    local okIgn, ign = pcall(wsOldIndex, self, "Ignored")
                    if okIgn and ign then
                        local moved = ign:FindFirstChild("MAP") or ign:FindFirstChild("Map")
                        if moved then
