    local function resolveVoidSpectateTarget()
        local order = {}
        local function push(plr)
            if not plr or plr == lp or not plr.Parent then
                return
            end
            for i = 1, #order do
                if order[i] == plr then
                    return
                end
            end
            order[#order + 1] = plr
        end
        push(SA.target)
        local st = typeof(getgenv) == "function" and getgenv()._RainRageBotSA
        if type(st) == "table" then
            push(st.target)
        end
        local ml = type(Mango) == "table" and Mango.Locals
        if ml then
            push(ml.SilentAimTarget)
            push(ml.LockedTarget)
            push(ml.AimAssistTarget)
            push(ml.TriggerbotTarget)
            push(ml.CamlockTarget)
        end
        local respawnWait = nil
        for i = 1, #order do
            local plr = order[i]
            if plr and plr.Parent then
                if plr.Character then
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        return plr
                    end
                elseif not respawnWait then
                    respawnWait = plr
                end
            end
        end
        return respawnWait
    end

