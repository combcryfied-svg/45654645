    end
    local function matchesEntry(wname)
        if type(wname) ~= "string" or wname == "" then
            return false
        end
        if toolName == wname then
            return true
        end
        local clean = wname:gsub("%[", ""):gsub("%]", "")
        if toolName == clean then
            return true
        end
        if string.find(toolName, clean, 1, true) then
            return true
        end
        local toolClean = toolName:gsub("%[", ""):gsub("%]", "")
        return toolClean == clean or string.find(toolClean, clean, 1, true) ~= nil
    end
    for i = 1, #list do
        if matchesEntry(list[i]) then
            return true
        end
    end
    for _, wname in pairs(list) do
        if matchesEntry(wname) then
            return true
        end
    end
    return false
