	local function addLeaf(section, parts, name, opts)
		opts = type(opts) == "table" and opts or {}
		local value = getAt(parts)
		local key = parts[#parts]
		local flag = pathKey(parts)

		if flag == "Gun Mods.Advanced Gun Mods.Wallbang" then
			if value == nil then
				setAt(parts, false)
				value = false
			end
			name = "wall bang"
		end
		if flag == "Gun Mods.Advanced Gun Mods.Damage Overrider" then
			if value == nil then
				setAt(parts, false)
				value = false
			end
			name = "damage overrider"
		end
		if flag == "Gun Mods.Advanced Gun Mods.Force Hit"
			or flag == "Gun Mods.Advanced Gun Mods.Magic Bullet" then
			if value == nil then
				setAt(parts, false)
				value = false
			end
			name = "force hit"
			parts[#parts] = "Force Hit"
			flag = "Gun Mods.Advanced Gun Mods.Force Hit"
		end

		if HIDDEN_UI_FLAGS[flag] and not opts.allowHidden then
			return nil
		end

		if key == "Username" or key == "User" then
			local text = value == nil and "" or tostring(value)
			setAt(parts, text)
			local placeholder = textboxPlaceholderFor67(parts, key, flag)
			local display = text == "thisisausername" and "" or text
			local el = section:create_element({ ["name"] = name }, {
				["textbox"] = { ["flag"] = flag, ["default"] = display, ["placeholder"] = placeholder },
			})
			bindTextbox(el, parts, flag)
			created += 1
			return el
		end

		if key == "Order" and parts[#parts - 1] == "Inventory Sorter" then
			local current = {}
			if type(value) == "table" then
				for i = 1, #value do
					if type(value[i]) == "string" and value[i] ~= "" then
						current[#current + 1] = value[i]
					end
				end
			end
			setAt(parts, current)
			local el = section:create_element({ ["name"] = name }, {
				["dropdown"] = {
					["flag"] = flag,
					["options"] = WEAPONS,
					["default"] = current,
					["requires_one"] = false,
					["multi"] = true,
				},
			})
			bindDropdown(el, parts, flag, true)
			created += 1
