            local function silentPredVelocity(root, targetPlr)
                if not root then
                    return Vector3.zero
                end
                if predVelState.plr ~= targetPlr then
                    predVelState.vel = Vector3.zero
                    predVelState.pos = nil
                    predVelState.t = nil
                    predVelState.plr = targetPlr
                end
                local now = tick()
                local pos = root.Position
                local sampled = root.AssemblyLinearVelocity
                if typeof(sampled) ~= "Vector3" or sampled.Magnitude < 0.15 then
                    sampled = root.Velocity
                end
                if typeof(IsDesynced) == "function" and IsDesynced(root) and typeof(Resolve) == "function" then
                    sampled = Resolve(root)
                elseif predVelState.pos and predVelState.t then
                    local dt = now - predVelState.t
                    if dt > 0.016 and dt < 0.25 then
                        local fromPos = (pos - predVelState.pos) / dt
                        if sampled.Magnitude < 0.15 or fromPos.Magnitude > sampled.Magnitude + 4 then
                            sampled = fromPos
                        end
                    end
                end
                predVelState.pos = pos
                predVelState.t = now
                if typeof(sampled) ~= "Vector3" then
                    sampled = Vector3.zero
                end
                predVelState.vel = predVelState.vel:Lerp(sampled, 0.55)
                local vel = predVelState.vel
                local horiz = Vector3.new(vel.X, 0, vel.Z)
