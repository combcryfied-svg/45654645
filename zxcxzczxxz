    end
    local sc = tool:FindFirstChild("ShootingCooldown") or tool:FindFirstChild("Cooldown")
    local known = gunKnownDelay67(tool)
    local current = sc and tonumber(sc.Value)
    local stock = known or current
    patchGunCooldownUpvalues67(tool, math.max(delay, 0.001), stock, nil)
    if sc and (sc:IsA("NumberValue") or sc:IsA("IntValue")) then
        if math.abs((tonumber(sc.Value) or 0) - delay) > 1e-6 then
            sc.Value = math.max(delay, 0.001)
