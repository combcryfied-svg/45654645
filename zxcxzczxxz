	local function ensureOption(options, value)
		if type(value) ~= "string" or value == "" then
			return options
		end
		for i = 1, #options do
			if options[i] == value then
				return options
			end
		end
		local copy = {}
		for i = 1, #options do
			copy[i] = options[i]
		end
		copy[#copy + 1] = value
		return copy
	end

	local function skinOptionsForWeapon(weaponKey, currentValue)
		local fallback = isKnifeWeaponKey(weaponKey) and KNIFE_SKINS or GUN_SKINS
		-- A throw anywhere in this instance walk would drop the whole dropdown, leaving
		-- the skin unselectable, so every Roblox lookup degrades to the static list.
		local ok, options = pcall(function()
			local rs = game:GetService("ReplicatedStorage")
			local skinModules = rs and rs:FindFirstChild("SkinModules")
			if not skinModules then
				return nil
			end

			if isKnifeWeaponKey(weaponKey) then
				local knives = skinModules:FindFirstChild("Knives")
				local names = knifeSkinNamesFromFolder(knives)
				if type(names) ~= "table" then
					names = knifeSkinNamesFromModule(skinModules)
				end
				return names
			end

			local modules = requireSkinModules(skinModules)
			if type(modules) ~= "table" then
				return nil
			end

			local keysToTry = { weaponKey }
			local aliases = SKIN_MODULE_WEAPON_ALIASES[weaponKey]
			if type(aliases) == "table" then
				for i = 1, #aliases do
					keysToTry[#keysToTry + 1] = aliases[i]
				end
			end

			local weaponSkins = nil
			for i = 1, #keysToTry do
				local entry = modules[keysToTry[i]]
				if type(entry) == "table" then
					weaponSkins = entry
					break
				end
			end

			if type(weaponSkins) ~= "table" then
				return nil
			end

			local names = {}
			for skinName in pairs(weaponSkins) do
				if type(skinName) == "string" then
					if weaponKey ~= "[TacticalShotgun]" or skinName ~= "Golden Age" then
						names[#names + 1] = skinName
					end
				end
			end
			return names
		end)

		if not ok or type(options) ~= "table" or #options == 0 then
			return ensureOption(fallback, currentValue)
		end
		sort(options, function(a, b)
			return a:lower() < b:lower()
		end)
		return ensureOption(options, currentValue)
	end

