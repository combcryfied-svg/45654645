            line.Color = col
            line.Visible = true
            lines[i] = line
        end
        local start = tick()
        local conn
        conn = RunService.RenderStepped:Connect(function()
            local t = tick() - start
            if t > life then
                for i = 1, #lines do
                    pcall(function() lines[i]:Remove() end)
                end
                pcall(function() conn:Disconnect() end)
                return
            end
            local cx, cy = Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2
            local size = 8 + t * 6
            local fade = 1 - (t / life)
            lines[1].From = Vector2.new(cx - size, cy - size)
            lines[1].To = Vector2.new(cx - size / 2, cy - size / 2)
            lines[2].From = Vector2.new(cx + size, cy - size)
            lines[2].To = Vector2.new(cx + size / 2, cy - size / 2)
            lines[3].From = Vector2.new(cx - size, cy + size)
            lines[3].To = Vector2.new(cx - size / 2, cy + size / 2)
            lines[4].From = Vector2.new(cx + size, cy + size)
            lines[4].To = Vector2.new(cx + size / 2, cy + size / 2)
            for i = 1, #lines do
                lines[i].Transparency = 1 - fade
            end
        end)
        trkConn(conn)
    end

