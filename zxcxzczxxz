	local function callAction(name)
		local fn = env[name]
		if type(fn) ~= "function" and type(_G) == "table" then
			fn = _G[name]
		end
		if type(fn) ~= "function" then
			return
		end
		local ok, err = pcall(fn)
		if not ok then
		end
	end

	local function sortedKeys(tbl)
		local keys = {}
		for key in pairs(tbl) do
			if type(key) == "string" and key ~= "UI" then
				keys[#keys + 1] = key
			end
		end
		local rank = {
			Enabled = 10,
			["Rage Bot"] = 11,
			Toggle = 20,
			Input = 21,
			Keybind = 22,
			Mode = 23,
			Type = 24,
			Point = 25,
			DetectionMode = 26,
			Preset = 27,
			Movement = 28,
			Direction = 29,
			Sticky = 30,
			FovType = 31,
			Scale = 40,
			Speed = 41,
			Radius = 42,
			Smoothness = 43,
			Easing = 44,
			Visible = 50,
			Color = 51,
			["In FOV Color"] = 52,
			["In-FOV Color"] = 52,
			FOV = 53,
			Range = 54,
			Delay = 55,
			Threshold = 56,
			Part = 57,
			Thickness = 58,
			Font = 59,
			Layout = 60,
			Weapons = 70,
			Animations = 71,
			Settings = 72,
			Options = 73,
			Skins = 74,
			Weapon = 75,
			["Weapon Configuration"] = 76,
			Shotguns = 77,
			Pistols = 78,
			Others = 79,
			["Color Settings"] = 80,
			["Adjust Dynamically"] = 81,
			["Client Bullet Modification"] = 82,
			["Text Size"] = 85,
		}
		local function keyOrder(key)
			local r = rank[key]
			if r then
				return r
			end
			if key:sub(1, 1) == "[" then
				return 200
			end
			return 120
		end
		sort(keys, function(a, b)
			local oa, ob = keyOrder(a), keyOrder(b)
			if oa ~= ob then
				return oa < ob
			end
			return a:lower() < b:lower()
		end)
		return keys
	end

	-- Each leaf is named after itself; the box name already carries the feature area.
	local function leafName(used, parts, rootDepth)
		local key = parts[#parts]
		local name
		if key == "Value" and #parts >= 2 then
			local parentKey = tostring(parts[#parts - 1])
			if parentKey:sub(1, 1) == "[" and parentKey:sub(-1) == "]" then
				name = label(parentKey)
			end
		end
		if not name then
			name = label(key)
			if NEEDS_PARENT[key] and #parts > rootDepth + 1 then
				local parentKey = tostring(parts[#parts - 1])
				if not (key == "Value" and parentKey:sub(1, 1) == "[" and parentKey:sub(-1) == "]") then
					name = label(parts[#parts - 1]) .. " " .. name
				end
			end
		end

		local depth = #parts - 1
		while used[name] and depth > rootDepth do
			name = label(parts[depth]) .. " " .. name
			depth -= 1
		end

		local base, n = name, 2
		while used[name] do
			name = base .. " " .. n
			n += 1
		end

		used[name] = true
		return name
	end

	-- Two sections can sit on one config path ("aim assist" and "nearest point" both use
	-- "Aim Assist"), and the orphan-keybind sweep in collectLeaves would hand the same key
	-- to each, leaving two widgets fighting over one flag. A key is adopted once per build.
	local autoKeybindClaimed = {}

	local function collectLeaves(def)
		local root = getAt(def.path)
		if type(root) ~= "table" then
			return nil
		end

		local skip = {}
		if def.skip then
			for i = 1, #def.skip do
				skip[def.skip[i]] = true
			end
		end

		local out = {}
		local function walk(node, parts, depth)
			local keys = (depth == 0 and def.keys) or sortedKeys(node)
			if depth == 0 and def.keys then
				-- keys aliases the layout table here, so the sweep collects into a copy;
				-- appending in place would grow the definition on every rebuild.
				local seen = {}
				local merged = {}
				for i = 1, #keys do
					merged[i] = keys[i]
					seen[keys[i]] = true
				end
				for key, value in node do
					if not seen[key] and isKeybindLeafKey(key, value) and not shouldSkipKeybindAlias(node, key) then
						local claim = pathKey(clonePath(parts, key))
						if not autoKeybindClaimed[claim] then
							autoKeybindClaimed[claim] = true
							merged[#merged + 1] = key
							seen[key] = true
						end
					end
				end
				keys = merged
			end
			for i = 1, #keys do
				local key = keys[i]
				if shouldSkipKeybindAlias(node, key) then
					continue
				end
				local value = node[key]
				local childParts = clonePath(parts, key)
				if HIDDEN_UI_FLAGS[pathKey(childParts)] then
					continue
				end
				if value == nil and depth == 0 and def.keys then
					out[#out + 1] = childParts
				elseif value ~= nil and not (depth == 0 and skip[key]) then
					if isConfigBranch(value) then
						walk(value, childParts, depth + 1)
					elseif isLeaf(value) then
						if not isKeybindConfigKey(key, value) then
							out[#out + 1] = childParts
						end
					elseif type(value) == "table" then
						if next(value) == nil then
							-- Walking an empty table yields nothing, which silently dropped
							-- widgets whose value starts out empty (the sentry player list).
							out[#out + 1] = childParts
						else
							walk(value, childParts, depth + 1)
						end
					end
				end
			end
		end

		walk(root, def.path, 0)
		return out
	end

	local uiBuildSections = 0
	local function buildSection(group, tabName, def, order)
		local leaves = collectLeaves(def)
		if leaves == nil and type(def.keys) == "table" and #def.keys > 0 and type(getAt(def.path)) ~= "table" then
			setAt(def.path, {})
			leaves = collectLeaves(def)
		end
		if leaves == nil and not (type(def.extra) == "table" and #def.extra > 0)
			and not (type(def.prepend) == "table" and #def.prepend > 0)
			and not (type(def.keys) == "table" and #def.keys > 0) then
			return nil
		end
		leaves = leaves or {}

		local section = group:create_section(tabName, def.name, def.side, 0.3, 0)
		if not section then
			return nil
		end
		section["_rain_order"] = order

		local used = {}
		local rootDepth = #def.path
		local leafOpts = def.name == "keybinds" and { allowHidden = true } or nil

		if def.prepend then
			for i = 1, #def.prepend do
				local entry = def.prepend[i]
				if getAt(entry.path) ~= nil then
					local name = entry.name or leafName(used, entry.path, #entry.path - 1)
					used[name] = true
					local ok, err = pcall(addLeaf, section, entry.path, name, leafOpts)
					if not ok then
					end
				end
			end
		end

		for i = 1, #leaves do
			local parts = leaves[i]
			local ok, err = pcall(addLeaf, section, parts, leafName(used, parts, rootDepth), leafOpts)
			if not ok then
			end
		end

		if def.extra then
			for i = 1, #def.extra do
				local entry = def.extra[i]
				if getAt(entry.path) ~= nil then
					if def.name == "keybinds" then
						autoKeybindClaimed[pathKey(entry.path)] = true
					end
					local name = entry.name or leafName(used, entry.path, #entry.path - 1)
					used[name] = true
					local ok, err = pcall(addLeaf, section, entry.path, name, leafOpts)
					if not ok then
					end
				end
			end
		end

		if def.buttons then
			for i = 1, #def.buttons do
				local button = def.buttons[i]
				local el = section:create_element({ ["name"] = button.name }, { ["button"] = {} })
				if el then
					create_connection(el["on_clicked"], function()
						callAction(button.action)
					end)
				end
			end
		end

		section:recalculate_size()
		uiBuildSections += 1
		if uiBuildSections % 2 == 0 then
			task.wait()
		end
		return section
	end

	local function frameHeight(frame)
		local real = frame and frame["real_size"]
		local height = real and real["Y"]
		if type(height) == "number" and height > 40 then
			return height
		end
		return 428
	end

	-- Every box after the first is inset by 10px, and a box reserves 18px for its header
	-- and bottom padding, so this is the height a box needs to show all of its rows.
	local BOX_PADDING = 22

	-- Boxes hug their content. If a column needs more room than the tab has, every box in
	-- it shrinks by the same factor and the overflow stays reachable by scrolling inside.
	local function sizeSection(section, side, y, share, tabHeight)
		local topOffset = y > 0 and 10 or 0
		section["size"] = share
		section["border"]["Position"] = udim2_new(side == 1 and 0 or 0.5, side == 1 and 0 or 5, y, topOffset)
		section["border"]["Size"] = udim2_new(0.5, -5, share, y > 0 and -10 or 0)
		section["_rain_avail"] = max(26, share * tabHeight - topOffset - 18)
		section["scroll_index"] = 1
		section["_rain_scroll_offset"] = 0
		section["_rain_scroll_target"] = 0
		section:update_position()
	end

	reflowTab = function(tab)
		local tabHeight = frameHeight(tab["frame"])
		local columns = { {}, {} }
		for _, section in pairs(tab["sections"]) do
			local side = section["side"]
			if (side == 1 or side == 2) and not section["_rain_hidden"] then
				section:recalculate_size()
				local list = columns[side]
				list[#list + 1] = section
			end
		end

		for side = 1, 2 do
			local list = columns[side]
			local count = #list
			if count > 0 then
				sort(list, function(a, b)
					return (a["_rain_order"] or 0) < (b["_rain_order"] or 0)
				end)

				local gaps = GAP * (count - 1)
				local room = 1 - gaps
				local floorShare = min(MIN_SHARE, room / count)

				local wanted, total = {}, 0
				for i = 1, count do
					wanted[i] = max(floorShare, ((list[i]["total_y_size"] or 10) + BOX_PADDING) / tabHeight)
					total += wanted[i]
				end

				local scale = total > room and (room / total) or 1

				local y = 0
				for i = 1, count do
					sizeSection(list[i], side, y, wanted[i] * scale, tabHeight)
					y += wanted[i] * scale + GAP
				end
				for i = 1, count do
					if type(list[i].update_position) == "function" then
						pcall(list[i].update_position, list[i])
					end
				end
			end
		end
	end

