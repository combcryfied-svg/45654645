        payload = desHoodGetLoadoutPayload67()
    end
    for i = 1, 4 do
        if desHoodIsKnifeEntry67(payload[i]) then
            return payload
        end
    end
    for i = 1, 4 do
        if payload[i] == nil then
            payload[i] = "None"
        end
    end
    local knifeSlot = desHoodLoadoutKnifeSlot67 or 4
    local knifeName = desHoodLoadoutKnifeName67 or "[knife]"
    payload[knifeSlot] = knifeName
    return payload
end

local desHoodLoadoutLastFire67 = 0
local desHoodLoadoutPending67 = false

local function desHoodFireLoadout67(payload)
    local remote = desHoodFindLoadoutRemote67()
    if not remote or not remote.Parent then
        return false
    end
    local now = os.clock()
    if now - desHoodLoadoutLastFire67 < 0.12 then
        if not desHoodLoadoutPending67 then
            desHoodLoadoutPending67 = true
            task.delay(0.12 - (now - desHoodLoadoutLastFire67), function()
                desHoodLoadoutPending67 = false
                desHoodFireLoadout67(payload)
            end)
        end
        return true
    end
    desHoodLoadoutLastFire67 = now
    payload = desHoodApplyKnifeSlot67(payload or desHoodGetLoadoutPayload67())
    pcall(function()
        remote:FireServer(payload)
    end)
    return true
end

