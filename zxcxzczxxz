-- Force a validated head shot: move origin next to the head (same trick Force Hit uses),
-- then set hit pos/instance to Head so the server accepts and applies head damage.
function damageOverriderForceHeadArgs67(args, argc, head)
    if type(args) ~= "table" or not head then
        return false
    end
    local headPos = head.Position
    local n = tonumber(argc) or (args.n or #args)
    local oldOrigin = args[3]
    if typeof(oldOrigin) == "Vector3" then
        local d = headPos - oldOrigin
        if d.Magnitude > 1e-4 then
            args[3] = headPos - d.Unit * 0.42
        else
            args[3] = headPos
        end
    else
        args[3] = headPos
    end
    local origin = args[3]
    local norm = Vector3.new(0, 1, 0)
    if typeof(origin) == "Vector3" then
        local d = headPos - origin
        if d.Magnitude > 1e-4 then
            norm = d.Unit
        end
    end
    damageOverriderSyncMouse67(headPos)

    if type(args[4]) == "table" and type(args[4][1]) == "table" then
        for _, pellet in ipairs(args[4]) do
            if type(pellet) == "table" then
                if pellet.Result1 ~= nil then
                    pellet.Result1 = headPos
                end
                if pellet.AimPosition ~= nil then
                    pellet.AimPosition = headPos
                end
                if pellet.Result2 ~= nil or pellet.Hit ~= nil then
                    pellet.Result2 = head
                    pellet.Hit = head
                end
                if pellet.Result3 ~= nil then
                    pellet.Result3 = norm
                end
            end
        end
    elseif typeof(args[4]) == "Vector3" then
        args[4] = headPos
        args[5] = head
        if n >= 6 then
            args[6] = norm
        end
    elseif args[4] == nil and typeof(args[5]) == "Vector3" then
        args[5] = headPos
        args[6] = head
        if n >= 7 then
            args[7] = norm
        end
    else
        return false
    end

    if type(Mango) == "table" and type(Mango.Locals) == "table" then
        Mango.Locals._RainGhCbmServerHitQueue = nil
        Mango.Locals._RainGhCbmServerHit = nil
    end
