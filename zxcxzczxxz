                    snd.SoundId = bulletSoundIds[soundKey] or bulletSoundIds.default
                    snd.Volume = (tonumber(sndCfg.Volume) or 100) / 100
                    snd.PlayOnRemove = true
                    snd.Parent = SoundService
                    snd:Destroy()
                end
            else
                doTracer(object, endCf, false)
            end
        end)
    end

