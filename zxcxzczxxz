	-- Fields whose "unlimited" state is expressed as 9e9 in the config.
	local function isInfiniteField(parts, value)
		if type(value) ~= "number" then
			return false
		end
		if value >= 9e8 then
			return true
		end
		local key = tostring(parts[#parts])
		local parent = tostring(parts[#parts - 1] or "")
		if parent == "Spread Modifications" then
			return false
		end
		if key == "Range" or parent == "Range" then
			return true
		end
		if key == "FOV" or parent == "FOV" then
			return true
		end
		if key == "Size" and parent == "FOV" then
			return true
		end
		local grand = tostring(parts[#parts - 2] or "")
		if grand == "Weapon Configuration" and (key == "X" or key == "Y" or key == "Z") then
			return true
		end
		return false
	end

	local function numberSpec(parts, value)
		local key = tostring(parts[#parts])
		local parent = tostring(parts[#parts - 1] or "")
		local grand = tostring(parts[#parts - 2] or "")
		local lower = key:lower()
		local spec = { min = 0, max = 100, decimals = 0, infinite = false }

		if parent == "Panel" and key == "Keybind List Size" then
			spec.min, spec.max, spec.decimals = 0.6, 2, 2
			return spec
		end

		if grand == "Delay Changer" and key == "Value" then
			spec.min, spec.max, spec.decimals = 0, 2, 4
			spec.suffix = "s"
			return spec
		end

		if parent == "Rapid Fire" and key == "Delay" then
			spec.min, spec.max, spec.decimals = 0, 1, 3
			return spec
		end

		if parent == "Spread Modifications" and key ~= "Enabled" then
			spec.min, spec.max, spec.decimals = 0, 1, 2
			return spec
		end

		if key == "Threshold" and parent == "Auto Stim" then
			spec.min, spec.max, spec.decimals = 1, 99, 0
			return spec
		end

		if parent == "CFrame Fly" and key == "Speed" then
			spec.min, spec.max, spec.decimals = 1, 10000, 0
			return spec
		end

		if parent == "Hitbox Expander" and key == "Size" then
			spec.min, spec.max, spec.decimals = 1, 50, 0
			return spec
		end

		if parent == "Prediction" and (key == "X" or key == "Y" or key == "Z" or key == "Threshold") then
			spec.min, spec.max, spec.decimals = 0, 1000, 3
			return spec
		end

		if key == "X" or key == "Y" or key == "Z" then
			local grand = tostring(parts[#parts - 2] or "")
			if parent == "FOV" or grand == "Weapon Configuration" then
				spec.min, spec.max, spec.decimals = 0, 1000, 0
				spec.infinite = true
				spec.max_text = "inf"
				return spec
			end
		end

		if isInfiniteField(parts, value) then
			spec.min, spec.max, spec.decimals = 0, 1000, 0
			spec.infinite = true
			spec.max_text = "inf"
			return spec
		end

		if lower:find("transparency", 1, true) then
			spec.min, spec.max, spec.decimals = 0, 1, 2
		elseif lower:find("chance", 1, true) then
			spec.min, spec.max, spec.decimals = 0, 100, 0
			spec.suffix = "%"
		elseif value ~= floor(value) then
			spec.max = max(1, abs(value) * 4)
			spec.decimals = 3
		else
			spec.max = max(100, abs(value) * 4)
		end

		if key == "X" or key == "Y" or key == "Z" then
			if parent ~= "Prediction" then
				spec.min = -spec.max
			end
		end

		return spec
	end

