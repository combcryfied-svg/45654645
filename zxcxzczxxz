        if rainSaLockPart67 and rainSaLockPart67.Parent then
            payload.AimPosition = rainSaLockPart67.Position
            return
        end
    end
    local rs = game:GetService("ReplicatedStorage")
    local ghMod = rs:FindFirstChild("Modules") and rs.Modules:FindFirstChild("GunHandler")
    if ghMod then
        local ok, gh = pcall(require, ghMod)
