	local function setSectionVisible(section, visible)
		if not section then
			return
		end
		section["_rain_hidden"] = not visible
		if section["border"] then
			section["border"]["Visible"] = visible
		end
		if section["inside"] then
			section["inside"]["Visible"] = visible
		end
		if section["holder"] then
			section["holder"]["Visible"] = visible
		end
		if not visible then
			-- Collapse out of the column so it can't overlap the active FOV box.
			section["_rain_scroll_offset"] = 0
			section["_rain_scroll_target"] = 0
			section["_rain_avail"] = 0
			section["size"] = 0
			if section["border"] then
				local side = section["side"] == 2 and 2 or 1
				section["border"]["Size"] = udim2_new(0.5, -5, 0, 0)
				section["border"]["Position"] = udim2_new(side == 2 and 0.5 or 0, side == 2 and 5 or 0, 1, 0)
			end
			if type(section["elements"]) == "table" then
				for i = 1, #section["elements"] do
					local el = section["elements"][i]
					if el and el["frame"] then
						el["frame"]["Visible"] = false
					end
				end
			end
		end
		-- Do not force element frames visible here — update_position after reflow
		-- owns which rows are shown. Forcing them all on caused the jumble.
	end

	local function syncSilentAimFovSections()
		local mode = getSilentAimFovMode()
		setSectionVisible(saFov2DSection, mode == "2D")
		setSectionVisible(saFov3DSection, mode == "3D")
		if silentAimTab then
			-- Reflow immediately so the active FOV section gets a real height/position
			-- before any rows are shown.
			pcall(reflowTab, silentAimTab)
			local active = mode == "2D" and saFov2DSection or saFov3DSection
			if active then
				if type(active.recalculate_size) == "function" then
					pcall(function()
						active:recalculate_size()
					end)
				end
				if type(active.update_position) == "function" then
					pcall(active.update_position, active)
				end
			end
		end
	end

	-- Writing a linked axis fires that axis's own slider callback, which lands back here
	-- for the remaining axes. Without this guard X/Y/Z chase each other until the stack
	-- overflows, which is what froze the game while loading a config.
	local fovSyncActive = false

	local function refreshLinkedFovSliders(parts, value, spec)
		if fovSyncActive or type(value) ~= "number" then
			return
		end
		local key = tostring(parts[#parts])
		if key ~= "X" and key ~= "Y" and key ~= "Z" then
			return
		end
		local parentKey = tostring(parts[#parts - 1] or "")
		if parentKey ~= "Shotguns" and parentKey ~= "Pistols" and parentKey ~= "Others" then
			return
		end
		local parentParts = {}
		for i = 1, #parts - 1 do
			parentParts[i] = parts[i]
		end
		local parent = getAt(parentParts)
		if type(parent) ~= "table" then
			return
		end
		local stored = value
		if spec.infinite and value >= spec.max then
			stored = INFINITE
		end
		fovSyncActive = true
		for _, axis in ipairs({ "X", "Y", "Z" }) do
			if parent[axis] ~= nil and axis ~= key then
				parent[axis] = stored
				local axisParts = clonePath(parentParts, axis)
				local axisFlag = pathKey(axisParts)
				flags[axisFlag] = stored
				local linked = fovSliderElements[axisFlag]
				if linked and linked.set_slider then
					local display = stored
					if spec.infinite and (stored >= 9e8 or stored == math.huge) then
						display = spec.max
					else
						display = clamp(stored, spec.min, spec.max)
					end
					pcall(function()
						linked:set_slider(display, false, true, true)
					end)
				end
			end
		end
		fovSyncActive = false
	end

	local function bindConfigKeybind(element, parts, flag, initial)
		local function applyKey(key)
			local keyName = keyNameFromInput(key)
			setAt(parts, keyName)
			flags[flag] = keyName
			syncKeybindValueToParent(parts, keyName)
			if type(flag) == "string" and flag:find("Game Specific.Des Hood.Keybinds.", 1, true) == 1 then
				local panelKey = flag:sub(34)
				if type(applyKeybindPanelField67) == "function" then
					pcall(applyKeybindPanelField67, panelKey, keyName, "des hood")
				end
			elseif type(flag) == "string" and flag:sub(1, 9) == "Keybinds." then
				local panelKey = flag:sub(10)
				if type(applyKeybindPanelField67) == "function" then
					pcall(applyKeybindPanelField67, panelKey, keyName, "global")
				end
			elseif flag == "Select.Keybind" or flag == "Aim Assist.Toggle" or flag == "Aim Assist.Keybind" or flag == "TriggerBot.Toggle" then
				if type(syncSelectKeybind67) == "function" then
					pcall(syncSelectKeybind67, keyName)
				end
				if type(syncKeybindsPanelFromFeatures67) == "function" then
					pcall(syncKeybindsPanelFromFeatures67)
				end
			elseif flag == "Game Specific.Des Hood.Silent Aim.Keybind" then
				local rage = shared.rain and shared.rain.Rage
				if type(rage) == "table" and type(rage["Silent Aim"]) == "table" then
					rage["Silent Aim"].Keybind = keyName
				end
			end
		end
		local resolved = resolveInputKey(initial)
		if resolved then
			element:set_key(resolved)
			flags[flag] = keyNameFromInput(resolved)
		end
		create_connection(element["on_key_change"], applyKey)
	end

	local function refreshAnimationChanger()
		local lp = game:GetService("Players").LocalPlayer
