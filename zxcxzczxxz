            end
        end
        return bestPart
    end
    local function resolveInfRangeTarget()
        local plr = getAimTargetPlayer()
        if not plr then
            targetHitPart, targetPos = nil, nil
            return
        end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            targetHitPart, targetPos = nil, nil
            return
        end
        if preferHrp() then
            targetHitPart = hrp
            targetPos = hrp.Position
            return
        end
        local loc = Mango.Locals
        local hitPos = loc.HitPosition
        if typeof(hitPos) == "Vector3" and hitPos.Magnitude > 0.01 then
            targetPos = hitPos
        else
            targetPos = hrp.Position
        end
        local part = loc.UniSilentTargetPart
        if part and part:IsA("BasePart") and part:IsDescendantOf(char) then
            targetHitPart = part
            return
        end
        targetHitPart = closestPartToPos(char, targetPos) or char:FindFirstChild("Head") or hrp
    end

    local infSt = {
        active = false,
        hbConn = nil,
        mt = nil,
        oldNamecall = nil,
        ghModule = nil,
        oldShoot = nil,
        gunRetryThread = nil,
    }
    local function stopInfRange()
        if infSt.gunRetryThread then
            pcall(task.cancel, infSt.gunRetryThread)
            infSt.gunRetryThread = nil
        end
        if infSt.hbConn then
            pcall(function()
                infSt.hbConn:Disconnect()
            end)
            infSt.hbConn = nil
        end
        if infSt.mt and infSt.oldNamecall then
            pcall(function()
                setreadonly(infSt.mt, false)
                infSt.mt.__namecall = infSt.oldNamecall
                setreadonly(infSt.mt, true)
            end)
        end
        infSt.mt = nil
        infSt.oldNamecall = nil
        if infSt.ghModule and infSt.oldShoot then
            pcall(function()
                infSt.ghModule.shoot = infSt.oldShoot
            end)
        end
        infSt.ghModule = nil
        infSt.oldShoot = nil
        infSt.active = false
        targetHitPart, targetPos = nil, nil
    end
    local function hookGunHandler()
        local okGh, GunHandler = pcall(function()
            return require(ReplicatedStorage.Modules.GunHandler)
        end)
        if not okGh or type(GunHandler) ~= "table" or type(GunHandler.shoot) ~= "function" then
            return false
        end
        if infSt.ghModule == GunHandler and infSt.oldShoot then
            return true
        end
        infSt.ghModule = GunHandler
        infSt.oldShoot = GunHandler.shoot
        local oldShoot = infSt.oldShoot
        GunHandler.shoot = function(p)
            if rainDaHoodInfRangeOn67() and type(p) == "table" then
                p.Range = math.huge
            end
            return oldShoot(p)
        end
        return true
    end
    local function startInfRange()
        if infSt.active then
            return
        end
        if typeof(getrawmetatable) ~= "function"
            or typeof(setreadonly) ~= "function"
            or typeof(getnamecallmethod) ~= "function"
        then
            return
        end
        local MainEvent = getRem()
        if not MainEvent then
            return
        end
        infSt.hbConn = RunService.Heartbeat:Connect(function()
            pcall(resolveInfRangeTarget)
        end)
        local mt = getrawmetatable(game)
        if not mt or type(mt.__namecall) ~= "function" then
            stopInfRange()
            return
        end
        infSt.mt = mt
        infSt.oldNamecall = mt.__namecall
        local oldNamecall = infSt.oldNamecall
        setreadonly(mt, false)
        mt.__namecall = function(self, ...)
            local method = getnamecallmethod()
            local args = { ... }
            if method == "FireServer" and self == MainEvent then
                if isDesHoodGame67() then
                    return oldNamecall(self, ...)
                end
                if args[1] == "ShootGun" and rainDaHoodInfRangeOn67() then
                    pcall(function()
                        if targetHitPart and targetPos then
                            args[3] = targetPos + Vector3.new(0, 0, 1)
                            args[4] = targetHitPart
                            args[5] = targetPos
                            args[6] = targetPos
                        end
                    end)
                    return oldNamecall(self, table.unpack(args))
                end
                if args[1] == "CheckPlayerClose" and rainDaHoodInfRangeOn67() then
                    args[2] = true
                    return oldNamecall(self, table.unpack(args))
                end
            end
            return oldNamecall(self, ...)
        end
        setreadonly(mt, true)
        hookGunHandler()
        infSt.active = true
        if not infSt.ghModule then
            infSt.gunRetryThread = task.spawn(function()
                for _ = 1, 30 do
                    if not infSt.active or not rainDaHoodInfRangeOn67() then
                        break
                    end
                    if hookGunHandler() then
                        break
                    end
                    task.wait(0.35)
                end
                infSt.gunRetryThread = nil
            end)
        end
    end

    local function sync()
        if rainDaHoodWallbangOn67() then
            startWallbang()
        else
            stopWallbang()
        end
        if rainDaHoodInfRangeOn67() then
            startInfRange()
        else
            stopInfRange()
        end
    end

    if typeof(getgenv) == "function" then
        getgenv()._RainDaHood = {
            sync = sync,
            startWallbang = startWallbang,
            stopWallbang = stopWallbang,
            startInfRange = startInfRange,
            stopInfRange = stopInfRange,
        }
    end
    task.defer(sync)
    local lastEquip = ""
    trkConn(RunService.Heartbeat:Connect(function()
        local key = tostring(equippedToolName() or "")
        if key ~= lastEquip then
            lastEquip = key
            pcall(sync)
        end
    end))
end

function rngCh67()
    local LocalPlayer = Self
    local rangeBackup = {}
    local lastRangeEnabled = false
    local function clampGunRangeChangerStuds(v)
        return rainNormGunRange67(v, 1000)
    end
    local function restoreGunRanges()
        for rv, orig in pairs(rangeBackup) do
            if rv.Parent and typeof(orig) == "number" then
                pcall(function()
                    rv.Value = orig
                end)
            end
        end
        for k in pairs(rangeBackup) do
            rangeBackup[k] = nil
        end
    end
    local function patchContainer(container, rangeVal)
        if not container then
            return
        end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local rv = tool:FindFirstChild("Range")
                if rv and (rv:IsA("NumberValue") or rv:IsA("IntValue")) then
                    if rangeBackup[rv] == nil then
                        rangeBackup[rv] = rv.Value
                    end
                    rv.Value = rangeVal
                end
            end
        end
    end
    local function tickGunRange()
        local cfg = cfg67()
        local gm = cfg and cfg["Gun Mods"]
        local grc = gm and gm["Gun Range Changer"]
        local agm = gm and gm["Advanced Gun Mods"]
        local advInfRange = type(agm) == "table" and agm["Infinite Range"] == true
        local en = type(grc) == "table" and grc.Enabled == true
        local rangeActive = en or advInfRange
        if lastRangeEnabled and not rangeActive then
            restoreGunRanges()
        end
        lastRangeEnabled = rangeActive
        if not rangeActive then
            for _, container in ipairs({ LocalPlayer.Backpack, LocalPlayer.Character }) do
                if container then
                    for _, tool in ipairs(container:GetChildren()) do
                        if tool:IsA("Tool") then
                            local rv = tool:FindFirstChild("Range")
                            if rv and (rv:IsA("NumberValue") or rv:IsA("IntValue")) then
                                if rangeBackup[rv] == nil and rv.Value <= 10000 then
                                    rangeBackup[rv] = rv.Value
                                end
                                if rv.Value > 10000 then
                                    rv.Value = rangeBackup[rv] or 250
                                end
                            end
                        end
                    end
                end
            end
            return
        end
        local rangeVal = advInfRange and math.huge or clampGunRangeChangerStuds(grc and grc.Range)
        if isDesHoodGame67() and (rangeVal == math.huge or rangeVal > 1000) then
            rangeVal = 1000
        end
        patchContainer(LocalPlayer.Backpack, rangeVal)
        patchContainer(LocalPlayer.Character, rangeVal)
        local sg = LocalPlayer:FindFirstChild("StarterGear")
        if sg then
            patchContainer(sg, rangeVal)
        end
    end
    if typeof(getgenv) == "function" then
        getgenv()._RainRestoreGunRanges = restoreGunRanges
    end
    trkConn(RunService.Heartbeat:Connect(function()
        pcall(tickGunRange)
    end))
end

local RainAntiFuture = {
    Active = false,
    Connection = nil,
    LastSpoofedVelocity = nil,
    LastServerPosition = nil,
    LastSpoofTime = nil,
    BoostPending = false,
}

function afDistPointSeg(point, segStart, segEnd)
    local segVector = segEnd - segStart
    local len2 = segVector:Dot(segVector)
    if len2 <= 1e-6 then
        return (point - segStart).Magnitude
    end
    local t = math.clamp((point - segStart):Dot(segVector) / len2, 0, 1)
    local closest = segStart + segVector * t
    return (point - closest).Magnitude
end

function afBoostMult(cfg)
    local adjustCfg = cfg and cfg["Adjust Dynamically"]
    if not adjustCfg or adjustCfg.Enabled ~= true or not RainAntiFuture.BoostPending then
        return 1
    end
    RainAntiFuture.BoostPending = false
    return tonumber(adjustCfg.Multiplier) or 3
end

function afTriggerBoost()
    local cfg = shared.rain and shared.rain["Anti Future"]
    local adjustCfg = cfg and cfg["Adjust Dynamically"]
    if not cfg or cfg.Enabled ~= true or not RainAntiFuture.Active or not adjustCfg or adjustCfg.Enabled ~= true then
        return
    end
    RainAntiFuture.BoostPending = true
end

function afToggle()
    local cfg = shared.rain and shared.rain["Anti Future"]
    if not cfg or cfg.Enabled ~= true then
        return
    end
    if RainAntiFuture.Active then
        RainAntiFuture.Active = false
        RainAntiFuture.LastSpoofedVelocity = nil
        RainAntiFuture.LastServerPosition = nil
        RainAntiFuture.LastSpoofTime = nil
        RainAntiFuture.BoostPending = false
        if RainAntiFuture.Connection then
            RainAntiFuture.Connection:Disconnect()
            RainAntiFuture.Connection = nil
        end
        return
    end
    RainAntiFuture.Active = true
    RainAntiFuture.BoostPending = false
    local function randSigned(minV, maxV)
        local v = math.random(minV, maxV)
        if math.random(0, 1) == 0 then
            v = -v
        end
        return v
    end
    RainAntiFuture.Connection = trkConn(RunService.Heartbeat:Connect(function()
        local liveCfg = shared.rain and shared.rain["Anti Future"]
        local options = liveCfg and liveCfg.Options or {}
        local liveCharacter = Self.Character
        local liveHrp = liveCharacter and liveCharacter:FindFirstChild("HumanoidRootPart")
        local liveHum = liveCharacter and liveCharacter:FindFirstChildOfClass("Humanoid")
        if not RainAntiFuture.Active then
            RainAntiFuture.LastSpoofedVelocity = nil
            RainAntiFuture.LastServerPosition = nil
            RainAntiFuture.LastSpoofTime = nil
            RainAntiFuture.BoostPending = false
            if RainAntiFuture.Connection then
                RainAntiFuture.Connection:Disconnect()
                RainAntiFuture.Connection = nil
            end
            return
        end
        if not liveHrp then
            return
        end
        if options["Air Only"] == true and liveHum then
            local st = liveHum:GetState()
            if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then
                RainAntiFuture.LastServerPosition = liveHrp.Position
                RainAntiFuture.LastSpoofedVelocity = nil
                RainAntiFuture.LastSpoofTime = nil
                return
            end
        end
        local chance = options["Spoof Chance"] or 100
        if chance < 100 and math.random(1, 100) > chance then
            RainAntiFuture.LastServerPosition = liveHrp.Position
            RainAntiFuture.LastSpoofedVelocity = nil
            RainAntiFuture.LastSpoofTime = nil
            return
        end
        local strength = (options.Strength or 400) * afBoostMult(liveCfg)
        local randomness = options.Randomness or 3
        if randomness < 1 then
            randomness = 1
        end
        local vertical = options.Vertical ~= false
        local realVelocity = liveHrp.AssemblyLinearVelocity
        local spoofed
        if liveCfg.Direction == "Vertical" then
            spoofed = Vector3.new(0, vertical and randSigned(strength, strength * randomness) or 0, 0)
        elseif liveCfg.Direction == "Behind" then
            local horizontalReal = Vector3.new(realVelocity.X, 0, realVelocity.Z)
            local behindDir = (horizontalReal.Magnitude > 1) and -horizontalReal.Unit or -liveHrp.CFrame.LookVector
            local mag = math.random(strength, strength * randomness)
            local spoofY = vertical and randSigned(strength, strength * randomness) or 0
            spoofed = Vector3.new(behindDir.X * mag, spoofY, behindDir.Z * mag)
        elseif liveCfg.Direction == "Kinematic" then
            local gravity = workspace.Gravity or 196.2
            local scale = strength / math.max(realVelocity.Magnitude, 16)
            local kinematicVel = -realVelocity * scale
            local spoofY = vertical and (kinematicVel.Y - gravity * math.random(strength, strength * randomness) / 100) or 0
            spoofed = Vector3.new(kinematicVel.X, spoofY, kinematicVel.Z)
        else
            spoofed = Vector3.new(
                randSigned(strength, strength * randomness),
                vertical and randSigned(strength, strength * randomness) or 0,
                randSigned(strength, strength * randomness)
            )
        end
        RainAntiFuture.LastSpoofedVelocity = spoofed
        RainAntiFuture.LastServerPosition = liveHrp.Position
        RainAntiFuture.LastSpoofTime = os.clock()
        liveHrp.AssemblyLinearVelocity = spoofed
        RunService.RenderStepped:Wait()
        liveHrp.AssemblyLinearVelocity = realVelocity
    end))
end

function afInit67()
    local function healthHitDetection(character)
        if not character then
            return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
        if not humanoid then
            return
        end
        local lastHealth = humanoid.Health
        trkConn(humanoid.HealthChanged:Connect(function(newHealth)
            if newHealth < lastHealth then
                afTriggerBoost()
            end
            lastHealth = newHealth
        end))
    end
    if Self.Character then
        healthHitDetection(Self.Character)
    end
    trkConn(Self.CharacterAdded:Connect(healthHitDetection))
    if not Mango._RainAfBeamWatcher then
        local parent = beamPar()
        Mango._RainAfBeamWatcher = trkConn(parent.ChildAdded:Connect(function(child)
            if child.Name ~= "BULLET_RAYS" then
                return
            end
            local char = Self.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                return
            end
            local owner = child:GetAttribute("OwnerCharacter")
            if owner and owner == char.Name then
                return
            end
            local origin = child.CFrame.Position
            local look = child.CFrame.LookVector
            local attachments = child:GetChildren()
            local segEnd = origin + look * 200
            for _, att in ipairs(attachments) do
                if att:IsA("Attachment") and att.Name ~= "Attachment" then
                    local pos = att.WorldPosition
                    if (pos - origin).Magnitude > 1 then
                        segEnd = pos
                        break
                    end
                end
            end
            if afDistPointSeg(hrp.Position, origin, segEnd) <= 4 then
                afTriggerBoost()
            end
        end))
    end
    trkConn(UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end
        local cfg = shared.rain and shared.rain["Anti Future"]
        if not cfg or cfg.Enabled ~= true then
            return
        end
        local keyName = tostring(cfg.Keybind or "V")
        local ok, keyCode = pcall(function()
            return Enum.KeyCode[keyName:upper()]
        end)
        if ok and input.KeyCode == keyCode then
            afToggle()
        end
    end))
    if typeof(getgenv) == "function" then
        getgenv()._RainAntiFutureToggle = afToggle
        getgenv()._RainAntiFutureActive = function()
            return RainAntiFuture.Active
        end
    end
end

