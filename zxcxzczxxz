	local function syncKeybindToConfig(keybind, element)
		if type(keybind) ~= "table" or type(element) ~= "table" then
			return
		end
		if keybind["type"] ~= 3 then
			return
		end
		local flag = element["toggle_flag"]
		if type(flag) ~= "string" then
			return
		end
		local keyName = keyNameFromInput(keybind["key"])
		if keyName == "" then
			return
		end
		local parent = parentTableFromToggleFlag(flag)
		if type(parent) ~= "table" then
			return
		end
		parent["Keybind"] = keyName
		if parent["Toggle"] ~= nil then
			parent["Toggle"] = keyName
		end
		local mode = holdToggleFromMethod(keybind["method"] or 1)
		if type(parent["Mode"]) == "string" then
			parent["Mode"] = mode
		end
		if parent["Type"] == "Toggle" or parent["Type"] == "Hold" then
			parent["Type"] = mode
		end
	end

