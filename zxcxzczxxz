	local function fetchHeadshotPng(userId)
		if type(userId) ~= "number" or userId <= 0 then
			return nil
		end
		local cached = playerAvatarCache[userId]
		if type(cached) == "string" then
			return cached
		end
		if cached == false or cached == "pending" then
			return nil
		end
		playerAvatarCache[userId] = "pending"
		task.spawn(function()
			local png = nil
			local apiUrl = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
				.. tostring(userId)
				.. "&size=48x48&format=Png&isCircular=false"
			local okBody, body = pcall(function()
				return game:HttpGet(apiUrl)
			end)
			local imageUrl = nil
			if okBody and type(body) == "string" and HttpService then
				local okJson, decoded = pcall(function()
					return HttpService:JSONDecode(body)
				end)
				if okJson and type(decoded) == "table" and type(decoded.data) == "table" then
					local entry = decoded.data[1]
					if type(entry) == "table" and type(entry.imageUrl) == "string" then
						imageUrl = entry.imageUrl
					end
				end
			end
			if not imageUrl then
				imageUrl = "https://www.roblox.com/headshot-thumbnail/image?userId="
					.. tostring(userId)
					.. "&width=48&height=48&format=png"
			end
			local okImg, img = pcall(function()
				return game:HttpGet(imageUrl)
			end)
			if okImg and type(img) == "string" and #img > 64 then
				png = img
			end
			playerAvatarCache[userId] = png or false
		end)
		return nil
	end

