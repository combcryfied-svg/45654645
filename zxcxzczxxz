function xhairEnd(origin, weaponRange, refAim)
    local pt = curPt(origin, weaponRange)
    if pt then
        return clampAim(origin, pt, Self and Self.Character, weaponRange)
    end
    local dir = curDir(origin)
    if not dir then
        return nil
    end
    local dist = weaponRange
    if not dist and typeof(refAim) == "Vector3" then
        dist = math.max((refAim - origin).Magnitude, 1)
    end
    local endPos = origin + dir * (dist or 200)
    return clampAim(origin, endPos, Self and Self.Character, weaponRange)
