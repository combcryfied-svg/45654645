            if elapsed > life then
                pcall(function() line:Remove() end)
                pcall(function() outline:Remove() end)
                pcall(function() conn:Disconnect() end)
                return
            end
            local p1, o1 = cam:WorldToViewportPoint(startPos)
            local p2, o2 = cam:WorldToViewportPoint(endPos)
            if o1 and o2 and p1.Z > 0 and p2.Z > 0 then
