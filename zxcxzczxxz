		local AnimCfg = shared.rain and shared.rain.Utilities and shared.rain.Utilities["Animation Changer"]
		local enabled = type(AnimCfg) == "table"
			and AnimCfg.Enabled == true
			and rainEnabled67("Utilities.Animation Changer.Enabled")
