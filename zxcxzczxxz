    function seakitelolelemwowzers:set_toggle(value, just_keybind)
        local lilsmlolkeyb67 = keybind_data[self]
        if lilsmlolkeyb67 and not just_keybind then
            local is_on_not_held = lilsmlolkeyb67["method"] == 2
            lilsmlolkeyb67["value"] = value
            lilsmlolkeyb67["activated"] = is_on_not_held or value
            spawn(on_keybind_change["Fire"], on_keybind_change, lilsmlolkeyb67, self, is_on_not_held or value)
        end

        local drawings = self["drawings"]
        tween(drawings["text"], {Color = value and searunlolmenugetrain["colors"]["active_text"] or searunlolmenugetrain["colors"]["inactive_text"]}, exponential, out, 0.2)
        tween(drawings["checkmark"], {Transparency = value and 0.5 or 0}, exponential, out, 0.2)

        flags[self["toggle_flag"]] = value
        self["on_toggle_change"]:Fire(value)
    end

    function seakitelolelemwowzers:set_slider(value, just_keybind, instant, silent)
        local drawings = self["drawings"]
        local max = self["slider_max"]
        local min = self["slider_min"]
        value = clamp(value, min, max)

        local slider_flag = self["slider_flag"]
        if not just_keybind and not instant and slider_flag and flags[slider_flag] == value then
            return
        end

        local fill_size = udim2_new((value - min) / (max - min), value == max and -2 or 0, 1, -2)
        if instant then
            drawings["slider_fill"]["Size"] = fill_size
        else
            tween(drawings["slider_fill"], {tween_size = fill_size}, exponential, out, 0.2)
        end

        local text = drawings["slider_text"]
        if value == min then
            if instant then
                drawings["slider_line"]["Color"] = searunlolmenugetrain["colors"]["dark_text"]
            else
                tween(drawings["slider_line"], {Color = searunlolmenugetrain["colors"]["dark_text"]}, circular, out, 0.2)
            end
            text["Text"] = self["slider_min_text"] or self["slider_prefix"]..value..self["slider_suffix"]
        else
            if instant then
                drawings["slider_line"]["Color"] = searunlolmenugetrain["colors"]["accent"]
            else
                tween(drawings["slider_line"], {Color = searunlolmenugetrain["colors"]["accent"]}, circular, out, 0.2)
            end
            text["Text"] = (value == max and self["slider_max_text"]) or self["slider_prefix"]..value..self["slider_suffix"]
        end

        local lilsmlolkeyb67 = keybind_data[self]

        if lilsmlolkeyb67 then
            if not just_keybind then
                lilsmlolkeyb67["original_value"] = value
            end
        end

        -- silent = visual-only (linked FOV axes). Fire is spawned, so a linked
        -- write that also Fires re-enters catshoelollfswowzers forever.
        if not silent then
            flags[self["slider_flag"]] = value
            self["on_slider_change"]:Fire(value)
        end
    end

    function seakitelolelemwowzers:set_textbox(value)
        local stored = value == nil and "" or tostring(value)
        flags[self["textbox_flag"]] = stored
        local display = stored
        if display == "" then
            display = self["textbox_placeholder"] or "..."
