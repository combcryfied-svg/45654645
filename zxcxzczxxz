do
    -- Adonis bypass must never hard-crash the script (nil typeof/table.find/getgc on some executors).
    local okType = typeof or type
    local function tableFind(t, value)
        if type(table.find) == "function" then
            return table.find(t, value)
        end
        if type(t) ~= "table" then
            return nil
        end
        for i, v in pairs(t) do
            if v == value then
                return i
            end
        end
        return nil
    end
    pcall(function()
        if okType(hookfunction) ~= "function" or okType(getgc) ~= "function" then
            return
        end
        local genv = okType(getgenv) == "function" and getgenv() or {}
        if genv._RainAdonisBypassDone then
            return
        end
        local hookedDetected = {}
        local hookedKill = {}
        local primaryDetected = nil

        local function safeHook(old, replacement)
            if okType(old) ~= "function" then
                return old
            end
            local fakeOld = okType(clonefunction) == "function" and clonefunction(old) or old
            local replacements = {}
            for _, v in getgc(true) do
                if okType(v) == "table" then
                    local idx = tableFind(v, old)
                    if idx then
                        replacements[v] = idx
                    end
                end
            end
            local result = hookfunction(old, replacement)
            for tbl, idx in pairs(replacements) do
                rawset(tbl, idx, fakeOld)
            end
            return result or old
        end

        local function hookDetected(fn)
            if okType(fn) ~= "function" or hookedDetected[fn] then
                return
            end
            hookedDetected[fn] = true
            if not primaryDetected then
                primaryDetected = fn
            end
            safeHook(fn, function(...)
                return
            end)
        end

        local function hookKill(fn)
            if okType(fn) ~= "function" or hookedKill[fn] then
                return
            end
            hookedKill[fn] = true
            safeHook(fn, function(...)
                return
            end)
        end

        local function scanAntiCheat()
            for _, v in getgc(true) do
                if okType(v) == "table" then
                    local detected = rawget(v, "Detected")
                    if okType(detected) == "function" then
                        hookDetected(detected)
                    end
                    local anti = rawget(v, "Anti")
                    if okType(anti) == "table" and okType(rawget(anti, "Detected")) == "function" then
                        hookDetected(rawget(anti, "Detected"))
                    end
                    local kill = rawget(v, "Kill")
                    if okType(kill) == "function" then
                        hookKill(kill)
                    end
                end
            end
        end

        if okType(setthreadidentity) == "function" then
            setthreadidentity(2)
        end

        scanAntiCheat()

        pcall(function()
            local lp = game:GetService("Players").LocalPlayer
            if lp and okType(lp.Kick) == "function" then
                safeHook(lp.Kick, function(self, msg)
                    if okType(warn) == "function" then
                    end
                end)
            end
        end)

        if okType(getrenv) == "function" and okType(newcclosure) == "function" then
            pcall(function()
                local renv = getrenv()
                if renv and renv.debug and okType(renv.debug.info) == "function" then
                    local oldInfo = renv.debug.info
                    oldInfo = safeHook(oldInfo, newcclosure(function(...)
                        local a = ...
                        if primaryDetected and a == primaryDetected then
                            return coroutine.yield(coroutine.running())
                        end
                        return oldInfo(...)
                    end))
                end
            end)
        end

        genv._RainAdonisBypassDone = true
        genv._RainScanAntiCheat = scanAntiCheat

        if okType(task) == "table" and okType(task.defer) == "function" then
            task.defer(function()
                for _ = 1, 8 do
                    task.wait(2)
                    pcall(scanAntiCheat)
                end
            end)
        end

        if okType(setthreadidentity) == "function" then
            setthreadidentity(7)
        end
    end)
end
