            elseif okPlr(m.LockedTarget) then
                unified = m.LockedTarget
            else
                local closest = rainGetClosestPlayerCached67()
                if okPlr(closest) then
                    unified = closest
                end
            end
        end
    end

    if not unified and tpOn and tostring(agm["TP Bullet Mode"] or "Target") == "Auto" then
        local closest = rainGetClosestPlayerCached67()
        if okPlr(closest) then
            unified = closest
        end
    end

    if not unified and tbOn and selectAutomaticOn67() then
        if okPlr(m.TriggerbotTarget) then
            -- keep current trigger target
        elseif okPlr(m.LockedTarget) then
            m.TriggerbotTarget = m.LockedTarget
        else
            local closest = rainGetClosestPlayerCached67()
            m.TriggerbotTarget = okPlr(closest) and closest or nil
        end
    end

    if not unified then
        return
    end

    if saOn then
        m.SilentAimTarget = unified
        if selectAutomaticOn67() then
            m.LockedTarget = unified
            SP = true
        elseif saFovAutoTarget67() then
            SP = true
        elseif (selectModeOn67() and selectEngaged67()) or (SP and stickyPlr(m.LockedTarget)) then
            m.LockedTarget = unified
            SP = true
        end
    end
    if tbOn then
        m.TriggerbotTarget = unified
        if selectAutomaticOn67() or (selectModeOn67() and selectEngaged67()) then
            m.TriggerState = true
        end
    end
    if aaOn then
        m.AimAssistTarget = unified
        m.CamlockTarget = unified
        if selectAutomaticOn67() or (selectModeOn67() and selectEngaged67()) or (aa.Sticky == true and stickyPlr(m.LockedTarget)) then
            SP2 = true
        end
    end
    if tpOn then
        m.TpBulletActiveTarget = unified
        if tostring(agm["TP Bullet Mode"] or "Target") == "Target" then
            m.TpBulletLockedTarget = unified
        end
    end
    if heOn then
        m.HitExploitTarget = unified
    end
end

