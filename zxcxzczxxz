    end)

    task.defer(function()
        local retryDelays = { 0.1, 0.28, 0.55 }
        for _, dt in ipairs(retryDelays) do
            task.wait(dt)
            if not isApplyStillCurrent(applyToken) then
                destroyColorSnapshot(delayedSkinSnapshot)
                return
