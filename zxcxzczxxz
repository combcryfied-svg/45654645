function clampAim(origin, aimPos, shooter, maxRange)
    if typeof(origin) ~= "Vector3" or typeof(aimPos) ~= "Vector3" then
        return aimPos
    end
    local delta = aimPos - origin
    local dist = delta.Magnitude
    if dist < 1e-4 then
        return aimPos
    end
    local range = math.min(dist, tonumber(maxRange) or dist)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = rayIgn(shooter)
    params.IgnoreWater = true
    local hit = workspace:Raycast(origin, delta.Unit * range, params)
    if hit then
        return hit.Position
    end
    return origin + delta.Unit * range
end

function losChar(origin, targetChar, shooter)
