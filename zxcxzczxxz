        local function findKillRemote()
            if type(getRem) == "function" then
                local remote = getRem()
                if remote and remote:IsA("RemoteEvent") then
                    return remote
                end
            end
            local gameRemotes = ReplicatedStorage:FindFirstChild("GameRemotes")
            local mainRemotes = ReplicatedStorage:FindFirstChild("MainRemotes")
            local exact = (gameRemotes and gameRemotes:FindFirstChild("MainGameEvent"))
                or (mainRemotes and mainRemotes:FindFirstChild("MainRemoteEvent"))
            if exact and exact:IsA("RemoteEvent") then
                return exact
            end
            return nil
        end

        local function findLoadoutRemote()
            local exact = ReplicatedStorage:FindFirstChild("Loadout", true)
            if exact and exact:IsA("RemoteEvent") then
                return exact
            end
            for _, object in ipairs(ReplicatedStorage:GetDescendants()) do
                if object:IsA("RemoteEvent")
                    and object.Name:lower():find("loadout", 1, true)
                then
                    return object
                end
            end
            return nil
        end

        local KillAllRemote = findKillRemote()
        local LoadoutRemote = findLoadoutRemote()

        local function isFriendlyWhitelisted(player)
            return false
        end

        local function isInvalidRetaliateTarget(player)
            return isProtectedPlayer(player)
        end

        local function requestAmmoRefill(tool, ammo)
            if LoadoutRemote == nil
                or refillActive
                or tool == nil
                or ammo == nil
                or not SentryActive
                or ammo:GetAttribute("ZeeKillRefillRequested")
            then
                return false
            end

            local character = Self.Character
            local backpack = Self:FindFirstChild("Backpack")
            if backpack == nil then
                return false
            end

            ammo:SetAttribute("ZeeKillRefillRequested", true)
            refillActive = true

            local requestedName = tool.Name
            local oldTools = {}
            local equippedTools = {}
            local newestTools = {}
            local seenTools = {}

            for _, container in ipairs({ backpack, character }) do
                if container then
                    for _, item in ipairs(container:GetChildren()) do
                        if item:IsA("Tool") and Guns[item.Name] then
                            oldTools[item] = true
                            if item.Parent == character then
                                equippedTools[item.Name] = true
                            end
                        end
                    end
                end
            end
            local connections = {}
            local heartbeat
            local stopped = false
            local deadline = os.clock() + 2
            local lastAdded = os.clock()
            local gen = RefillGen

            local function stop()
                if stopped then return end
                stopped = true
                for _, connection in ipairs(connections) do
                    connection:Disconnect()
                end
                if heartbeat then
                    heartbeat:Disconnect()
                end
                if not newestTools[requestedName] and ammo.Parent then
                    ammo:SetAttribute("ZeeKillRefillRequested", nil)
                end
                refillActive = false
            end

            local function accept(item)
                if not item:IsA("Tool")
                    or not Guns[item.Name]
                    or oldTools[item]
                    or seenTools[item]
                then
                    return
                end
                seenTools[item] = true
                lastAdded = os.clock()
                local name = item.Name
                local previous = newestTools[name]
                if previous and previous ~= item and previous.Parent then
                    previous:Destroy()
                end
                newestTools[name] = item
                for oldTool in pairs(oldTools) do
                    if oldTool.Name == name and oldTool.Parent then
                        oldTool:Destroy()
                    end
                end
                if equippedTools[name] and character and item.Parent then
                    item.Parent = character
                end
            end

            connections[1] = backpack.ChildAdded:Connect(accept)
            if character then
                connections[2] = character.ChildAdded:Connect(accept)
            end

            LoadoutRemote:FireServer(desHoodApplyKnifeSlot67(desHoodGetLoadoutPayload67()))

            heartbeat = RunService.Heartbeat:Connect(function()
                if gen ~= RefillGen then
                    stop()
                    return
                end
                local now = os.clock()
                if now >= deadline
                    or (next(newestTools) and now - lastAdded >= 0.2)
                then
                    stop()
                end
            end)

            return true
        end

        local function usableAmmo(tool, ammo)
            if ammo.Value <= 0 then
                requestAmmoRefill(tool, ammo)
                return false
            end
            if not ammo:GetAttribute("ZeeKillAmmoWatching") then
                ammo:SetAttribute("ZeeKillAmmoWatching", true)
                local connection
                connection = CharSubscribe(ammo:GetPropertyChangedSignal("Value"), function()
                    if ammo.Value <= 0 then
                        connection:Disconnect()
                        requestAmmoRefill(tool, ammo)
                    end
                end)
            end
            return true
        end

        local function getRetaliateGun(character, backpack)
            local preferred = {
                "[TacticalShotgun]", "[Double-Barrel SG]", "[Revolver]",
                "[Shotgun]", "[Drum-Shotgun]", "[Deagle]", "[Glock]", "[Silencer]",
            }
            for _, name in ipairs(preferred) do
                local tool = (backpack and backpack:FindFirstChild(name))
                    or (character and character:FindFirstChild(name))
                if tool and tool:IsA("Tool") and tool:FindFirstChild("Ammo") and tool:FindFirstChild("Handle") then
                    return tool
                end
            end
            for _, container in ipairs({ character, backpack }) do
                if container then
                    for _, item in ipairs(container:GetChildren()) do
                        if item:IsA("Tool") and item:FindFirstChild("Ammo") and item:FindFirstChild("Handle") then
                            return item
                        end
                    end
                end
            end
            return nil
        end

        local function sentryUsesPelletRemote(remote)
            if not remote then
                return false
            end
            local n = remote.Name
            if n == "MainGameEvent" or n == "MainRemoteEvent" then
                return true
            end
            return type(CurrentGame) == "table" and CurrentGame.UsesHoodCustoms == true
        end

        local function fireSentryKillShot(remote, tool, handle, origin, hitPos, hitInst)
            if sentryUsesPelletRemote(remote) then
                local pellets = {}
                for _ = 1, 20 do
                    pellets[#pellets + 1] = {
                        AimPosition = hitPos,
                        Result1 = hitPos,
                        Result2 = hitInst,
                        Result3 = Vector3.yAxis,
                    }
                end
                local damageObject = tool:FindFirstChild("Damage")
                remote:FireServer("ShootGun", handle, origin, pellets, nil, nil, nil, math.huge, damageObject and damageObject.Value or 50)
                return
            end
            if type(fireSg) == "function" then
                if ShotgunWeapons67 and ShotgunWeapons67[tool.Name] then
                    local serverTime = workspace:GetServerTimeNow()
                    for _ = 1, 5 do
                        fireSg(handle, origin, hitPos, hitInst, Vector3.yAxis, serverTime)
                    end
                else
                    fireSg(handle, origin, hitPos, hitInst, Vector3.yAxis)
                end
                return
            end
            remote:FireServer("ShootGun", handle, origin, hitPos, hitInst, Vector3.yAxis)
        end

        local function killTargets(players)
            if not SentryActive or type(players) ~= "table" or #players == 0 then
                return false
            end
            if type(_SD_IsStimBusy) == "function" and _SD_IsStimBusy() then
                return false
            end

            local validTargets = {}
            for _, player in ipairs(players) do
                if player and not isInvalidRetaliateTarget(player) then
                    local targetCharacter = player.Character
                    local targetHumanoid = targetCharacter
                        and targetCharacter:FindFirstChildOfClass("Humanoid")
                    local head = targetCharacter and targetCharacter:FindFirstChild("Head")
                    local targetBE = targetCharacter and targetCharacter:FindFirstChild("BodyEffects")
                    local targetKO = targetBE and (targetBE:FindFirstChild("K.O") or targetBE:FindFirstChild("K.O."))
                    local targetKnocked = targetKO and targetKO.Value == true
                    if targetCharacter
                        and targetHumanoid
                        and targetHumanoid.Health > 0
                        and not targetKnocked
                        and head
                    then
                        validTargets[#validTargets + 1] = head
                    end
                end
            end
            if #validTargets == 0 then
                return false
            end

            local character = Self.Character
            local backpack = Self:FindFirstChild("Backpack")
            if character == nil or backpack == nil then
                return false
            end

            if KillAllRemote == nil or (KillAllRemote.Parent == nil) then
                KillAllRemote = findKillRemote() or (type(getRem) == "function" and getRem()) or KillAllRemote
            end

            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local tool = getRetaliateGun(character, backpack)
            local handle = tool and tool:FindFirstChild("Handle")
            local ammo = tool and tool:FindFirstChild("Ammo")
            local remote = KillAllRemote

            if remote == nil
                or humanoid == nil
                or tool == nil
                or handle == nil
                or ammo == nil
            then
                return false
            end
            if not usableAmmo(tool, ammo) then
                if type(_SD_BusyFor) == "function" then
                    _SD_BusyFor(2)
                end
                return false
            end

            local origin = handle.Position
            tool.Enabled = true
            if tool.Parent ~= character then
                tool.Parent = character
            end

            for _, head in ipairs(validTargets) do
                local position = head.Position
                for _ = 1, 8 do
                    pcall(fireSentryKillShot, remote, tool, handle, origin, position, head)
                end
            end

            if tool.Parent then
                tool.Parent = backpack
            end
            return true
        end

        local function killTarget(player)
            return killTargets({ player })
        end

        local function isGunTool(name)
            return Guns[name]
