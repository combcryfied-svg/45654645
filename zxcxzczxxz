            { "Head", "UpperTorso" },
            { "Head", "Torso" },
            { "UpperTorso", "LowerTorso" },
            { "Torso", "LowerTorso" },
            { "UpperTorso", "LeftUpperArm" },
            { "UpperTorso", "RightUpperArm" },
            { "Torso", "Left Arm" },
            { "Torso", "Right Arm" },
            { "LowerTorso", "LeftUpperLeg" },
            { "LowerTorso", "RightUpperLeg" },
            { "Torso", "Left Leg" },
            { "Torso", "Right Leg" },
        }
        local pairs = {}
        for _, link in ipairs(links) do
            local a, b = parts[link[1]], parts[link[2]]
            if a and b then
                pairs[#pairs + 1] = { a, b }
            end
        end
        if #pairs == 0 then
            return
        end
        local life = tonumber(cfg.Lifetime) or 0.8
        local col = rgb(cfg.Color, Color3.fromRGB(142, 242, 255))
        local thickness = tonumber(cfg.Thickness) or 3
        local lines = {}
        for i = 1, #pairs do
            local ln = Drawing.new("Line")
            ln.Color = col
            ln.Thickness = thickness
            ln.Visible = false
            lines[#lines + 1] = { ln = ln, a = pairs[i][1], b = pairs[i][2] }
        end
        local t0 = tick()
        local conn
        conn = RunService.RenderStepped:Connect(function()
            local cam = Cam
            if not cam then
                return
            end
            for _, L in ipairs(lines) do
                if L.a.Parent and L.b.Parent then
                    local p1, o1 = cam:WorldToViewportPoint(L.a.Position)
                    local p2, o2 = cam:WorldToViewportPoint(L.b.Position)
                    if o1 and o2 and p1.Z > 0 and p2.Z > 0 then
                        L.ln.Visible = true
                        L.ln.From = Vector2.new(p1.X, p1.Y)
                        L.ln.To = Vector2.new(p2.X, p2.Y)
                        if cfg.Animation == "fade" then
                            L.ln.Transparency = math.clamp((tick() - t0) / life, 0, 1)
                        else
                            L.ln.Transparency = 0
                        end
                    else
                        L.ln.Visible = false
                    end
                else
                    L.ln.Visible = false
                end
            end
            if tick() - t0 > life then
                for _, L in ipairs(lines) do
                    pcall(function() L.ln:Remove() end)
                end
                pcall(function() conn:Disconnect() end)
            end
        end)
        trkConn(conn)
    end

