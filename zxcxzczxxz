	local function getSilentAimFovMode()
		local sa = cfg.SilentAim
		local ft = type(sa) == "table" and (sa.FovType or sa["Fov Type"]) or "3D"
		if ft == "2D" or ft == "2DBox" or ft == "Hitbox" then
			return "2D"
