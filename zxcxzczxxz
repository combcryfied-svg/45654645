    local function tryRegisterShopEntry(shop, key, opts)
        if not shop or type(key) ~= "string" or key == "" then
            return false
        end
        opts = type(opts) == "table" and opts or {}
        local skipYCheck = opts.skipYCheck == true
        local head = shop:FindFirstChild("Head", true)
        if not head or not head:IsA("BasePart") then
            head = shop:FindFirstChild("HumanoidRootPart", true)
        end
        if not head or not head:IsA("BasePart") then
            head = shop:FindFirstChildWhichIsA("BasePart", true)
        end
        local detector = shop:FindFirstChildWhichIsA("ClickDetector", true)
        if not head or not head:IsA("BasePart") or not detector then
            return false
        end
        if not skipYCheck and head.Position.Y < -30 then
            return false
        end
        shopNames[key] = {
            button = head,
            detector = detector,
            price = tonumber(string.match(shop.Name, "%d+")) or 0,
        }
        return true
    end
    local function registerFullArmor(shopFolder)
        local tryList = {}
        local seen = {}
        local function queue(shop)
            if shop and not seen[shop] then
                seen[shop] = true
                tryList[#tryList + 1] = shop
            end
        end
        local kids = shopFolder:GetChildren()
        for _, shop in ipairs(kids) do
            if isFullArmorShopName(shop.Name) then
                queue(shop)
            end
        end
        for _, shop in ipairs(shopFolder:GetDescendants()) do
            if (shop:IsA("Model") or shop:IsA("Folder")) and isFullArmorShopName(shop.Name) then
                queue(shop)
            end
        end
        local bestShop = nil
        local bestDist = math.huge
        local hrp = Self.Character and Self.Character:FindFirstChild("HumanoidRootPart")
        local origin = hrp and hrp.Position
        for _, shop in ipairs(tryList) do
            if not isFullArmorShopName(shop.Name) then
                continue
            end
            local head = shop:FindFirstChild("Head", true)
                or shop:FindFirstChild("HumanoidRootPart", true)
                or shop:FindFirstChildWhichIsA("BasePart", true)
            local detector = shop:FindFirstChildWhichIsA("ClickDetector", true)
            if head and head:IsA("BasePart") and detector then
                local dist = origin and (head.Position - origin).Magnitude or 0
                if head.Position.Y >= -30 and dist < bestDist then
                    bestDist = dist
                    bestShop = shop
                end
            end
        end
        if bestShop then
            return tryRegisterShopEntry(bestShop, "fullarmor", { skipYCheck = true })
        end
        for _, shop in ipairs(tryList) do
            if not isFullArmorShopName(shop.Name) then
                continue
            end
            if tryRegisterShopEntry(shop, "fullarmor", { skipYCheck = true }) then
                return true
            end
        end
        return false
    end
    local function rebuildShop()
        shopNames = {}
        armorCount = 0
        local shopFolder = getShopFolder()
        if not shopFolder then
            shopBuilt = false
            return false
        end
        local nameSeen = {}
        for _, shop in shopFolder:GetChildren() do
            local rawName = string.match(shop.Name, "%b[]")
            if not rawName or string.find(rawName, "Phone", 1, true) then
                continue
            end
            local name = normalizeShopItemName(shop.Name)
            if not name or not isBuyArmorItemName(name) then
                continue
            end
            if shopIgnore[name] then
                continue
            end
            if nameSeen[name] then
                if name == "mediumarmor" then
                    armorCount = armorCount + 1
                    name = name .. tostring(armorCount)
                elseif name == "fullarmor" then
                    continue
                else
                    continue
                end
            end
            if tryRegisterShopEntry(shop, name) then
                nameSeen[name] = true
            end
        end
        registerFullArmor(shopFolder)
        shopBuilt = next(shopNames) ~= nil
        return shopBuilt
    end
