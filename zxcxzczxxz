        local names = { "Head", "UpperTorso", "Torso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }
        local parts = {}
        local seen = {}
        for _, name in ipairs(names) do
            local p = char:FindFirstChild(name)
            if p and p:IsA("BasePart") and not seen[p] then
                seen[p] = true
                parts[p.Name] = p
            end
