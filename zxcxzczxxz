        end
    end
    local mouse = Self and Self:GetMouse()
    if mouse and typeof(mouse.Hit) == "CFrame" then
        payload.AimPosition = mouse.Hit.Position
    else
        payload.AimPosition = origin + workspace.CurrentCamera.CFrame.LookVector * range
    end
