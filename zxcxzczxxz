        }

        local refillActive = false
        local RefillGen = 0
        local CharConns = {}
        local ProtectedPlayerConns = {}
        local HookedProtectedList = {}

        local function CharSubscribe(signal, fn)
            local conn = SentrySubscribe(signal, fn)
            CharConns[#CharConns + 1] = conn
