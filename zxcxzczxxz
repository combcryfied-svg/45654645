    end
    if (tonumber(ammo.Value) or 0) <= 0 then
        if desHoodInfAmmoOn67() then
            desHoodFireLoadout67()
        end
        return false
    end
    local pellets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if killAllValidTarget67(player) then
            local head = killAllHitPart67(player.Character)
            if head then
                local position = head.Position
                for _ = 1, 20 do
                    pellets[#pellets + 1] = {
                        AimPosition = position,
                        Result1 = position,
                        Result2 = head,
                        Result3 = Vector3.yAxis,
                    }
                end
            end
        end
    end
    if #pellets == 0 then
