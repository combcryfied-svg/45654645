        tween(context_border, {Transparency = 0, tween_position = udim2_new(0, position["X"], 0, position["Y"] - 5)}, circular, out, 0.15)
        tween(context_inside, hide_transparency, circular, out, 0.15)

        for i = 1, #context_buttons do
