    function joyantlolpanewowzers:update_position()
        if actives["panel"] then
            return
        end

        local scroll_index = self["scroll_index"]
        local elements = self["elements"]
        local fake_elements = {}

        for i = 1, #elements do
            local seakitelolelemwowzers = elements[i]
            if seakitelolelemwowzers["favorited"] then
                local frame = elements[i]["drawings"]["border"]
                frame["Visible"] = true
                frame["Position"] = udim2_new(0, 0, 0, 30 + (i - scroll_index) * 30)
                fake_elements[#fake_elements+1] = seakitelolelemwowzers
            end
        end

        for i = 1, #elements do
            local seakitelolelemwowzers = elements[i]
            if not seakitelolelemwowzers["favorited"] then
                fake_elements[#fake_elements+1] = seakitelolelemwowzers
            end
        end

        for i = 1, #fake_elements do
            local frame = fake_elements[i]["drawings"]["border"]
            if i >= scroll_index and i < scroll_index + 13 then
                frame["Visible"] = true
                frame["Position"] = udim2_new(0, 0, 0, 30 + (i - scroll_index) * 30)
            else
                frame["Visible"] = false
            end
        end
    end

