    end
    local norm = Vector3.new(0, 1, 0)
    if typeof(origin) == "Vector3" then
        local d = headPos - origin
        if d.Magnitude > 1e-4 then
            norm = d.Unit
        end
    end
    local entry = {
        pos = headPos,
        inst = headPart,
        norm = norm,
        expire = tick() + 0.55,
        magicBullet = true,
    }
    Mango.Locals._RainGhCbmServerHit = entry
    local queue = Mango.Locals._RainGhCbmServerHitQueue
    if type(queue) ~= "table" then
        queue = {}
        Mango.Locals._RainGhCbmServerHitQueue = queue
    end
    queue[#queue + 1] = entry
end

