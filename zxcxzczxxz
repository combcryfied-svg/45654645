    local spoofChar = cs.Char
    if type(spoofChar) == "table" then
        ch.Enabled = spoofChar.Enabled == true
        local targetUser = tostring(spoofChar.Username or "")
        if targetUser == "thisisausername" then
            targetUser = ""
        end
        ch.Target = targetUser
        ch["Apply Respawn"] = spoofChar["Apply Respawn"] == true
        ch["Override Animation"] = spoofChar["Override Animation"] == true
        local headless = spoofChar.Headless == true
        local korblox = spoofChar.Korblox == true
        ch.Headless = headless
        ch.Korblox = korblox
        ch.Accessories = {
