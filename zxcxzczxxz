--[=[ Rain Web: load config from rainnewuiloader-web BEFORE script runs ]=]
do
	local function rainWebHttpGet(url)
		if type(request) == "function" then
			local ok, res = pcall(request, { Url = url, Method = "GET", Headers = { ["Accept"] = "application/json" } })
			if ok and type(res) == "table" and (res.StatusCode == 200 or res.Success == true) then
				return res.Body
			end
		end
		if game and typeof(game.HttpGet) == "function" then
			local ok, body = pcall(function()
				return game:HttpGet(url)
			end)
			if ok then
				return body
			end
		end
		return nil
	end

	local function rainWebDeepMerge(dst, src)
		if type(dst) ~= "table" or type(src) ~= "table" then
			return
		end
		for k, v in pairs(src) do
			if type(v) == "table" and type(dst[k]) == "table" then
				local list = true
				for kk in pairs(v) do
					if type(kk) ~= "number" then
						list = false
						break
					end
				end
				if list then
					dst[k] = v
				else
					rainWebDeepMerge(dst[k], v)
				end
			else
				dst[k] = v
			end
		end
	end

	local g = typeof(getgenv) == "function" and getgenv() or {}
	local base = tostring(g.RAIN_WEB_URL or "http://getrain.club"):gsub("/$", "")
	-- Prefer plain HTTP: getrain.club HTTPS is not ready (cert/443), Roblox fails on https.
	if base:match("^https://getrain%.club") then
		base = "http://getrain.club"
	end
	local mode = tostring(g.RAIN_WEB_MODE or "rage")
	local key = tostring(g.RAIN_LOADER_KEY or g.LOADER_KEY or "")
	if (key == "" or key == "nil") and type(LOADER_KEY) == "string" then
		key = LOADER_KEY
	end

	if key ~= "" and key ~= "nil" then
		local HttpService = game:GetService("HttpService")
		local bootUrl = base .. "/api/bootstrap?key=" .. HttpService:UrlEncode(key) .. "&mode=" .. HttpService:UrlEncode(mode)
		local body = rainWebHttpGet(bootUrl)
		if type(body) == "string" and body ~= "" then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(body)
			end)
			if ok and type(data) == "table" then
				if type(data.script_key) == "string" and data.script_key ~= "" then
					script_key = data.script_key
					if typeof(getgenv) == "function" then
						getgenv().script_key = data.script_key
					end
				end
				if type(data.rain) == "table" then
					shared.rain = data.rain
					shared.rain["Web Configs"] = {
						Enabled = true,
						["API Key"] = key,
						["Server URL"] = base,
						Mode = mode,
					}
					shared.Rain = shared.rain
					rainWebForceNoUI()
				end
				if typeof(getgenv) == "function" then
					getgenv()._RAIN_WEB_REVISION = tonumber(data.revision) or 0
				end
			end
		else
			warn("[Rain Web] Could not reach " .. base .. " - is npm start running?")
		end

		task.spawn(function()
			local HttpService = game:GetService("HttpService")
			local lastRevision = (typeof(getgenv) == "function" and tonumber(getgenv()._RAIN_WEB_REVISION)) or 0
			local function ping()
				rainWebHttpGet(base .. "/api/heartbeat?key=" .. HttpService:UrlEncode(key))
			end
			local function pull()
				local url = base .. "/api/live-config?key=" .. HttpService:UrlEncode(key) .. "&mode=" .. HttpService:UrlEncode(mode)
				local raw = rainWebHttpGet(url)
				if not raw or raw == "" then
					return
				end
				local ok, data = pcall(function()
					return HttpService:JSONDecode(raw)
				end)
				if not ok or type(data) ~= "table" or type(data.rain) ~= "table" then
					return
				end
				local rev = tonumber(data.revision) or 0
				if rev <= lastRevision then
					return
				end
				lastRevision = rev
				if typeof(getgenv) == "function" then
					getgenv()._RAIN_WEB_REVISION = rev
				end
				-- Full replace so Apply matches the website table (no stale nested keys)
				local keepWeb = type(shared.rain) == "table" and shared.rain["Web Configs"] or nil
				shared.rain = data.rain
				if type(keepWeb) == "table" then
					shared.rain["Web Configs"] = keepWeb
				elseif type(shared.rain["Web Configs"]) ~= "table" then
					shared.rain["Web Configs"] = {
						Enabled = true,
						["API Key"] = key,
						["Server URL"] = base,
						Mode = mode,
					}
				end
				rainWebForceNoUI()
				if type(rainApplyLiveConfig67) == "function" then
					pcall(rainApplyLiveConfig67)
				elseif type(norm67) == "function" then
					pcall(norm67)
					if type(rainSyncRuntimeFromConfig67) == "function" then
						pcall(rainSyncRuntimeFromConfig67)
					end
				end
			end
			ping()
			pcall(pull)
			while true do
				task.wait(0.5)
				pcall(pull)
				pcall(ping)
			end
		end)
	else
		warn("[Rain Web] No LOADER_KEY - set it from the dashboard loader snippet, or getgenv().LOADER_KEY")
	end
end

