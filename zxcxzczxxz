    if n >= 6 and typeof(args[6]) ~= "Vector3" and typeof(oldOrigin) == "Vector3" then
        local normal = hit - oldOrigin
        if normal.Magnitude > 1e-4 then
            args[6] = normal.Unit
        end
    end
    if n >= 6 and typeof(args[6]) ~= "Vector3" then
        args[6] = Vector3.new(0, 1, 0)
