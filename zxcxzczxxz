	local function coerceFlagValue(parts, value)
		if value == nil then
			return nil
		end
		if typeof(value) == "EnumItem" then
			return value.Name
		end
		if typeof(value) == "Color3" then
			local current = getAt(parts)
			if isRgb(current) then
				return { floor(value.R * 255), floor(value.G * 255), floor(value.B * 255) }
			end
			return value
		end
		if type(value) == "table" and type(value[1]) == "number" and type(value[2]) == "number" and type(value[3]) == "number" and value[4] == nil and value.R == nil then
			return value
		end
		if type(value) == "table" and #value == 1 and type(value[1]) == "string" and value[2] == nil then
			local leaf = parts[#parts]
			if leaf == "Layout" or leaf == "NameMode" or leaf == "Font" or leaf == "Mode" or leaf == "FovType"
				or leaf == "Point" or leaf == "Type" or leaf == "Part" or leaf == "Input" or leaf == "DetectionMode"
				or leaf == "Preset" or leaf == "Movement" or leaf == "Direction" or leaf == "NearestPlane"
				or leaf == "Easing" or leaf == "Bone" then
				return value[1]
			end
		end
		return value
	end

	local function applyFlagsToRainConfig(sourceFlags)
		if type(sourceFlags) ~= "table" or type(cfg) ~= "table" then
			return
		end
		for flag, value in sourceFlags do
			if type(flag) ~= "string" or flag:sub(1, 1) == "!" or SKIP_CONFIG_FLAGS[flag] or flag:sub(-6) == "_color" then
				continue
			end
			local parts = splitFlag(flag)
			if #parts < 1 then
				continue
			end
			local coerced = coerceFlagValue(parts, value)
			if coerced ~= nil then
				setAt(parts, coerced)
			end
		end
	end

