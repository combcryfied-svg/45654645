function twistBeam(part, origin, legitEnd, shooter, weaponRange)
    if not part or typeof(origin) ~= "Vector3" or typeof(legitEnd) ~= "Vector3" then
        return
    end
    legitEnd = clampAim(origin, legitEnd, shooter, weaponRange)
    local mag = (legitEnd - origin).Magnitude
    if mag < 1e-4 then
        return
    end
    part.CFrame = CFrame.new(origin, legitEnd)
    local attachments = {}
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Attachment") then
            attachments[#attachments + 1] = child
        end
    end
    table.sort(attachments, function(a, b)
        return a.Position.Z < b.Position.Z
    end)
    if attachments[1] then
        attachments[1].Position = Vector3.new(0, 0, 0)
    end
    if attachments[#attachments] then
        attachments[#attachments].Position = Vector3.new(0, 0, -mag)
    end
end

