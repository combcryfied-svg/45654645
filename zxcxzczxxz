        unified = m.TpBulletLockedTarget
    else
        for _, plr in ipairs({
            m.SilentAimTarget,
            m.AimAssistTarget,
            m.TriggerbotTarget,
            m.CamlockTarget,
            m.TpBulletActiveTarget,
            m.HitExploitTarget,
        }) do
            if okPlr(plr) then
                unified = plr
                break
            end
        end
    end

    if not unified and saOn then
        if selectAutomaticOn67() or saFovAutoTarget67() then
            if okPlr(m.LockedTarget) then
                unified = m.LockedTarget
            elseif okPlr(m.SilentAimTarget) then
                unified = m.SilentAimTarget
