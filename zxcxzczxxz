    if selectAutomaticOn67() then
        if okPlr(m.LockedTarget) then
            unified = m.LockedTarget
        elseif okPlr(m.SilentAimTarget) then
            unified = m.SilentAimTarget
        end
    elseif stickyPlr(m.LockedTarget) and (
        (selectModeOn67() and selectEngaged67())
