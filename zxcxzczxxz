function rainNormGunRange67(v, default)
    if rainNumIsInf67(v) then
        return math.huge
    end
    return math.max(math.floor(tonumber(v) or default or 1000), 100)
end

-- Saved configs store colours as {r, g, b}, so any config colour may come back
-- as an array rather than the Color3 it was declared as.
function rainColor3From67(value, r, g, b)
    if typeof(value) == "Color3" then
        return value
    end
    if type(value) == "table" then
        if type(value[1]) == "number" then
            return Color3.fromRGB(
                math.clamp(math.floor(tonumber(value[1]) or r), 0, 255),
                math.clamp(math.floor(tonumber(value[2]) or g), 0, 255),
                math.clamp(math.floor(tonumber(value[3]) or b), 0, 255)
            )
        end
        if type(value.R) == "number" and type(value.G) == "number" and type(value.B) == "number" then
            return Color3.new(value.R, value.G, value.B)
        end
    end
    return Color3.fromRGB(r, g, b)
end

