function hcResolveHitPart(hit)
    local aimPlayer = getSaPlr()
    local char = aimPlayer and aimPlayer.Character
    if not char then
        return nil
    end
    local head = char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head
    end
    if typeof(hit) ~= "Vector3" then
        return nil
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local lp = p.CFrame:PointToObjectSpace(hit)
            local h = p.Size * 0.5
            if math.abs(lp.X) <= h.X + 0.45 and math.abs(lp.Y) <= h.Y + 0.45 and math.abs(lp.Z) <= h.Z + 0.45 then
                return p
            end
        end
    end
    return nil
end

