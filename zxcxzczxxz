        local function filterRetaliateTargets(players)
            local out, seen = {}, {}
            if type(players) ~= "table" then
                return out
            end
            for _, player in ipairs(players) do
                if player
                    and not seen[player]
                    and not isInvalidRetaliateTarget(player)
                    and not isFriendlyWhitelisted(player)
                    and not isDowned(player)
                then
                    seen[player] = true
                    out[#out + 1] = player
                end
            end
            return out
        end

        local function mergeRetaliateTargets(...)
            local out, seen = {}, {}
            for i = 1, select("#", ...) do
                local list = select(i, ...)
                if type(list) == "table" then
                    for _, player in ipairs(list) do
                        if player and not seen[player] then
                            seen[player] = true
                            out[#out + 1] = player
                        end
                    end
                end
            end
            return filterRetaliateTargets(out)
        end

        local function resolveRetaliateTargets(victimPlr, attacker, firers)
            local myChar = victimPlr and victimPlr.Character
            local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            local creatorAttackers = findAllCreatorAttackers(hum, myChar, victimPlr)
            local validFirers = filterRetaliateTargets(firers)
            local validCreators = filterRetaliateTargets(creatorAttackers)

            if #validCreators >= 2 then
                return validCreators, "multi-creator-tag"
            end
            if #validFirers >= 2 then
                return validFirers, "multi-firer"
            end

            local merged = mergeRetaliateTargets(validCreators, validFirers)
            if #merged >= 2 then
                return merged, "multi-attacker"
            end
            if attacker and not isInvalidRetaliateTarget(attacker) then
                return { attacker }, "single-attacker"
            end
            if #validFirers == 1 then
                return validFirers, "sole-firer"
            end
            if #validCreators == 1 then
                return validCreators, "single-creator-tag"
            end
            return {}, "no-evidence"
        end

