        local GunWatch = setmetatable({}, { __mode = "k" })

        local FireTracker = {
            FiredAt = {},
            Mouse = {},
        }

        local HealthStates = {}

        local function defaultHealthState()
            return {
                Last = nil,
                LastDefense = nil,
                LastArmor = nil,
                LastHitAt = 0,
                LastGunshotAt = 0,
                LastTrustedShooter = nil,
                LastTrustedAt = 0,
            }
        end

        local function getHealthState(plr)
            if not plr then
                return defaultHealthState()
            end
            local state = HealthStates[plr]
            if not state then
                state = defaultHealthState()
                HealthStates[plr] = state
            end
            return state
        end

        local function SentryResetCharacter()
            for _, conn in ipairs(CharConns) do
                pcall(function()
                    if conn and conn.Disconnect then conn:Disconnect() end
                end)
            end
            CharConns = {}
            RefillGen = RefillGen + 1
            refillActive = false
            HealthStates = {}
            FireTracker.Mouse = {}
        end

        local function isCreatorTagName(name)
            if type(name) ~= "string" then
                return false
            end
            local ln = string.lower(name)
            local compact = (ln:gsub("%s+", ""))
            return compact == "creator"
                or compact == "creatortag"
                or compact == "killer"
                or compact == "damager"
                or compact == "lastdamager"
                or compact == "attacker"
                or compact == "causedby"
                or compact == "hitby"
                or compact == "lastattacker"
                or compact == "lastdamage"
                or compact == "lasthit"
                or compact == "damagedby"
                or compact == "shooter"
                or ln == "creator tag"
                or ln == "last damager"
                or ln == "last attacker"
                or ln == "hit by"
        end

        local function playerFromValue(value)
            if typeof(value) == "Instance" then
                if value:IsA("Player") then
                    return value
                end
                local plr = Players:GetPlayerFromCharacter(value)
                if plr then
                    return plr
                end
                if value.Parent and value.Parent:IsA("Model") then
                    return Players:GetPlayerFromCharacter(value.Parent)
                end
            elseif type(value) == "string" and value ~= "" then
                local byName = Players:FindFirstChild(value)
                if byName and byName:IsA("Player") then
                    return byName
                end
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Name == value or plr.DisplayName == value then
                        return plr
                    end
                end
            elseif type(value) == "number" then
                local ok, plr = pcall(Players.GetPlayerByUserId, Players, value)
                if ok then
                    return plr
                end
            end
            return nil
        end

        local function playerFromTag(tag)
            if not tag then
                return nil
            end
            if tag:IsA("ObjectValue") then
                return playerFromValue(tag.Value)
            end
            if tag:IsA("StringValue") or tag:IsA("IntValue") or tag:IsA("NumberValue") then
                return playerFromValue(tag.Value)
            end
            return nil
        end

        local function rememberTrusted(plr, why, victimPlr)
            if not plr or plr == Self or plr.Parent ~= Players then
                return
            end
            if isFriendlyWhitelisted(plr) then
                return
            end
            local state = getHealthState(victimPlr)
            state.LastTrustedShooter = plr
            state.LastTrustedAt = os.clock()
        end

        local function collectCreatorPlayers(root, into, seen)
            if not root then
                return
            end
            local function consider(inst)
                if not (inst:IsA("ObjectValue") or inst:IsA("StringValue")
                    or inst:IsA("IntValue") or inst:IsA("NumberValue"))
                then
                    return
                end
                if not isCreatorTagName(inst.Name) then
                    return
                end
                local plr = playerFromTag(inst)
                if plr and not isInvalidRetaliateTarget(plr) and not seen[plr] and not isFriendlyWhitelisted(plr) then
                    seen[plr] = true
                    into[#into + 1] = plr
                end
            end
            for _, child in ipairs(root:GetChildren()) do
                consider(child)
            end
            for _, desc in ipairs(root:GetDescendants()) do
                consider(desc)
            end
        end

        local function findAllCreatorAttackers(hum, char, victimPlr)
            if not hum then
                hum = char and char:FindFirstChildOfClass("Humanoid")
            end
            if not hum then
                return {}
            end
            local list, seen = {}, {}
            collectCreatorPlayers(hum, list, seen)
            if char then
                collectCreatorPlayers(char, list, seen)
                local be = char:FindFirstChild("BodyEffects")
                if be then
                    collectCreatorPlayers(be, list, seen)
                end
            end
            return list
        end

        local function findCreatorAttacker(hum, char, victimPlr)
            local list = findAllCreatorAttackers(hum, char, victimPlr)
            if #list == 0 then
                return nil
            end
            if #list == 1 then
                return list[1]
            end
            local seen = {}
            for _, plr in ipairs(list) do
                seen[plr] = true
            end
            local locked = getHealthState(victimPlr).LastTrustedShooter
            if locked and seen[locked] then
                return locked
            end
            return nil
        end

        local function recordFire(player, why)
            if not player or isInvalidRetaliateTarget(player) then
                return
            end
            FireTracker.FiredAt[player] = os.clock()
            FireTracker.FireWhy = FireTracker.FireWhy or {}
            FireTracker.FireWhy[player] = why or "fire"
        end

        local function findAmmoValue(tool)
            if not tool then
                return nil
            end
            local ammo = tool:FindFirstChild("Ammo")
                or tool:FindFirstChild("ammo")
                or tool:FindFirstChild("AMMO")
            if ammo and ammo:IsA("ValueBase") then
                return ammo
            end
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("ValueBase") and string.lower(d.Name) == "ammo" then
                    return d
                end
            end
            return nil
        end

        local function allToolsWithAmmo(player)
            local list = {}
            local function add(container)
                if not container then
                    return
                end
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") and findAmmoValue(t) then
                        list[#list + 1] = t
                    end
                end
            end
            add(player.Character)
            add(player:FindFirstChild("Backpack"))
            return list
        end

        local function watchGunFiringFlag(be, player)
            if not be or be:GetAttribute("__sentry_gf_watch") then
                return
            end
            be:SetAttribute("__sentry_gf_watch", true)
            for _, name in ipairs({ "GunFiring", "Shooting", "Attacking", "GunFire" }) do
                local flag = be:FindFirstChild(name)
                if flag and flag:IsA("ValueBase") and not flag:GetAttribute("__sentry_gf") then
                    flag:SetAttribute("__sentry_gf", true)
                    SentrySubscribe(flag.Changed, function()
                        local v = flag.Value
                        if v == true or v == 1 then
                            recordFire(player, name)
                        end
                    end)
                end
            end
        end

        local function scanPlayers()
            local now = os.clock()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= Self then
                    local char = p.Character
                    if char then
                        local be = char:FindFirstChild("BodyEffects")
                        if be then
                            local mp = be:FindFirstChild("MousePos")
                            if mp then
                                local ok, v = pcall(function()
                                    return mp.Value
                                end)
                                if ok and typeof(v) == "Vector3" then
                                    FireTracker.Mouse[p] = v
                                end
                            end
                            watchGunFiringFlag(be, p)
                        end
                    end
                    for _, tool in ipairs(allToolsWithAmmo(p)) do
                        local ammo = findAmmoValue(tool)
                        local watch = GunWatch[tool]
                        if ammo then
                            local val = tonumber(ammo.Value) or 0
                            if watch then
