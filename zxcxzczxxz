    local start_typing = LPH_JIT_MAX(function(label, limit, callback, numbers, allow_enter, allow_all, only_on_enter) -- > LOL dont ask im too lazy to rewrite this >->
        if active_typing and active_typing == label and typing_box then
            pcall(function()
                typing_box:CaptureFocus()
                typing_box["CursorPosition"] = #typing_box["Text"] + 1
                typing_box["SelectionStart"] = 1
            end)
            return
        end

        if active_typing then
            stop_typing(true)
        end

        local existing = tostring(label["Text"] or "")
        if existing == "..." then
            existing = ""
        end

        type_line["Size"] = udim2_new(0, 1, 0, label["Size"] - 1)
        active_typing = label
        type_line["Visible"] = true
        heartbeat[#heartbeat + 1] = type_function

        old_text = existing
        label["Text"] = existing == "" and "..." or existing

        local function filter_text(text)
            text = tostring(text or "")
            if numbers then
                text = text:gsub("[^0-9%.,%-]", "")
            end
            if type(limit) == "number" and limit > 0 and #text > 80 then
                text = text:sub(1, 80)
            end
            return text
        end

        local function sync_label(text)
            label["Text"] = text == "" and "..." or text
        end

        local function fire_callback(text, input)
            if type(callback) ~= "function" then
                return
            end
            pcall(callback, text, input)
        end

        local box = create_instance("TextBox", {
            ["Name"] = "\0",
            ["Parent"] = hui,
            ["BackgroundTransparency"] = 1,
            ["TextTransparency"] = 1,
            ["TextStrokeTransparency"] = 1,
            ["ClearTextOnFocus"] = false,
            ["TextEditable"] = true,
            ["MultiLine"] = false,
            ["Text"] = existing,
            ["Size"] = udim2_new(0, 8, 0, 8),
            ["Position"] = udim2_new(0, -20000, 0, -20000),
            ["ZIndex"] = 9999,
            ["TextSize"] = 1,
        })
        typing_box = box

        typing_conns[#typing_conns + 1] = box:GetPropertyChangedSignal("Text"):Connect(function()
            if typing_box ~= box then
                return
            end
            local filtered = filter_text(box["Text"])
            if filtered ~= box["Text"] then
                box["Text"] = filtered
                return
            end
            sync_label(filtered)
            if not only_on_enter then
                fire_callback(filtered)
            end
        end)

        typing_conns[#typing_conns + 1] = box.FocusLost:Connect(function(enter_pressed)
            if typing_box ~= box then
                return
            end
            local text = filter_text(box["Text"])
            if enter_pressed or not only_on_enter then
                fire_callback(text)
            elseif only_on_enter then
                fire_callback(text)
            end
            stop_typing(true)
            if enter_pressed then
                if searching then
                    stop_search()
                end
                if actives["panel"] then
                    stop_panel_search()
                end
