function airJumpInit67()
    local uis = UserInputService
    local LocalPlayer = game:GetService("Players").LocalPlayer
    local RunService = game:GetService("RunService")
    local lastAirJumpAt = 0
    local AIR_JUMP_COOLDOWN = 0.15

    local function airJumpCfg()
        return shared.rain and shared.rain["Air Jump"]
    end

    local function airJumpOn()
        local cfg = airJumpCfg()
        return type(cfg) == "table" and cfg.Enabled == true
    end

    local function inAir(hum, hrp)
        if not hum or not hrp then
            return false
        end
        if hum.FloorMaterial ~= Enum.Material.Air then
            return false
        end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.FallingDown then
            return true
        end
        if st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Physics then
            return hrp.AssemblyLinearVelocity.Y <= 2
        end
        return false
    end

    local function tryAirJump()
        if not airJumpOn() then
            return
        end
        if uis:GetFocusedTextBox() then
            return
        end
        local now = os.clock()
        if now - lastAirJumpAt < AIR_JUMP_COOLDOWN then
            return
        end
        local char = LocalPlayer.Character
        if not char then
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or not inAir(hum, hrp) then
            return
        end
        lastAirJumpAt = now
        local cfg = airJumpCfg()
        local power = tonumber(cfg and cfg["Jump Power"]) or hum.JumpPower or 50
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(
                hrp.AssemblyLinearVelocity.X,
                power,
                hrp.AssemblyLinearVelocity.Z
            )
        end)
    end

    trkConn(uis.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end
        if input.KeyCode ~= Enum.KeyCode.Space then
            return
        end
        tryAirJump()
    end))

    trkConn(RunService.Heartbeat:Connect(function()
        if not airJumpOn() then
            return
        end
        if uis:IsKeyDown(Enum.KeyCode.Space) then
            tryAirJump()
        end
    end))

    trkConn(LocalPlayer.CharacterAdded:Connect(function()
        lastAirJumpAt = 0
    end))
end

