    if inst.Name == "Head" then
        return nil
    end
    if not DAMAGE_OVERRIDER_BODY67[inst.Name] then
        return nil
    end
    local char = inst:FindFirstAncestorOfClass("Model")
    if not char then
        local p = inst.Parent
        if p and p:IsA("Model") then
            char = p
        elseif p and p.Parent and p.Parent:IsA("Model") then
            char = p.Parent
        end
    end
    if not char or not char:FindFirstChildOfClass("Humanoid") then
        return nil
    end
    if Self and char == Self.Character then
        return nil
    end
    local head = char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head
    end
    return nil
end

