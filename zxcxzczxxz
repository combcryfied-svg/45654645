	local function bindSlider(element, parts, flag, spec)
		-- create_element already applied the default; calling set_slider here
		-- Fire-spawns refreshLinkedFovSliders and used to freeze the game.
		fovSliderElements[flag] = element
		create_connection(element["on_slider_change"], function(value)
			if fovSyncActive then
				return
			end
			local stored = value
			if spec.infinite and value >= spec.max then
				stored = INFINITE
			end
			setAt(parts, stored)
			flags[flag] = stored
			refreshLinkedFovSliders(parts, stored, spec)
			if type(flag) == "string" and flag:find("Game Specific.Des Hood.", 1, true) == 1 then
				task.defer(norm67)
			end
		end)
	end

