    local function woodieAutoShootTick(mode)
        local autoShoot = rGet("Silent Aim", "Auto Shoot", "Woodie Auto Shoot", true) == true
        local instaKill = rGet("Silent Aim", "Insta Kill", "Woodie Insta Kill", false) == true
        if not autoShoot and not instaKill then
            return
        end
        if not SA.active then
            return
        end
        if instaKill then
            if mode == "target all" or mode == "auto select" then
                local plr = closestToMouse()
                if plr and plr.Parent and (plr.Character or SA.target == plr) then
                    if validTarget(plr) or (SA.target == plr and plr.Character) then
                        woodieShootTarget67(plr)
                    end
                end
            elseif SA.target and SA.target.Parent then
                if validTarget(SA.target) or SA.target.Character then
                    woodieShootTarget67(SA.target)
                end
            end
            return
        end
        local tool = equipShootTool()
        if not tool then
            return
        end
        local ammo = tool:FindFirstChild("Ammo")
        if ammo and ammo.Value <= 0 then
            return
        end
        woodiePatchFireRate67(tool)
        if SA.target and SA.target.Parent and SA.target.Character then
            local now = os.clock()
            if now - woodieLastAutoActivate67 >= WOODIE_ACTIVATE_COOLDOWN67 then
                woodieLastAutoActivate67 = now
                pcall(function() tool:Activate() end)
            end
        end
    end

    local function saTick()
        if not rageBotOn67() then
            -- Feature off: pause aim, never unselect sticky lock.
            if SA.target and SA.target.Parent and not SA.manualUntarget then
                if typeof(getgenv) == "function" then
                    getgenv()._RainRageBotSA = { active = false, target = SA.target }
                end
            end
            updateTargetInfo()
            return
        end
        local mode = string.lower(tostring(rGet("Silent Aim", "Mode", "Woodie Silent Mode", "Sticky")))
        SA.mode = mode
        if SA.manualUntarget then
            if SA.active or SA.target then
                clearTarget(true)
            end
            if typeof(getgenv) == "function" then
                getgenv()._RainRageBotSA = { active = false, target = nil }
            end
            updateTargetInfo()
            updateSpectate()
            return
        end
        -- Permanent lock: if we have a player, always stay active on them.
        if SA.target and SA.target.Parent then
            if not SA.active then
                SA.active = true
            end
            if not targetRespawnConn then
                bindTargetRespawn(SA.target)
            end
        elseif SA.target and not SA.target.Parent then
            -- Left the server — only then drop.
            clearTarget(true)
            updateTargetInfo()
            return
        end
        if not SA.active then
            if typeof(getgenv) == "function" then
                getgenv()._RainRageBotSA = { active = false, target = SA.target }
            end
            updateTargetInfo()
            return
        end
        if mode == "target all" and not SA.target then
            -- Target-all with no sticky pick: keep sweeping.
            local plr = closestToMouse()
            if plr then
                syncSaAimPlr(plr)
            end
        elseif mode == "auto select" and not SA.target then
            local plr = closestToMouse()
            if plr then
                setTarget(plr)
            end
        elseif SA.target and SA.target.Parent then
            -- Locked forever until keybind: never swap / never nil.
            updateStickyAimPart()
            updateRageTargetHighlight()
            syncSaAimPlr(SA.target)
        end
        updateTargetInfo()
        updateSpectate()
        syncRageAimLocals()
        woodieAutoShootTick(mode)
        if typeof(getgenv) == "function" then
            getgenv()._RainRageBotSA = { active = SA.active, target = SA.target }
        end
    end

