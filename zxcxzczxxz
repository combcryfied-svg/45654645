        local function pickBestAttacker(candidates, myHead, victimPlr)
            if not candidates or #candidates == 0 then
                return nil, "none"
            end

            if #candidates == 1 then
                return candidates[1], "sole-firer"
            end

            local aimed = {}
            for _, p in ipairs(candidates) do
                if mouseOnUs(p, myHead) then
                    aimed[#aimed + 1] = p
                end
            end

            local pool = aimed
            local why = "aim"
            if #pool == 0 then
                local voids = {}
                for _, p in ipairs(candidates) do
                    if isVoidLike(p, victimPlr) then
                        voids[#voids + 1] = p
                    end
                end
                if #voids == 1 then
                    return voids[1], "unique-void-firer"
                end

                local closest, closestD = nil, math.huge
                for _, p in ipairs(candidates) do
                    local d = playerDist(p, victimPlr)
                    if d < closestD then
                        closest, closestD = p, d
                    end
                end
                if closest and closestD <= 100 then
                    return closest, "closest-firer"
                end

                local bestRecent, bestAt = nil, -1
                for _, p in ipairs(candidates) do
                    local at = fireRecency(p)
                    if at > bestAt then
                        bestRecent, bestAt = p, at
                    end
                end
                if bestRecent then
                    return bestRecent, "most-recent-firer"
                end

                return nil, "no-aim-on-us"
            end

            if #pool == 1 then
                return pool[1], isVoidLike(pool[1], victimPlr) and "void-aim" or "near-aim"
            end

            local bestRecent, bestAt = nil, -1
            for _, p in ipairs(pool) do
                local at = fireRecency(p)
                if at > bestAt then
                    bestRecent, bestAt = p, at
                end
            end
            if bestRecent then
                return bestRecent, "recent-aim"
            end

            local best, bestD = nil, -1
            for _, p in ipairs(pool) do
                local d = playerDist(p, victimPlr)
                if d > bestD then
                    best, bestD = p, d
                end
            end
            if best then
                return best, bestD >= VOID_DIST and "farthest-void-aim" or "closest-aim"
            end
            return best, why
        end

        local function findUniqueFireAimAttacker(myHead, victimPlr)
