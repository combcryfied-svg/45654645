    local wallbangState = {
        on = false,
        thread = nil,
        map = nil,
        parent = nil,
    }

    local function findMapInstance()
        local direct = Workspace:FindFirstChild("MAP") or Workspace:FindFirstChild("Map")
        if direct then
            return direct
        end
        local ignoredFolder = Workspace:FindFirstChild("Ignored")
        if ignoredFolder then
            return ignoredFolder:FindFirstChild("MAP") or ignoredFolder:FindFirstChild("Map")
        end
        return nil
    end

    local function wallbang()
        local ignoredFolder = Workspace:FindFirstChild("Ignored")
        if not ignoredFolder then
            ignoredFolder = Instance.new("Folder")
            ignoredFolder.Name = "Ignored"
            ignoredFolder.Parent = Workspace
        end
        local map = findMapInstance()
        if map and map.Parent ~= ignoredFolder then
            if not wallbangState.map then
                wallbangState.map = map
                wallbangState.parent = map.Parent
            end
            map.Parent = ignoredFolder
        end
    end

    local function restoreWallbang()
        local map = wallbangState.map
        if map and map.Parent then
            map.Parent = wallbangState.parent or Workspace
        else
            map = findMapInstance()
            if map and map.Parent ~= Workspace then
                map.Parent = Workspace
            end
        end
        wallbangState.map = nil
        wallbangState.parent = nil
    end

    local function stopWallbang()
        wallbangState.on = false
        if wallbangState.thread then
            pcall(task.cancel, wallbangState.thread)
            wallbangState.thread = nil
        end
        pcall(restoreWallbang)
    end

    local function startWallbang()
        if not rainDaHoodWallbangOn67() then
            stopWallbang()
            return
        end
        if wallbangState.on then
            pcall(wallbang)
            return
        end
        wallbangState.on = true
        pcall(wallbang)
        wallbangState.thread = task.spawn(function()
            while wallbangState.on do
                task.wait(0.35)
                if not wallbangState.on then
                    break
                end
                if rainDaHoodWallbangOn67() then
                    pcall(wallbang)
                else
                    stopWallbang()
                    break
                end
            end
            wallbangState.thread = nil
        end)
    end

