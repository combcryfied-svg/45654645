		local chunkLoader = loadstring or load

		local function runUiChunk(key, source, label)
			if type(chunkLoader) ~= "function" then
				return false, "no loadstring"
			end
			local cache = nil
			if typeof(getgenv) == "function" then
				local g = getgenv()
				g._RainUiChunks = type(g._RainUiChunks) == "table" and g._RainUiChunks or {}
				cache = g._RainUiChunks
			end
			local fn = cache and cache[key]
			local compileErr = nil
			if not fn then
				fn, compileErr = chunkLoader(source, label)
				if not fn then
					return false, compileErr
				end
				if cache then
					cache[key] = fn
				end
			end
			local ok, err = pcall(fn)
			task.wait()
			if not ok then
				return false, err
			end
			return true
		end

		local function loadRainUi()
			if type(chunkLoader) ~= "function" then
				return
			end

			if typeof(getgenv) == "function" then
				local env = getgenv()
				env.script_name = env.script_name or "rain"
				env.script_version = env.script_version or "live"
				if type(env._RAIN_MENU) == "function" then
					pcall(env._RAIN_MENU)
				end
			end

			local okLib, libErr = runUiChunk("library", RAIN_UI_LIBRARY, "=RainUiLibrary")
			if not okLib then
				return
			end

			local okMid, midErr = runUiChunk("mid", RAIN_UI_LIBRARY_MID, "=RainUiLibraryMid")
			if not okMid then
				return
			end

			local okTail, tailErr = runUiChunk("tail", RAIN_UI_LIBRARY_TAIL, "=RainUiLibraryTail")
			if not okTail then
				return
			end

			local okBuild, buildErr = runUiChunk("builder", RAIN_UI_BUILDER, "=RainUiBuilder")
			if not okBuild then
			end
		end

		local function deferRainUi()
			task.spawn(function()
				task.wait(5)
				loadRainUi()
			end)
		end

		if typeof(getgenv) == "function" then
			getgenv()._RAIN_UI_LOADER = deferRainUi
			getgenv()._RAIN_LOAD_UI = true
		else
			task.defer(deferRainUi)
		end
	end
