                tween(button["text"], hide_transparency, circular, out, 0.15)
                tween(button["icon"], hide_transparency, circular, out, 0.15)
            end
        end

        delay(0.15, function()
            if actives["context"] == nil then
                context_border["Visible"] = false
            end
        end)

        actives["context"] = nil
    end

