        function Modules.Engine()
            local function rayIgnoreExtra(base)
                local ignore = {}
                if type(base) == "table" then
                    for i = 1, #base do
                        ignore[#ignore + 1] = base[i]
                    end
                end
                local ign = Workspace:FindFirstChild("Ignored")
                if ign then
                    ignore[#ignore + 1] = ign
                end
                local bush = Workspace:FindFirstChild("Bush")
                if bush then
                    ignore[#ignore + 1] = bush
                end
                return ignore
            end

            local function RayCast(Part, Origin, Ignore, Distance)
                Ignore = rayIgnoreExtra(Ignore or {})
                if Part and Part.Parent then
                    for _, plr in ipairs(Players:GetPlayers()) do
                        local ch = plr.Character
                        if ch and ch ~= Part.Parent then
                            Ignore[#Ignore + 1] = ch
                        end
                    end
                end
                Distance = Distance or 2000
                local Cast = Ray.new(Origin, (Part.Position - Origin).Unit * Distance)
                local Hit = Workspace:FindPartOnRayWithIgnoreList(Cast, Ignore)
                return (Hit and Hit:IsDescendantOf(Part.Parent)) == true, Hit
            end

            return {
                RayCast = RayCast
            }
        end

