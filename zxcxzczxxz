        if not tsPlr or not tsPlr.Character then return end
        local torso = tsPlr.Character:FindFirstChild("UpperTorso") or tsPlr.Character:FindFirstChild("HumanoidRootPart")
        local myChar = lp.Character; local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not torso or not myRoot then return end
        local offX = tonumber(rGet("Target Strafe", "X", "Target Strafe X", 0)) or 0
        local offY = tonumber(rGet("Target Strafe", "Y", "Target Strafe Y", 5)) or 5
        local offZ = tonumber(rGet("Target Strafe", "Z", "Target Strafe Z", 0)) or 0
        local speed = tonumber(rGet("Target Strafe", "Speed", "Target Strafe Speed", 5)) or 5
        local radius = tonumber(rGet("Target Strafe", "Radius", "Target Strafe Radius", 10)) or 10
        local mode = TS.mode or rGet("Target Strafe", "Movement", "Target Strafe Mode", "Strafe")
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Freefall) end
        local basePos = (torso.CFrame * CFrame.new(offX, offY, offZ)).Position
        TS.time = TS.time + speed * 0.016
        local floatPos
        if mode == "Static" then floatPos = basePos
        elseif mode == "Strafe" then floatPos = Vector3.new(basePos.X + math.sin(TS.time) * radius, basePos.Y, basePos.Z + math.cos(TS.time) * radius)
        elseif mode == "Orbit" then floatPos = Vector3.new(basePos.X + math.cos(TS.time) * radius, basePos.Y + math.sin(TS.time) * (radius * 0.5), basePos.Z + math.sin(TS.time) * radius)
        elseif mode == "V-Shape" then floatPos = Vector3.new(basePos.X + math.sin(TS.time) * (radius * 0.5), basePos.Y + math.abs(math.sin(TS.time)) * (radius * 0.6) - (radius * 0.3), basePos.Z + math.sin(TS.time) * (radius * 0.5))
        else floatPos = basePos end
        tsAttach(myRoot)
        if TS.pos then TS.pos.Position = floatPos end
        if TS.ori then TS.ori.CFrame = CFrame.lookAt(floatPos, torso.Position) end
        myRoot.CFrame = CFrame.new(floatPos)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
    end

