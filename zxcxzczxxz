    then
        return Mango.Locals.HitPosition
    end
    local cam = workspace.CurrentCamera
    if not cam then
        return nil
    end
    if _G.MobileShiftLock then
        return cam.CFrame.p + cam.CFrame.LookVector * 60
    end
    if Mouse.Target then
        return Mouse.Hit.p
    end
    local v25 = cam.CFrame
    local v26 = v25.p + v25.LookVector * 60
    local v27 = v25.LookVector
    local v28 = cam:ScreenPointToRay(Mouse.X, Mouse.Y)
    local v29 = v28.Direction
    local v30 = v28.Origin
    return v30 + v29 * ((v26 - v30):Dot(v27) / v29:Dot(v27))
end

