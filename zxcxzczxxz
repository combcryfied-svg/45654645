		end
		local bs = cs["Body Size"]
		if type(bs) ~= "table" then
			bs = { Enabled = false, Mode = "Skinny" }
			cs["Body Size"] = bs
		end
		if bs.Enabled == nil then
			bs.Enabled = false
		end
		local mode = tostring(bs.Mode or "Skinny")
