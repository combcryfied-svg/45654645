-- >>> RAIN AUTO STIM
-- Auto stim controller for rain.lua

if not _SD_BusyFor then
    _SD_Busy = 0
    _SD_BusyDeadline = 0
    function _SD_BusyFor(seconds)
        seconds = seconds or 2
        local now = tick()
        if (_SD_Busy or 0) > 0 and _SD_BusyDeadline > now then
            return
        end
        _SD_Busy = (_SD_Busy or 0) + 1
        _SD_BusyDeadline = now + seconds
        task.delay(seconds, function()
            _SD_Busy = math.max(0, (_SD_Busy or 0) - 1)
            if _SD_Busy == 0 then
                _SD_BusyDeadline = 0
            end
        end)
    end
    function _SD_IsCombatBusy()
        return (_SD_Busy or 0) > 0
    end
end

local function rainBuildStimController(initialCfg)
        --[[
        	Stim Controller - Lightweight
        	Only TP-back buying and auto stim usage
        ]]

        local cfg = {
            lowHealthThreshold = 90,      -- Health % to auto use stim
            autoStim = true,              -- Enable auto stim management
            ghostTP = true,               -- Use TP-back for buying
            pairBuy = false,              -- Buy 2 stims at once
            stimBuyCooldown = 0.55,
            stimUseCooldown = 0.15,
            maintainDelay = 0.85,
            clickSpam = 6,
            desyncWait = 0.08,
            buyRetries = 2,
            buyMaxTime = 2.4,
            combatLock = 1.15,
        }

        -- Override config
        local oc = initialCfg
        if type(oc) == "table" then
            for k, v in pairs(oc) do
                cfg[k] = v
            end
        end

        local Plrs = game:GetService("Players")
        local VIM = game:GetService("VirtualInputManager")
        local RS = game:GetService("RunService")
        local pl = Plrs.LocalPlayer

        local stimEnabled = cfg.autoStim
        local _char, _hum, _root = nil, nil, nil
        local _buying, _using = false, false
        local _isRespawning = false
        local _lastBuy, _lastUse = 0, 0
        local _stimCount, _stimCountAt = -1, 0
        local _stimTool, _stimToolAt = nil, 0
        local _shop, _shopCD, _shopPart, _shopAt = nil, nil, nil, 0
        local _shopScanAt, _noShop = 0, false
        local _desyncOn = false
        local _desyncCF, _desyncRoot, _desyncPad = nil, nil, nil
        local _desyncHb = nil
        local _stimKW = { "stim", "steroid", "med", "heal", "inject", "adren" }
        local _failStreak = 0
        local _crouchHeld = false
        local _safeHome = nil
        local _buyLockUntil = 0
        local _abortBuy = false
        local _buyDeadline = 0
        local _lastDamageAt = 0
        local _lastHp = nil
        local _alive = true

        local function setEnabled(v)
            v = v == true
            if cfg.autoStim and not v and _buying then
                _abortBuy = true
            end
            cfg.autoStim = v
            stimEnabled = v
        end

        local function stockTarget()
            return cfg.pairBuy and 2 or 1
        end

        local function inCombat()
            return tick() - _lastDamageAt < (cfg.combatLock or 1.15)
        end

        local function buyTimedOut()
            return _buyDeadline > 0 and tick() >= _buyDeadline
        end

        local function refreshChar()
            local c = pl.Character
            if c and c.Parent then
                if c ~= _char then
                    _char = c
                    _hum = c:FindFirstChildOfClass("Humanoid")
                    _root = c:FindFirstChild("HumanoidRootPart")
                    _stimCount, _stimTool = -1, nil
                    _buying, _using = false, false
                elseif not _hum or not _hum.Parent then
                    _hum = c:FindFirstChildOfClass("Humanoid")
                end
                if not _root or not _root.Parent then
                    _root = c:FindFirstChild("HumanoidRootPart")
                end
                return _hum ~= nil
            end
            _char, _hum, _root = nil, nil, nil
            return false
        end

        local function isDead()
            if not _char or not _hum then return true end
            return _hum.Health <= 0 or _hum:GetState() == Enum.HumanoidStateType.Dead
        end

        local function shouldAbortBuy()
            return _abortBuy or _isRespawning or isDead() or buyTimedOut()
        end

        local function nameHasStim(nm)
            nm = string.lower(nm)
            for i = 1, #_stimKW do
                if string.find(nm, _stimKW[i], 1, true) then
                    return true
                end
            end
            return false
        end

        local function countStims()
            if _isRespawning or isDead() or not _char then
                return 0
            end
            local now = tick()
            if _stimCount >= 0 and now - _stimCountAt < 0.2 then
                return _stimCount
            end
            local n = 0
            local function scan(parent)
                if not parent then return end
                for _, ch in ipairs(parent:GetChildren()) do
                    if ch:IsA("Tool") and nameHasStim(ch.Name) then
                        n = n + 1
                    end
                end
            end
            scan(_char)
            scan(pl:FindFirstChild("Backpack"))
            _stimCount, _stimCountAt = n, now
            return n
        end

        local function findStimTool()
            if _isRespawning or isDead() or not _char then
                return nil
            end
            local now = tick()
            if _stimTool and _stimTool.Parent and now - _stimToolAt < 0.25 then
                return _stimTool
            end
            for _, ch in ipairs(_char:GetChildren()) do
                if ch:IsA("Tool") and nameHasStim(ch.Name) then
                    _stimTool, _stimToolAt = ch, now
                    return ch
                end
            end
            local bp = pl:FindFirstChild("Backpack")
            if bp then
                for _, ch in ipairs(bp:GetChildren()) do
                    if ch:IsA("Tool") and nameHasStim(ch.Name) then
                        _stimTool, _stimToolAt = ch, now
                        return ch
                    end
                end
            end
            _stimTool = nil
            return nil
        end

        local function findStimShop(force)
            local now = tick()
            if not force and _shop and _shop.Parent and _shopCD and _shopCD.Parent and now - _shopAt < 12 then
                return _shop, _shopCD, _shopPart
            end
            if not force and now - _shopScanAt < 1.5 and _shop then
                return _shop, _shopCD, _shopPart
            end
            _shopScanAt = now

            local function tryFolder(folder)
                if not folder then return nil end
                for _, v in ipairs(folder:GetChildren()) do
                    if nameHasStim(v.Name) then
                        local cd = v:FindFirstChildWhichIsA("ClickDetector", true)
                        local part = v:IsA("BasePart") and v
                            or v:FindFirstChild("Head")
                            or v:FindFirstChild("Pad")
                            or v:FindFirstChildWhichIsA("BasePart", true)
                        if cd and part then
                            return v, cd, part
                        end
                    end
                end
                return nil
            end

            local ignored = workspace:FindFirstChild("Ignored")
            local shopFolder = ignored and ignored:FindFirstChild("Shop")
            local s, cd, part = tryFolder(shopFolder)
            if not s then
                s, cd, part = tryFolder(workspace:FindFirstChild("Shop"))
            end
            -- Fallback: search workspace + ReplicatedStorage for stim shop models (same sources as old Auto Stim)
            if not s then
                for _, location in ipairs({ workspace, game:GetService("ReplicatedStorage") }) do
                    if s then break end
                    for _, v in ipairs(location:GetDescendants()) do
                        if nameHasStim(v.Name) then
                            local cd2 = v:FindFirstChildWhichIsA("ClickDetector", true)
                            local part2 = v:IsA("BasePart") and v
                                or v:FindFirstChild("Head")
                                or v:FindFirstChild("Pad")
                                or v:FindFirstChildWhichIsA("BasePart", true)
                            if cd2 and part2 then
                                s, cd, part = v, cd2, part2
                                break
                            end
                        end
                    end
                end
            end
            if s then
                _shop, _shopCD, _shopPart, _shopAt = s, cd, part, now
                _noShop = false
                return s, cd, part
            end
            if not _noShop then
                _noShop = true
            end
            return nil
        end

        local function distXZ(a, b)
            local d = a - b
            return math.sqrt(d.X * d.X + d.Z * d.Z)
        end

        local function captureHome(padPart)
            refreshChar()
            if not _root then return _safeHome end
            local cf = _root.CFrame
            if padPart and padPart.Parent then
                local near = distXZ(cf.Position, padPart.Position) < 18
                if near and typeof(_safeHome) == "CFrame" then
                    return _safeHome
                end
                if near then
                    return cf + Vector3.new(0, 0, 20)
                end
            end
            _safeHome = cf
            return cf
        end

        local function stopDesync()
            if not _desyncOn then
                pcall(function() RS:UnbindFromRenderStep("StimBuyDS") end)
                pcall(function() RS:UnbindFromRenderStep("StimBuyPad") end)
                if _desyncHb then
                    pcall(function() _desyncHb:Disconnect() end)
                    _desyncHb = nil
                end
                return
            end
            _desyncOn = false
            if _desyncHb then
                pcall(function() _desyncHb:Disconnect() end)
                _desyncHb = nil
            end
            pcall(function() RS:UnbindFromRenderStep("StimBuyDS") end)
            pcall(function() RS:UnbindFromRenderStep("StimBuyPad") end)
            local live = (_desyncRoot and _desyncRoot.Parent and _desyncRoot)
                or (_root and _root.Parent and _root)
            if live and typeof(_desyncCF) == "CFrame" then
                pcall(function()
                    live.CFrame = _desyncCF
                    live.AssemblyLinearVelocity = Vector3.zero
                    live.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            _desyncRoot, _desyncPad = nil, nil
        end

        local function startDesync(homeCF, padCF)
            stopDesync()
            if not _root then return false end
            _desyncCF = homeCF or _root.CFrame
            _desyncPad = padCF
            _desyncRoot = _root
            _desyncOn = true

            local function pushPad()
                if not _desyncOn then return end
                local r = _desyncRoot
                if r and r.Parent and typeof(_desyncPad) == "CFrame" then
                    r.CFrame = _desyncPad
                    local v = r.AssemblyLinearVelocity
                    if v.Magnitude < 0.2 then
                        r.AssemblyLinearVelocity = Vector3.new(0.25, 0.1, 0.25)
                    end
                end
            end

            local function pullHome()
                if not _desyncOn then return end
                local r = (_desyncRoot and _desyncRoot.Parent and _desyncRoot)
                    or (_root and _root.Parent and _root)
                if not r or typeof(_desyncCF) ~= "CFrame" then return end
                r.CFrame = _desyncCF
                local v = r.AssemblyLinearVelocity
                if v.Magnitude > 8 then
                    r.AssemblyLinearVelocity = v.Unit * 0.4
                elseif v.Magnitude < 0.05 then
                    r.AssemblyLinearVelocity = Vector3.new(0.12, 0.05, 0.12)
                end
                r.AssemblyAngularVelocity = Vector3.zero
            end

            _desyncHb = RS.Heartbeat:Connect(pushPad)
            pcall(function()
                RS:BindToRenderStep("StimBuyPad", Enum.RenderPriority.First.Value, pushPad)
            end)
            RS:BindToRenderStep("StimBuyDS", Enum.RenderPriority.Camera.Value + 1, pullHome)
            pushPad()
            return true
        end

        local function setPadTarget(padCF)
            if typeof(padCF) ~= "CFrame" then return end
            _desyncPad = padCF
            if _root and _root.Parent then
                _root.CFrame = padCF
            end
        end

        local function fireClick(cd)
            if not cd then return end
            pcall(function() cd.MaxActivationDistance = 9e9 end)
            pcall(fireclickdetector, cd, 0)
            pcall(fireclickdetector, cd)
        end

        local function clickBurst(cd, padCF, n)
            n = math.clamp(tonumber(n) or cfg.clickSpam or 6, 3, 10)
            for _ = 1, n do
                if shouldAbortBuy() then break end
                setPadTarget(padCF)
                fireClick(cd)
                task.wait(0.02)
            end
        end

        local function stayAtPad(padCF, seconds)
            local t0 = tick()
            seconds = seconds or 0.06
            while tick() - t0 < seconds do
                if shouldAbortBuy() then break end
                setPadTarget(padCF)
                task.wait()
            end
        end

        local function setCrouch(on)
            on = on == true
            if _crouchHeld == on then
                if on then
                    pcall(function()
                        VIM:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, nil)
                    end)
                end
                return
            end
            _crouchHeld = on
            pcall(function()
                VIM:SendKeyEvent(on, Enum.KeyCode.LeftControl, false, nil)
            end)
        end

        local function waitStimCount(minCount, timeout)
            local t0 = tick()
            timeout = timeout or 0.85
            while tick() - t0 < timeout do
                if shouldAbortBuy() then break end
                _stimCount = -1
                if countStims() >= minCount then break end
                task.wait(0.03)
            end
            _stimCount = -1
            return countStims()
        end

        local function restoreHome(homeCF, savedVel)
            stopDesync()
            setCrouch(false)
            refreshChar()
            local live = _root
            if live and live.Parent and typeof(homeCF) == "CFrame" then
                pcall(function()
                    live.CFrame = homeCF
                    if typeof(savedVel) == "Vector3" then
                        live.AssemblyLinearVelocity = savedVel
                    end
                end)
                for _ = 1, 4 do
                    task.wait()
                    if live.Parent then
                        live.CFrame = homeCF
                    end
                end
            end
        end

        local function useStim()
            if not stimEnabled or _using or _isRespawning or isDead() then
                return false
            end
            if _buying then
                _abortBuy = true
                return false
            end
            local now = tick()
            if now - _lastUse < cfg.stimUseCooldown then
                return false
            end
            refreshChar()
            local tool = findStimTool()
            if not tool then
                return false
            end
            _using, _lastUse = true, now
            pcall(function()
                if tool.Parent ~= _char and _hum then
                    _hum:EquipTool(tool)
                end
                if tool.Activate then
                    tool:Activate()
                end
            end)
            _stimCount = -1
            _stimTool = nil
            _using = false
            return true
        end

        local function buyStims(force)
            if _SD_IsCombatBusy() then
                return false
            end
            if (not stimEnabled and not force) or _buying or _isRespawning or isDead() then
                return false
            end
            local now = tick()
            if now < _buyLockUntil then
                return false
            end
            if _failStreak >= 4 and now - _lastBuy < 2 then
                return false
            end
            if now - _lastBuy < (cfg.stimBuyCooldown or 0.55) then
                return false
            end

            local before = countStims()
            local need = stockTarget()
            local pair = cfg.pairBuy
            if before >= need then
                _failStreak = 0
                return false
            end

            if not force and inCombat() and before > 0 then
                return false
            end

            refreshChar()
            local shop, cd, part = findStimShop(_failStreak >= 2)
            if not cd or not part or not _root then
                _noShop = false
                findStimShop(true)
                shop, cd, part = findStimShop(false)
                if not cd or not part or not _root then
                    _buyLockUntil = tick() + 1.5
                    return false
                end
            end

            _buying, _lastBuy = true, now
            _abortBuy = false
            _buyDeadline = now + (cfg.buyMaxTime or 2.4) * (pair and 1 or 0.65)
            local shopCF = part.CFrame * CFrame.new(0, 3, 0)
            refreshChar()
            if not _root or not _root.Parent then
                _buying = false
                _buyDeadline = 0
                return false
            end
            local home = nil
            local savedVel = nil
            local got = before
            local aborted = false
            local retries = math.clamp(cfg.buyRetries or 2, 1, 3)
            local voidWasActive = false

            local okBuy = pcall(function()
                if not _root or not _root.Parent or shouldAbortBuy() then
                    aborted = true
                    return
                end

                pcall(function() cd.MaxActivationDistance = 9e9 end)

                -- Pause rain void-hide while buying
                if typeof(getgenv) == "function" then
                    local g = getgenv()
                    if type(g._RainWoodieVoidPause67) == "function" then
                        voidWasActive = g._RainWoodieVoidPause67() == true
                    elseif type(Mango) == "table" and type(Mango._RainVoidHidePause67) == "function" then
                        voidWasActive = Mango._RainVoidHidePause67() == true
                    end
                end

                refreshChar()
                if not _root then
                    aborted = true
                    return
                end
                home = captureHome(part)
                savedVel = _root.AssemblyLinearVelocity

                if cfg.ghostTP then
                    startDesync(home, shopCF)
                    task.wait(cfg.desyncWait or 0.08)
                else
                    setPadTarget(shopCF)
                    stayAtPad(shopCF, 0.06)
                end

                if shouldAbortBuy() then
                    aborted = true
                    return
                end

                local function attemptBuy1()
                    if shouldAbortBuy() then return countStims() end
                    stayAtPad(shopCF, 0.05)
                    clickBurst(cd, shopCF, pair and 6 or 5)
                    return waitStimCount(before + 1, pair and 0.75 or 0.65)
                end

                if not pair or before < 1 then
                    for _ = 1, retries do
                        if shouldAbortBuy() then
                            aborted = true
                            break
                        end
                        got = attemptBuy1()
                        if got > before then break end
                        task.wait(0.05)
                    end
                    if got <= before and cfg.ghostTP and not shouldAbortBuy() and not inCombat() then
                        setPadTarget(shopCF)
                        stayAtPad(shopCF, 0.06)
                        got = attemptBuy1()
                        if cfg.ghostTP and not shouldAbortBuy() then
                            startDesync(home, shopCF)
                        end
                    end
                    if shouldAbortBuy() then
                        aborted = true
                        return
                    end
                    if got <= before then
                        return
                    end
                else
                    got = before
                end

                if not pair then
                    return
                end

                if shouldAbortBuy() then
                    aborted = true
                    return
                end

                _stimCount, _stimTool = -1, nil
                local held = nil
                for _ = 1, 5 do
                    if shouldAbortBuy() then
                        aborted = true
                        return
                    end
                    held = findStimTool()
                    if held then
                        pcall(function() _hum:EquipTool(held) end)
                        break
                    end
                    task.wait(0.05)
                end
                if not held then
                    return
                end

                local target2 = 2
                for _ = 1, retries do
                    if got >= target2 or shouldAbortBuy() then
                        if shouldAbortBuy() then
                            aborted = true
                        end
                        break
                    end
                    setPadTarget(shopCF)
                    if not findStimTool() then
                        held = findStimTool()
                        if not held then
                            return
                        end
                    end
                    setCrouch(true)
                    task.wait(0.12)
                    for _ = 1, 3 do
                        if shouldAbortBuy() then break end
                        pcall(function()
                            VIM:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, nil)
                        end)
                        setPadTarget(shopCF)
                        fireClick(cd)
                        task.wait(0.03)
                    end
                    clickBurst(cd, shopCF, 4)
                    got = waitStimCount(target2, 0.7)
                    if got >= target2 then
                        break
                    end
                    task.wait(0.05)
                end
                setCrouch(false)
            end)

            restoreHome(home, savedVel)
            _stimCount, _stimTool = -1, nil
            _abortBuy = false
            _buyDeadline = 0
            _buying = false

            if voidWasActive then
                if type(Mango) == "table" and type(Mango._RainVoidHideResume67) == "function" then
                    Mango._RainVoidHideResume67()
                elseif typeof(getgenv) == "function" and type(getgenv()._RainWoodieVoidResume67) == "function" then
                    getgenv()._RainWoodieVoidResume67()
                end
            end

            if aborted then
                _buyLockUntil = tick() + 0.45
                if countStims() > 0 and _hum and _hum.Health > 5 then
                    local pct = (_hum.MaxHealth > 0) and ((_hum.Health / _hum.MaxHealth) * 100) or 0
                    if pct <= cfg.lowHealthThreshold then
                        task.defer(useStim)
                    end
                end
                return countStims() > before
            end

            if countStims() > before then
                _failStreak = 0
                _buyLockUntil = tick() + 0.3
                return true
            end

            _failStreak = _failStreak + 1
            _buyLockUntil = tick() + math.min(0.7 + _failStreak * 0.3, 2.5)
            return okBuy and false
        end

        local function manageStims()
            if not stimEnabled or _isRespawning or isDead() or _buying or _using then
                return
            end
            refreshChar()
            if not _hum or _hum.MaxHealth <= 0 then
                return
            end
            local need = stockTarget()
            local cur = countStims()
            local pct = (_hum.Health / _hum.MaxHealth) * 100

            if pct <= cfg.lowHealthThreshold and _hum.Health > 5 and cur > 0 then
                useStim()
                return
            end

            if cur < need then
                if inCombat() and cur > 0 then
                    return
                end
                buyStims(false)
            end
        end

        -- Events
        local function bindHum(hum)
            if not hum then return end
            _lastHp = hum.Health
            hum.HealthChanged:Connect(function(hp)
                if not _hum or _hum ~= hum then return end
                if _lastHp and hp < _lastHp - 0.5 then
                    _lastDamageAt = tick()
                    if _buying then
                        _abortBuy = true
                    end
                end
                _lastHp = hp

                if not stimEnabled or _isRespawning then return end
                if hum.MaxHealth <= 0 or hp <= 5 then return end
                local pct = (hp / hum.MaxHealth) * 100
                if pct > cfg.lowHealthThreshold then return end

                if countStims() > 0 then
                    if _buying then
                        _abortBuy = true
                    elseif not _using then
                        useStim()
                    end
                    return
                end

                if not _buying and tick() - _lastBuy >= (cfg.stimBuyCooldown or 0.55) then
                    task.defer(buyStims, false)
                end
            end)
        end

        pl.CharacterAdded:Connect(function(char)
            _isRespawning = true
            _abortBuy = true
            setCrouch(false)
            stopDesync()
            _char, _hum, _root = char, nil, nil
            _stimCount, _stimTool = -1, nil
            _buying, _using = false, false
            _lastHp = nil
            task.spawn(function()
                local hum = char:WaitForChild("Humanoid", 8)
                local root = char:WaitForChild("HumanoidRootPart", 8)
                _hum, _root, _char = hum, root, char
                _abortBuy = false
                bindHum(hum)
                task.wait(0.35)
                _isRespawning = false
                findStimShop(true)
                if stimEnabled then
                    task.delay(0.45, function()
                        if stimEnabled and not isDead() and not inCombat() and countStims() < stockTarget() then
                            buyStims(false)
                        end
                    end)
                end
            end)
        end)

        if pl.Character then
            refreshChar()
            bindHum(_hum)
        end

        -- Main loop
        task.spawn(function()
            local lastMaintain = 0
            while _alive do
                pcall(function()
                    local now = tick()
                    refreshChar()
                    if stimEnabled and not _isRespawning and not isDead() and not _buying
                        and now >= _buyLockUntil and not _SD_IsCombatBusy() then
                        if now - lastMaintain >= (cfg.maintainDelay or 0.85) then
                            lastMaintain = now
                            if _root and (not _shopPart or distXZ(_root.Position, _shopPart.Position) > 14) then
                                _safeHome = _root.CFrame
                            end
                            manageStims()
                        end
                    elseif not _buying and _desyncOn then
                        stopDesync()
                        setCrouch(false)
                    end
                end)
                task.wait(0.08)
            end
        end)

        findStimShop(true)

        return {
            cfg = cfg,
            setEnabled = setEnabled,
            setThreshold = function(v) cfg.lowHealthThreshold = v end,
            busy = function() return _buying or _using or _isRespawning end,
            shutdown = function()
                _alive = false
                _abortBuy = true
                stimEnabled = false
                stopDesync()
                setCrouch(false)
            end,
        }
end

function rainAutoStimCfg67()
    local rage = shared.rain and shared.rain.Rage
    if type(rage) ~= "table" then
        return nil
    end
    return rage["Auto Stim"]
end

function rainAutoStimSync67(sc)
    if not sc then
        return
    end
    local stim = rainAutoStimCfg67()
    if type(stim) ~= "table" then
        sc.setEnabled(false)
