    function section:recalculate_size()
        local elements = self["elements"]
        local total_size = 10

        for i = 1, #elements do
            local element = elements[i]
            if element["visible"] then
                element["frame"]["Position"] = udim2_new(0, 10, 0, total_size)
                total_size+=element["total_y_size"]
            end
        end

        if not self["side"] then
            self["border"]["Size"] = udim2_new(0, 170, 0, total_size + 7)
            self["inside"]["Size"] = udim2_new(1, -2, 1, -2)
        end

        self["total_y_size"] = total_size

        if self["side"] and self["update_position"] then
            self:update_position()
        end
    end

    -- Rain: smooth pixel scroll inside section boxes.
    local rain_smooth_scroll_sections = {}
    local rain_smooth_scroll_tick = nil

    local function rain_bump_section_scroll(section, delta)
        if not section or not section.update_position then
            return
        end

        section:update_position()

        local max_offset = section["_rain_max_scroll_offset"] or 0
        local current = section["_rain_scroll_target"]
        if current == nil then
            current = section["_rain_scroll_offset"] or 0
        end

        local target = clamp(current + delta, 0, max_offset)
        if target == current and target == (section["_rain_scroll_offset"] or 0) then
            return
        end

        section["_rain_scroll_target"] = target
        rain_smooth_scroll_sections[section] = true

        if not rain_smooth_scroll_tick then
            rain_smooth_scroll_tick = LPH_NO_VIRTUALIZE(function(dt)
                local step = math.min(1, (type(dt) == "number" and dt or 0.016) * 18)

                for section, _ in pairs(rain_smooth_scroll_sections) do
                    if section["border"] then
                        local current_offset = section["_rain_scroll_offset"] or 0
                        local target_offset = section["_rain_scroll_target"] or current_offset
                        local diff = target_offset - current_offset

                        if math.abs(diff) < 0.35 then
                            section["_rain_scroll_offset"] = target_offset
                            section:update_position()
                            rain_smooth_scroll_sections[section] = nil
                        else
                            section["_rain_scroll_offset"] = current_offset + diff * step
                            section:update_position()
                        end
                    else
                        rain_smooth_scroll_sections[section] = nil
                    end
                end
            end)

            heartbeat[#heartbeat + 1] = rain_smooth_scroll_tick
        end
    end

    function section:update_position()
        if not self["side"] then
            return
        end
        if self["_rain_hidden"] then
            return
        end

        local elements = self["elements"]
        local visible = {}

        for i = 1, #elements do
            local element = elements[i]
            if element["visible"] then
                visible[#visible + 1] = element
            end
        end

        local count = #visible

        -- Prefer the live box height; drawing sizes settle a frame or two after assignment.
        local border = self["border"]
        local real_size = border and border["real_size"]
        local measured = real_size and real_size["Y"]
        local available = self["_rain_avail"]
        if type(available) ~= "number" or available <= 0 then
            available = (type(measured) == "number" and measured > 30 and measured - 18) or 100000
        end

        local total_height = 0
        for i = 1, count do
            total_height = total_height + (visible[i]["total_y_size"] or 17)
        end

        local max_offset = math.max(0, total_height - available)
        self["_rain_max_scroll_offset"] = max_offset

        local scroll_offset = self["_rain_scroll_offset"] or 0
        scroll_offset = clamp(scroll_offset, 0, max_offset)
        self["_rain_scroll_offset"] = scroll_offset

        if self["_rain_scroll_target"] ~= nil then
            self["_rain_scroll_target"] = clamp(self["_rain_scroll_target"], 0, max_offset)
        end

        local view_top = 10
        local view_bottom = view_top + available
        local y = view_top - scroll_offset
        local shown = 0
        local scroll_index = 1
        local walked = 0

        for i = 1, count do
            local element = visible[i]
            local height = element["total_y_size"] or 17

            if walked + 0.001 < scroll_offset then
                scroll_index = i + 1
            end
            walked = walked + height

            local elem_top = y
            local elem_bottom = y + height

            if elem_top >= view_top and elem_bottom <= view_bottom then
                element["frame"]["Visible"] = true
                element["frame"]["Position"] = udim2_new(0, 10, 0, elem_top)
                shown = shown + 1
            else
                element["frame"]["Visible"] = false
            end

            y = y + height
        end

        self["scroll_index"] = clamp(scroll_index, 1, math.max(1, count))
        self["_rain_max_scroll"] = math.max(1, count - shown + 1)
    end

    function section:destroy()
        if not self["border"] then 
            return 
        end
        for _, element in self["elements"] do
            element:remove()
        end
        for _, drawing in self do
            local type = typeof(drawing)
            if (type == "Drawing" or type == "Table") and rawget(drawing, "Destroy") then
                drawing["Destroy"](drawing)
                self[_] = nil
            end
        end
    end

